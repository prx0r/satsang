{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tantrafiles.xyz/schema/daily-snapshot.json",
  "title": "Daily practice snapshot",
  "description": "Computed packet per user per day: everything agents render from. Deterministic from events; fields never removed. Merge target: specs/schema/daily-snapshot.json. Pattern: ochemapp DailySnapshot.",
  "type": "object",
  "properties": {
    "type": { "type": "string", "const": "daily-snapshot" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "who": { "type": "string", "description": "u:<id> or d:<device>" },
    "taste_chips": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Top traditions/topics as words, never numbers."
    },
    "exploring": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Highest-uncertainty facets ('Still exploring')."
    },
    "due": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "kind"],
        "properties": {
          "ref": { "type": "string", "description": "practice/routine/journey gid" },
          "kind": { "type": "string", "enum": ["practice", "routine", "journey", "retreat"] },
          "why": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["collection", "unit"],
        "properties": {
          "collection": { "type": "string" },
          "unit": { "type": "integer" },
          "title": { "type": "string" }
        }
      }
    },
    "streak": {
      "type": "object",
      "properties": {
        "week_dots": { "type": "integer" },
        "month_sits": { "type": "integer" },
        "total_hours": { "type": "number" }
      },
      "description": "Plain counts, no pressure copy (spec §3)."
    },
    "suggested_next": {
      "type": "object",
      "properties": {
        "talk": { "type": "string" },
        "practice": { "type": "string" },
        "topic": { "type": "string" },
        "reason": { "type": "string", "maxLength": 200 }
      }
    }
  },
  "required": ["type", "date", "who"]
}
