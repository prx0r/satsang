/tantrafiles.xyz/tradition/nyingma"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/shenpen-hookham","url":"https://tantrafiles.xyz/person/shenpen-hookham","name":"Lama Shenpen Hookham","description":"British Kagyu and Nyingma teacher, Oxford DPhil on shentong buddha-nature, founder of the Awakened Heart Sangha.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/kagyu"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/phap-hai","url":"https://tantrafiles.xyz/person/phap-hai","name":"Brother Phap Hai","description":"Plum Village monastic (Brother Pháp Hải), Dharma teacher in Thich Nhat Hanh's tradition.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/plum-village"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/kokyo-henkel","url":"https://tantrafiles.xyz/person/kokyo-henkel","name":"Kokyo Henkel","description":"Soto Zen priest from the San Francisco Zen Center lineage, guiding teacher of Santa Cruz Zen Center, with a strong interest in buddha-nature texts.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/soto-zen"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/jetsunma-tenzin-palmo","url":"https://tantrafiles.xyz/person/jetsunma-tenzin-palmo","name":"Jetsunma Tenzin Palmo","description":"British-born Drukpa Kagyu nun who spent twelve years in a Himalayan cave and founded Dongyu Gatsal Ling nunnery.","birthDate":"1943","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/kagyu"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/tulku-thondup","url":"https://tantrafiles.xyz/person/tulku-thondup","name":"Tulku Thondup Rinpoche","description":"Nyingma scholar trained at Dodrupchen monastery, former visiting scholar at Harvard, author of books on healing, the Longchen Nyingthig and the hidden treasure (terma) tradition.","birthDate":"1939","deathDate":"2023","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/nyingma"}],"hasOccupation":{"@type":"Occupation","name":"Scholar"}},{"@type":"Perso