","url":"https://plato.stanford.edu/entries/japanese-zen/","name":"Stanford Encyclopedia of Philosophy: Japanese Zen Buddhist Philosophy","publisher":"plato.stanford.edu","isAccessibleForFree":true}]},{"@type":"CreativeWork","@id":"https://tantrafiles.xyz/resource/the-cloud-of-unknowing","url":"https://tantrafiles.xyz/resource/the-cloud-of-unknowing","name":"The Cloud of Unknowing","author":{"@type":"Person","name":"Anonymous (14th c.)"},"genre":"essay","workExample":[{"@type":"CreativeWork","url":"https://en.wikisource.org/wiki/The_Cloud_of_Unknowing","name":"The Cloud of Unknowing","publisher":"en.wikisource.org","isAccessibleForFree":true}]},{"@type":"CreativeWork","@id":"https://tantrafiles.xyz/resource/the-practice-of-the-presence-of-god","url":"https://tantrafiles.xyz/resource/the-practice-of-the-presence-of-god","name":"The Practice of the Presence of God","author":{"@type":"Person","name":"Brother Lawrence"},"genre":"essay","workExample":[{"@type":"CreativeWork","url":"https://www.gutenberg.org/ebooks/5657","name":"The Practice of the Presence of God","publisher":"gutenberg.org","isAccessibleForFree":true}]},{"@type":"CreativeWork","@id":"https://tantrafiles.xyz/resource/practical-mysticism","url":"https://tantrafiles.xyz/resource/practical-mysticism","name":"Practical Mysticism","author":{"@type":"Person","name":"Evelyn Underhill (1914)"},"genre":"essay","workExample":[{"@type":"CreativeWork","url":"https://www.gutenberg.org/ebooks/21774","name":"Practical Mysticism","publisher":"gutenberg.org","isAccessibleForFree":true}]},{"@type":"CreativeWork","@id":"https://tantrafiles.xyz/resource/mn-4-fear-terror","url":"https://tantrafiles.xyz/resource/mn-4-fear-terror","name":"MN 4 · Fear & Terror","author":{"@type":"Person","name":"The Buddha (tr. Thanissaro)"},"genre":"essay","workExample":[{"@type":"CreativeWork","url":"https://www.dhammatalks.org/suttas/MN/MN4.html","name":"MN 4 · Fear & Terror","publisher":"dhammatalks.org","isAccessibleForFree":true}]},{"@type":"CreativeWork","@id":"https://tantrafiles.xyz/resource/ajahn-maha-boowa-talks-and-books-ati-index","url":"https://tantrafiles.xyz/resource/ajahn-maha-boowa-talks-and-books-ati-index","name":"Ajahn Maha Boowa talks and books (ATI index)","author":[{"@id":"https://tantrafiles.xyz/person/ajahn-maha-boowa"}],"genre":"essay","workExample":[{"@type":"CreativeWork","url":"https://www.accesstoinsight.org/lib/thai/boowa/index.html","name":"Ajahn Maha Boowa talks and books (ATI index)","publisher":"accesstoinsight.org","isAccessibleForFree":true}]},{"@type":"CreativeWork","@id":"https://tantrafiles.xyz/resource/the-autobiography-and-dhamma-teachings-of-ajahn-dtun","url":"https://tantrafiles.xyz/resource/the-autobiography-and-dhamma-teachings-of-ajahn-dtun","name":"The Autobiography and Dhamma Teachings of Ajahn Dtun","author":[{"@id":"https://tantrafiles.xyz/person/ajahn-dtun"}],"genre":"essay","workExample":[{"@type":"CreativeWork","url":"https://www.abhayagiri.org/books/637-the-autobiography-and-dhamma-teachings-of-ajahn-dtun","name":"The Autobiography and Dhamma Teachings of Ajahn Dtun","publisher":"abhayagiri.org","isAccessibleForFree":true}]},{"@type":"CreativeWork","@id":"https://tantrafiles.xyz/resource/the-song-celestial-bhagavad-gita","url":"https://tantrafiles.xyz/resource/the-song-celestial-bhagavad-gita","name":"The Song Celestial (Bhagavad Gītā)","author":{"@type":"Person","name":"tr. Edwin Arnold"},"genre":"essay","workExample":[{"@type":"CreativeWork","url":"https://www.gutenberg.org/ebooks/2388","name":"The Song Celestial (Bhagavad Gītā)","publisher":"gutenberg.org","isAccessibleForFree":true}]},{"@type":"CreativeWork","@id":"https://tantrafiles.xyz/resource/the-imitation-of-christ","url":"https://tantrafiles.xyz/resource/the-imitation-of-christ","name":"The Imitation of Christ","author":{"@type":"Person","name":"Thomas à Kempis"},"genre":"essay","workExample":[{"@type":"CreativeWork","url":"https://www.gutenberg.org/ebooks/1653","name":"The Imitation of Christ","publisher":"gutenberg.org","isAccessibleForFree":true}]},{"@type":"CreativeWork","@id":"https://tantrafiles.xyz/resource/siva-sutras-english-translation-by-subhash-kak","url":"https://tantrafiles.xyz/resource/siva-sutras-english-translation-by-subhash-kak","name":"Śiva Sūtras, English translation by Subhash Kak","genre":"essay","workExample":[{"@type":"CreativeWork","url":"https://sanskritdocuments.org/doc_shiva/shivasuutra.html","name":"Śiva Sūtras, English translation by Subhash Kak","publisher":"sanskritdocuments.org","isAccessibleForFree":true}]},{"@type":"CreativeWork","@id":"https://tantrafiles.xyz/resource/philosophical-and-mathematical-commentaries-of-proclus-on-eu","url":"https://tantrafiles.xyz/resource/philosophical-and-mathematical-commentaries-of-proclus-on-eu","name":"Philosophical and Mathematical Commentaries of Proclus on Euclid","author":[{"@id":"https://tantrafiles.xyz/person/proclus"}],"genre":"essay","workExample":[{"@type":"CreativeWork","url":"https://www.gutenberg.org/ebooks/74253","name":"Philosophical and Mathematical Commentaries of Proclus on Euclid","publisher":"gutenberg.org","isAccessibleForFree":true}]},{"@type":"CreativeWork","@id":"https://tantrafiles.xyz/resource/james-mallinson-the-khecarividya-of-adinatha-oxford-dphil","url":"https://tantrafiles.xyz/resource/james-mallinson-the-khecarividya-of-adinatha-oxford-dphil","name":"James Mallinson, The Khecarīvidyā of Ādinātha (Oxford DPhil)","genre":"essay","workExample":[{"@type":"CreativeWork","url":"https://ora.ox.ac.uk/objects/uuid:945071bf-3282-4492-8f18-159417f5d554","name":"James Mallinson, The Khecarīvidyā of Ādinātha (Oxford DPhil)","publisher":"ora.ox.ac.uk","isAccessibleForFree":true}]},{"@type":"CreativeWork","@id":"https://tantrafiles.xyz/resource/the-divine-pymander-corpus-hermeticum","url":"https://tantrafiles.xyz/resource/the-divine-pymander-corpus-hermeticum","name":"The Divine Pymander (Corpus Hermeticum)","author":{"@type":"Person","name":"Hermes Trismegistus (attrib.)"},"genre":"essay","workExample":[{"@type":"CreativeWork","url":"https://en.wikisource.org/wiki/The_Divine_Pymander","name":"The Divine Pymander (Corpus Hermeticum)","publisher":"en.wikisource.org","isAccessibleForFree":true}]},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/the-five-remembrances","url":"https://tantrafiles.xyz/practice/the-five-remembrances","name":"The five remembrances","description":"Each day, recollect slowly: I am subject to ageing; to illness; to death; I will be parted from all that is dear; I am the owner of my actions, and will inherit them. Let each one sink in before the next.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"Each day, recollect slowly: I am subject to ageing; to illness; to death; I will be parted from all that is dear; I am the owner of my actions, and will inherit them."},{"@type":"HowToStep","position":2,"text":"Let each one sink in before the next."}],"isBasedOn":["https://www.dhammatalks.org/suttas/AN/AN5_57.html"],"about":[{"@id":"https://tantrafiles.xyz/tradition/theravada"}],"warning":"Reflections on death can stir grief. Go gently, and set the practice aside if it overwhelms you.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/mindfulness-of-death-maranasati","url":"https://tantrafiles.xyz/practice/mindfulness-of-death-maranasati","name":"Mindfulness of death (maranasati)","description":"At nightfall and daybreak, reflect that death could come tonight or today from many causes, and ask whether any unskilful quality is still unabandoned. Let the urgency feed effort, not fear.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"At nightfall and daybreak, reflect that death could come tonight or today from many causes, and ask whether any unskilful quality is still unabandoned."},{"@type":"HowToStep","position":2,"text":"Let the urgency feed effort, not fear."}],"isBasedOn":["https://www.dhammatalks.org/suttas/AN/AN6_20.html"],"about":[{"@id":"https://tantrafiles.xyz/tradition/theravada"}],"warning":"Reflections on death can stir grief. Go gently, and set the practice aside if it overwhelms you.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/recollecting-the-round","url":"https://tantrafiles.xyz/practice/recollecting-the-round","name":"Recollecting the round","description":"Contemplate how long the round of birth and death has been, and how many losses it holds, until disenchantment with becoming arises. Then turn to the breath and rest.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Contemplate how long the round of birth and death has been, and how many losses it holds, until disenchantment with becoming arises."},{"@type":"HowToStep","position":2,"text":"Then turn to the breath and rest."}],"isBasedOn":["https://suttacentral.net/sn15.3/en/sujato"],"about":[{"@id":"https://tantrafiles.xyz/tradition/early-suttas"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell. Reflections on death can stir grief. Go gently, and set the practice aside if it overwhelms you.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/powa-an-introduction-to-transference-at-death","url":"https://tantrafiles.xyz/practice/powa-an-introduction-to-transference-at-death","name":"Powa: an introduction to transference at death","description":"Read a traditional introduction before seeking instruction from a qualified teacher: refuge, visualising Amitabha above the crown, and training the mind's direction at death. It is taught with empowerment, not from a page.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"Read a traditional introduction before seeking instruction from a qualified teacher: refuge, visualising Amitabha above the crown, and training the mind's direction at death. It is taught with empowerment, not from a page."}],"isBasedOn":["https://www.lamayeshe.com/article/powa-transference-consciousness-time-death"],"about":[{"@id":"https://tantrafiles.xyz/tradition/tibetan"}],"warning":"Orientation only: this practice is traditionally learned from a qualified teacher in its lineage. Read and listen; do not attempt it from a summary. Reflections on death can stir grief. Go gently, and set the practice aside if it overwhelms you.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/preparing-for-the-bardo","url":"https://tantrafiles.xyz/practice/preparing-for-the-bardo","name":"Preparing for the bardo","description":"Notice the small gaps of daily life (falling asleep, the pause between thoughts) as rehearsals for the great transition, and rest there as awareness.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Notice the small gaps of daily life (falling asleep, the pause between thoughts) as rehearsals for the great transition, and rest there as awareness."}],"isBasedOn":["https://www.lionsroar.com/the-fine-art-of-conscious-dying/"],"about":[{"@id":"https://tantrafiles.xyz/tradition/tibetan"}],"warning":"Reflections on death can stir grief. Go gently, and set the practice aside if it overwhelms you.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/self-enquiry-who-dies","url":"https://tantrafiles.xyz/practice/self-enquiry-who-dies","name":"Self-enquiry: who dies?","description":"When the thought of death comes, ask to whom it comes. Trace the 'I' back to its source instead of following the thought. Ramana's own awakening began by lying down and enacting his death.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"When the thought of death comes, ask to whom it comes."},{"@type":"HowToStep","position":2,"text":"Trace the 'I' back to its source instead of following the thought."},{"@type":"HowToStep","position":3,"text":"Ramana's own awakening began by lying down and enacting his death."}],"isBasedOn":["https://www.gururamana.org/Resources/Books/Who_Am_I_English.pdf"],"about":[{"@id":"https://tantrafiles.xyz/tradition/advaita"}],"warning":"Reflections on death can stir grief. Go gently, and set the practice aside if it overwhelms you.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/practising-dying-melete-thanatou","url":"https://tantrafiles.xyz/practice/practising-dying-melete-thanatou","name":"Practising dying (melete thanatou)","description":"Socrates calls philosophy the practice of dying: loosening the soul's grip on the body's pleasures and fears, day by day. Read the Phaedo slowly as an exercise, not an argument.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"Socrates calls philosophy the practice of dying: loosening the soul's grip on the body's pleasures and fears, day by day."},{"@type":"HowToStep","position":2,"text":"Read the Phaedo slowly as an exercise, not an argument."}],"isBasedOn":["https://www.gutenberg.org/ebooks/1658"],"about":[{"@id":"https://tantrafiles.xyz/tradition/platonic"}],"warning":"Reflections on death can stir grief. Go gently, and set the practice aside if it overwhelms you.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/powa-an-introduction","url":"https://tantrafiles.xyz/practice/powa-an-introduction","name":"Powa: an introduction","description":"A traditional introduction to transference at death; practised with a qualified teacher.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"A traditional introduction to transference at death; practised with a qualified teacher."}],"isBasedOn":["https://www.lamayeshe.com/article/powa-transference-consciousness-time-death"],"about":[{"@id":"https://tantrafiles.xyz/tradition/tibetan"}],"warning":"Orientation only: this practice is traditionally learned from a qualified teacher in its lineage. Read and listen; do not attempt it from a summary. Reflections on death can stir grief. Go gently, and set the practice aside if it overwhelms you.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/analytic-meditation-on-the-stages-of-the-path","url":"https://tantrafiles.xyz/practice/analytic-meditation-on-the-stages-of-the-path","name":"Analytic meditation on the stages of the path","description":"Pick one Lamrim topic, such as the preciousness of this human life or the certainty of death. Think it through step by step, using reasons and examples, until a felt conviction comes. Then rest single-pointedly on that conviction for a while. Alternate thinking and resting.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Pick one Lamrim topic, such as the preciousness of this human life or the certainty of death."},{"@type":"HowToStep","position":2,"text":"Think it through step by step, using reasons and examples, until a felt conviction comes."},{"@type":"HowToStep","position":3,"text":"Then rest single-pointedly on that conviction for a while."},{"@type":"HowToStep","position":4,"text":"Alternate thinking and resting."}],"isBasedOn":["https://studybuddhism.com"],"about":[{"@id":"https://tantrafiles.xyz/tradition/gelug"}],"warning":"Reflections on death can stir grief. Go gently, and set the practice aside if it overwhelms you.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/self-enquiry","url":"https://tantrafiles.xyz/practice/self-enquiry","name":"Self-enquiry","description":"Whenever a thought arises, ask to whom it arises; the answer is 'to me'; then ask 'who am I?' and hold attention on the sense of I.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"Whenever a thought arises, ask to whom it arises; the answer is 'to me'; then ask 'who am I?' and hold attention on the sense of I."}],"isBasedOn":["https://www.gururamana.org/Resources/Books/Who_Am_I_English.pdf"],"about":[{"@id":"https://tantrafiles.xyz/tradition/advaita"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/contemplating-not-self","url":"https://tantrafiles.xyz/practice/contemplating-not-self","name":"Contemplating not-self","description":"Take each aggregate in turn and ask: is it constant, is it easeful, is it fitting to regard it as me, mine, my self?","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"Take each aggregate in turn and ask: is it constant, is it easeful, is it fitting to regard it as me, mine, my self?"}],"isBasedOn":["https://www.dhammatalks.org/suttas/SN/SN22_59.html"],"about":[{"@id":"https://tantrafiles.xyz/tradition/theravada"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/shiva-process-self-inquiry","url":"https://tantrafiles.xyz/practice/shiva-process-self-inquiry","name":"Shiva Process self-inquiry","description":"Bring to mind a situation that is troubling you. Describe what you feel in plain words, then ask \"what is the deeper feeling under this?\" and keep going, layer by layer, until something shifts and the contraction releases. Often done in pairs or with a guide.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Bring to mind a situation that is troubling you."},{"@type":"HowToStep","position":2,"text":"Describe what you feel in plain words, then ask \"what is the deeper feeling under this?\" and keep going, layer by layer, until something shifts and the contraction releases."},{"@type":"HowToStep","position":3,"text":"Often done in pairs or with a guide."}],"isBasedOn":["https://www.youtube.com/watch?v=_13-8AHhxkk"],"about":[{"@id":"https://tantrafiles.xyz/tradition/kashmir-shaivism"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/what-am-i-don-t-know","url":"https://tantrafiles.xyz/practice/what-am-i-don-t-know","name":"\"What am I? Don't know\"","description":"Ask \"What am I?\" deeply on the in-breath. On the out-breath, hold \"Don't know...\" as long as the breath lasts. Return to this don't-know mind in every activity, and keep clear about the next correct action. This is Seung Sahn's Kwan Um teaching.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Ask \"What am I?\" deeply on the in-breath."},{"@type":"HowToStep","position":2,"text":"On the out-breath, hold \"Don't know...\" as long as the breath lasts."},{"@type":"HowToStep","position":3,"text":"Return to this don't-know mind in every activity, and keep clear about the next correct action."},{"@type":"HowToStep","position":4,"text":"This is Seung Sahn's Kwan Um teaching."}],"isBasedOn":["https://www.kwanumzen.org"],"about":[{"@id":"https://tantrafiles.xyz/tradition/seon"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/owner-of-my-actions","url":"https://tantrafiles.xyz/practice/owner-of-my-actions","name":"Owner of my actions","description":"The fifth remembrance: I am the owner of my actions, heir to my actions. Recollect it before acting and after.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"The fifth remembrance: I am the owner of my actions, heir to my actions."},{"@type":"HowToStep","position":2,"text":"Recollect it before acting and after."}],"isBasedOn":["https://www.dhammatalks.org/suttas/AN/AN5_57.html"],"about":[{"@id":"https://tantrafiles.xyz/tradition/theravada"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/mindfulness-of-breathing","url":"https://tantrafiles.xyz/practice/mindfulness-of-breathing","name":"Mindfulness of breathing","description":"Sit comfortably, know the in-breath and out-breath, then let the breath calm the whole body before turning to feelings and mind.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Sit comfortably, know the in-breath and out-breath, then let the breath calm the whole body before turning to feelings and mind."}],"isBasedOn":["https://www.dhammatalks.org/suttas/MN/MN118.html"],"about":[{"@id":"https://tantrafiles.xyz/tradition/theravada"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/goodwill-metta","url":"https://tantrafiles.xyz/practice/goodwill-metta","name":"Goodwill (metta)","description":"Wish yourself well, then widen the wish to others, near and far, seen and unseen, without exception.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"Wish yourself well, then widen the wish to others, near and far, seen and unseen, without exception."}],"isBasedOn":["https://www.dhammatalks.org/suttas/KN/StNp/StNp1_8.html"],"about":[{"@id":"https://tantrafiles.xyz/tradition/theravada"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/resting-in-the-gap-between-breaths-vijnana-bhairava-dharana","url":"https://tantrafiles.xyz/practice/resting-in-the-gap-between-breaths-vijnana-bhairava-dharana","name":"Resting in the gap between breaths (Vijñāna Bhairava dhāraṇā)","description":"Sit comfortably and breathe naturally. Notice the instant where the in-breath turns into the out-breath, and the instant where the out-breath turns back. Do not hold the breath; simply let attention fall into each turning point and rest there for its brief duration. Over time, notice the open awareness that is present in the pause.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Sit comfortably and breathe naturally."},{"@type":"HowToStep","position":2,"text":"Notice the instant where the in-breath turns into the out-breath, and the instant where the out-breath turns back."},{"@type":"HowToStep","position":3,"text":"Do not hold the breath; simply let attention fall into each turning point and rest there for its brief duration."},{"@type":"HowToStep","position":4,"text":"Over time, notice the open awareness that is present in the pause."}],"isBasedOn":["https://www.youtube.com/watch?v=gLibOLm67oQ"],"about":[{"@id":"https://tantrafiles.xyz/tradition/kashmir-shaivism"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/recognition-pratyabhijna-contemplation","url":"https://tantrafiles.xyz/practice/recognition-pratyabhijna-contemplation","name":"Recognition (pratyabhijñā) contemplation","description":"Read one sūtra of the Pratyabhijñāhṛdayam slowly. Then look at present experience — a sound, a thought, a feeling — and ask whether anything appears outside awareness. Let the understanding \"this too is a form of the one consciousness\" settle as a felt recognition rather than an idea. Return to the text, then to experience, alternating.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Read one sūtra of the Pratyabhijñāhṛdayam slowly."},{"@type":"HowToStep","position":2,"text":"Then look at present experience — a sound, a thought, a feeling — and ask whether anything appears outside awareness."},{"@type":"HowToStep","position":3,"text":"Let the understanding \"this too is a form of the one consciousness\" settle as a felt recognition rather than an idea."},{"@type":"HowToStep","position":4,"text":"Return to the text, then to experience, alternating."}],"isBasedOn":["https://www.youtube.com/watch?v=WGFfoBLIFNM"],"about":[{"@id":"https://tantrafiles.xyz/tradition/pratyabhijna"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/drawing-the-sri-chakra-as-meditation","url":"https://tantrafiles.xyz/practice/drawing-the-sri-chakra-as-meditation","name":"Drawing the Śrī Chakra as meditation","description":"Following a teacher's step-by-step construction, draw the Śrī Yantra slowly from the centre point (bindu) outward: the nine interlocking triangles, the lotus rings and the square gateways. Treat each stage as a contemplation of the goddess unfolding into the world, not as geometry homework.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Following a teacher's step-by-step construction, draw the Śrī Yantra slowly from the centre point (bindu) outward: the nine interlocking triangles, the lotus rings and the square gateways."},{"@type":"HowToStep","position":2,"text":"Treat each stage as a contemplation of the goddess unfolding into the world, not as geometry homework."}],"isBasedOn":["https://www.youtube.com/watch?v=6olAX60szz4"],"about":[{"@id":"https://tantrafiles.xyz/tradition/sri-vidya"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/basic-saiva-siddhanta-meditation","url":"https://tantrafiles.xyz/practice/basic-saiva-siddhanta-meditation","name":"Basic Śaiva Siddhānta meditation","description":"Sit upright, regulate the breath to a slow even count, then draw awareness inward from the senses to the spine and to the inner light, holding a single point of focus. Hinduism Today's monastery teaches it as part of daily worship and study.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Sit upright, regulate the breath to a slow even count, then draw awareness inward from the senses to the spine and to the inner light, holding a single point of focus."},{"@type":"HowToStep","position":2,"text":"Hinduism Today's monastery teaches it as part of daily worship and study."}],"isBasedOn":["https://www.youtube.com/watch?v=EMUCh4-ycUs"],"about":[{"@id":"https://tantrafiles.xyz/tradition/shaiva-siddhanta"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/mantra-repetition-japa","url":"https://tantrafiles.xyz/practice/mantra-repetition-japa","name":"Mantra repetition (japa)","description":"Choose a mantra received from your tradition, sit with a mala, and repeat it at an even pace, aloud, whispered or mentally. Let attention rest on the sound and its meaning; when the mind wanders, return to the next repetition.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Choose a mantra received from your tradition, sit with a mala, and repeat it at an even pace, aloud, whispered or mentally."},{"@type":"HowToStep","position":2,"text":"Let attention rest on the sound and its meaning; when the mind wanders, return to the next repetition."}],"isBasedOn":["https://www.youtube.com/watch?v=61Ei8vR-c5Y"],"about":[{"@id":"https://tantrafiles.xyz/tradition/shakta"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/anapanasati-breath-meditation-method-2","url":"https://tantrafiles.xyz/practice/anapanasati-breath-meditation-method-2","name":"Ānāpānasati (breath meditation, \"Method 2\")","description":"Sit upright and notice the breath at whatever point it is clearest. Let it settle into a comfortable rhythm, then let that sense of ease spread through the whole body, using the breath energy as a home base for steady, alert attention.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Sit upright and notice the breath at whatever point it is clearest."},{"@type":"HowToStep","position":2,"text":"Let it settle into a comfortable rhythm, then let that sense of ease spread through the whole body, using the breath energy as a home base for steady, alert attention."}],"isBasedOn":["https://www.dhammatalks.org/books/WithEachAndEveryBreath/Contents.html"],"about":[{"@id":"https://tantrafiles.xyz/tradition/mun-boowa-line"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/buddho-recollection","url":"https://tantrafiles.xyz/practice/buddho-recollection","name":"\"Buddho\" recollection","description":"Silently repeat \"bud-\" on the in-breath and \"-dho\" on the out-breath to anchor the mind; when the mind is calm, drop the word and stay with the knowing itself. Used widely in the Ajahn Mun and Ajahn Chah lines.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Silently repeat \"bud-\" on the in-breath and \"-dho\" on the out-breath to anchor the mind; when the mind is calm, drop the word and stay with the knowing itself."},{"@type":"HowToStep","position":2,"text":"Used widely in the Ajahn Mun and Ajahn Chah lines."}],"isBasedOn":["https://www.accesstoinsight.org/lib/thai/chah/index.html"],"about":[{"@id":"https://tantrafiles.xyz/tradition/thai-forest"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/walking-meditation-jongrom","url":"https://tantrafiles.xyz/practice/walking-meditation-jongrom","name":"Walking meditation (jongrom)","description":"Choose a straight path of 15–30 paces. Walk at a natural or slow pace, attention on the feet or the whole body; at each end, stop, turn, and re-collect before walking back.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Choose a straight path of 15–30 paces."},{"@type":"HowToStep","position":2,"text":"Walk at a natural or slow pace, attention on the feet or the whole body; at each end, stop, turn, and re-collect before walking back."}],"isBasedOn":["https://www.accesstoinsight.org/lib/thai/chah/index.html"],"about":[{"@id":"https://tantrafiles.xyz/tradition/chah-line"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/mahasi-noting","url":"https://tantrafiles.xyz/practice/mahasi-noting","name":"Mahasi noting","description":"Watch the rise and fall of the abdomen and give each event a soft mental label (\"rising\", \"falling\", \"thinking\", \"hearing\"), then return to the primary object; move to slow walking with labels for lifting, moving and placing.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"Watch the rise and fall of the abdomen and give each event a soft mental label (\"rising\", \"falling\", \"thinking\", \"hearing\"), then return to the primary object; move to slow walking with labels for lifting, moving and placing."}],"isBasedOn":["https://www.accesstoinsight.org/lib/authors/mahasi/wheel370.html"],"about":[{"@id":"https://tantrafiles.xyz/tradition/mahasi"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/natural-awareness-right-attitude","url":"https://tantrafiles.xyz/practice/natural-awareness-right-attitude","name":"Natural awareness (right attitude)","description":"Instead of forcing focus on one object, relax and know whatever is being experienced, checking the attitude of the observing mind (craving, aversion, impatience) throughout daily activities.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Instead of forcing focus on one object, relax and know whatever is being experienced, checking the attitude of the observing mind (craving, aversion, impatience) throughout daily activities."}],"isBasedOn":["https://ashintejaniya.org/teachings"],"about":[{"@id":"https://tantrafiles.xyz/tradition/shwe-oo-min"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/satipatthana-four-establishings-of-mindfulness","url":"https://tantrafiles.xyz/practice/satipatthana-four-establishings-of-mindfulness","name":"Satipaṭṭhāna (four establishings of mindfulness)","description":"Contemplate body, feeling, mind and mental qualities as they arise and pass, ardent, clearly knowing and mindful, without greed or distress about the world (MN 10).","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"Contemplate body, feeling, mind and mental qualities as they arise and pass, ardent, clearly knowing and mindful, without greed or distress about the world (MN 10)."}],"isBasedOn":["https://www.accesstoinsight.org/tipitaka/mn/mn.010.than.html"],"about":[{"@id":"https://tantrafiles.xyz/tradition/early-suttas"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/rain","url":"https://tantrafiles.xyz/practice/rain","name":"RAIN","description":"Recognise what is happening; Allow it to be there; Investigate with kindness how it feels in the body; Nurture with self-compassion; then rest in the awareness that remains.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Recognise what is happening; Allow it to be there; Investigate with kindness how it feels in the body; Nurture with self-compassion; then rest in the awareness that remains."}],"isBasedOn":["https://www.tarabrach.com/rain/"],"about":[{"@id":"https://tantrafiles.xyz/tradition/insight"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/open-awareness-shamatha-without-a-support","url":"https://tantrafiles.xyz/practice/open-awareness-shamatha-without-a-support","name":"Open awareness (shamatha without a support)","description":"After a few minutes with a support, let it go. Leave the eyes open and the gaze soft. Let sights, sounds and thoughts come and go, and do not follow them or push them away. When you get caught up, simply notice it and relax again. The point is to rest as the knowing that is already present.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"After a few minutes with a support, let it go."},{"@type":"HowToStep","position":2,"text":"Leave the eyes open and the gaze soft."},{"@type":"HowToStep","position":3,"text":"Let sights, sounds and thoughts come and go, and do not follow them or push them away."},{"@type":"HowToStep","position":4,"text":"When you get caught up, simply notice it and relax again."},{"@type":"HowToStep","position":5,"text":"The point is to rest as the knowing that is already present."}],"isBasedOn":["https://tergar.org"],"about":[{"@id":"https://tantrafiles.xyz/tradition/tibetan"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/looking-at-the-mind-mahamudra","url":"https://tantrafiles.xyz/practice/looking-at-the-mind-mahamudra","name":"Looking at the mind (Mahamudra)","description":"Once the mind is calm, turn and look for the one who is looking. Ask where a thought comes from, where it stays, and where it goes. Do not reason about it; just look and rest in whatever is seen or not found. This practice is traditionally done under a qualified teacher's guidance.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"Once the mind is calm, turn and look for the one who is looking."},{"@type":"HowToStep","position":2,"text":"Ask where a thought comes from, where it stays, and where it goes."},{"@type":"HowToStep","position":3,"text":"Do not reason about it; just look and rest in whatever is seen or not found."},{"@type":"HowToStep","position":4,"text":"This practice is traditionally done under a qualified teacher's guidance."}],"isBasedOn":["https://www.lotsawahouse.org/topics/mahamudra/"],"about":[{"@id":"https://tantrafiles.xyz/tradition/kagyu"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/resting-in-rigpa-dzogchen-orientation-only","url":"https://tantrafiles.xyz/practice/resting-in-rigpa-dzogchen-orientation-only","name":"Resting in rigpa (Dzogchen), orientation only","description":"In Dzogchen, the student is introduced to the nature of mind (rigpa) by a teacher. Between sessions, practitioners recall that recognition, leave it uncontrived for short moments, many times, and release any effort to improve it. This entry describes the practice and is not a substitute for the introduction itself.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"In Dzogchen, the student is introduced to the nature of mind (rigpa) by a teacher. Between sessions, practitioners recall that recognition, leave it uncontrived for short moments, many times, and release any effort to improve it. This entry describes the practice and is not a substitute for the introduction itself."}],"isBasedOn":["https://tsoknyirinpoche.org"],"about":[{"@id":"https://tantrafiles.xyz/tradition/nyingma"}],"warning":"Orientation only: this practice is traditionally learned from a qualified teacher in its lineage. Read and listen; do not attempt it from a summary.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/shikantaza-just-sitting","url":"https://tantrafiles.xyz/practice/shikantaza-just-sitting","name":"Shikantaza (just sitting)","description":"Sit as in zazen, but drop counting and any object. Simply sit, aware of the whole posture and the whole field of experience, without chasing or suppressing anything. When you find yourself lost in thought, come back to the posture. Dogen treats the sitting itself as realisation, not as a means to it.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Sit as in zazen, but drop counting and any object."},{"@type":"HowToStep","position":2,"text":"Simply sit, aware of the whole posture and the whole field of experience, without chasing or suppressing anything."},{"@type":"HowToStep","position":3,"text":"When you find yourself lost in thought, come back to the posture."},{"@type":"HowToStep","position":4,"text":"Dogen treats the sitting itself as realisation, not as a means to it."}],"isBasedOn":["https://www.sanshinji.org/"],"about":[{"@id":"https://tantrafiles.xyz/tradition/soto-zen"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/koan-practice-with-mu","url":"https://tantrafiles.xyz/practice/koan-practice-with-mu","name":"Koan practice with Mu","description":"Take up \"Does a dog have buddha nature? Mu\" (Zhaozhou). Breathe Mu on each exhalation and put your whole doubt into it. Do not interpret it. Present your understanding to a teacher in private interview (dokusan). Koan work depends on that meeting with a teacher.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Take up \"Does a dog have buddha nature?"},{"@type":"HowToStep","position":2,"text":"Mu\" (Zhaozhou)."},{"@type":"HowToStep","position":3,"text":"Breathe Mu on each exhalation and put your whole doubt into it."},{"@type":"HowToStep","position":4,"text":"Do not interpret it."},{"@type":"HowToStep","position":5,"text":"Present your understanding to a teacher in private interview (dokusan)."},{"@type":"HowToStep","position":6,"text":"Koan work depends on that meeting with a teacher."}],"isBasedOn":["https://www.mountaincloud.org"],"about":[{"@id":"https://tantrafiles.xyz/tradition/rinzai-zen"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/silent-illumination-mozhao","url":"https://tantrafiles.xyz/practice/silent-illumination-mozhao","name":"Silent illumination (mozhao)","description":"Relax the body and be aware of the whole body sitting. Widen that awareness to include the environment, without any centre or edge. Silence means not adding commentary; illumination means remaining clearly aware. Rest there, and return whenever you get caught.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Relax the body and be aware of the whole body sitting."},{"@type":"HowToStep","position":2,"text":"Widen that awareness to include the environment, without any centre or edge."},{"@type":"HowToStep","position":3,"text":"Silence means not adding commentary; illumination means remaining clearly aware."},{"@type":"HowToStep","position":4,"text":"Rest there, and return whenever you get caught."}],"isBasedOn":["https://tallahasseechan.org"],"about":[{"@id":"https://tantrafiles.xyz/tradition/chan"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/bhairavi-sadhana-isha","url":"https://tantrafiles.xyz/practice/bhairavi-sadhana-isha","name":"Bhairavi Sadhana (Isha)","description":"A lay devotional observance offered by the Isha Foundation around Linga Bhairavi: for a set period the practitioner keeps simple disciplines (as given by Isha), offers daily devotion to the goddess, and completes it with an offering at a Linga Bhairavi abode. The exact rules come from the organisation each year.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"A lay devotional observance offered by the Isha Foundation around Linga Bhairavi: for a set period the practitioner keeps simple disciplines (as given by Isha), offers daily devotion to the goddess, and completes it with an offering at a Linga Bhairavi abode. The exact rules come from the organisation each year."}],"isBasedOn":["https://www.youtube.com/watch?v=WV7XEev2arA"],"about":[{"@id":"https://tantrafiles.xyz/tradition/shakta"}],"warning":"Orientation only: this practice is traditionally learned from a qualified teacher in its lineage. Read and listen; do not attempt it from a summary.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/sravana-manana-nididhyasana","url":"https://tantrafiles.xyz/practice/sravana-manana-nididhyasana","name":"Śravaṇa–manana–nididhyāsana","description":"Systematic listening to the Upaniṣads with a teacher (śravaṇa), resolving doubts by reflection (manana), and dwelling on the understood meaning until it is assimilated (nididhyāsana).","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"Systematic listening to the Upaniṣads with a teacher (śravaṇa), resolving doubts by reflection (manana), and dwelling on the understood meaning until it is assimilated (nididhyāsana)."}],"isBasedOn":["https://arshabodha.org"],"about":[{"@id":"https://tantrafiles.xyz/tradition/arsha-vidya"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/japa-repetition-of-a-divine-name","url":"https://tantrafiles.xyz/practice/japa-repetition-of-a-divine-name","name":"Japa (repetition of a divine name)","description":"Repeat a mantra or name of God given by the teacher, often with a mālā of 108 beads, letting the mind rest in its meaning and the feeling of devotion.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Repeat a mantra or name of God given by the teacher, often with a mālā of 108 beads, letting the mind rest in its meaning and the feeling of devotion."}],"isBasedOn":["https://www.ramakrishnavivekananda.info/gospel/gospel.htm"],"about":[{"@id":"https://tantrafiles.xyz/tradition/ramakrishna-order"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/hare-krishna-mahamantra-japa-and-kirtan","url":"https://tantrafiles.xyz/practice/hare-krishna-mahamantra-japa-and-kirtan","name":"Hare Krishna mahāmantra (japa and kīrtan)","description":"Chant \"Hare Kṛṣṇa Hare Kṛṣṇa, Kṛṣṇa Kṛṣṇa Hare Hare / Hare Rāma Hare Rāma, Rāma Rāma Hare Hare\" softly on beads (japa) or sing it together (kīrtan), as practised since Chaitanya.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Chant \"Hare Kṛṣṇa Hare Kṛṣṇa, Kṛṣṇa Kṛṣṇa Hare Hare / Hare Rāma Hare Rāma, Rāma Rāma Hare Hare\" softly on beads (japa) or sing it together (kīrtan), as practised since Chaitanya."}],"isBasedOn":["https://vedabase.io/en/library/bg/"],"about":[{"@id":"https://tantrafiles.xyz/tradition/gaudiya"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/nembutsu-nianfo","url":"https://tantrafiles.xyz/practice/nembutsu-nianfo","name":"Nembutsu / nianfo","description":"Recite \"Namu Amida Butsu\" (Japanese) or \"Namo Amituofo\" (Chinese), aloud or silently, with a mala if you like. In Chinese Pure Land, recitation is a practice of concentration and aspiration for rebirth. In Shin Buddhism, it is an expression of gratitude for Amida's vow, not a means of earning anything.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Recite \"Namu Amida Butsu\" (Japanese) or \"Namo Amituofo\" (Chinese), aloud or silently, with a mala if you like."},{"@type":"HowToStep","position":2,"text":"In Chinese Pure Land, recitation is a practice of concentration and aspiration for rebirth."},{"@type":"HowToStep","position":3,"text":"In Shin Buddhism, it is an expression of gratitude for Amida's vow, not a means of earning anything."}],"isBasedOn":["https://www.shinranworks.com/"],"about":[{"@id":"https://tantrafiles.xyz/tradition/pure-land"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/christian-meditation-with-a-mantra-maranatha","url":"https://tantrafiles.xyz/practice/christian-meditation-with-a-mantra-maranatha","name":"Christian meditation with a mantra (Maranatha)","description":"Sit still and upright with your eyes lightly closed. Silently repeat one prayer-word, \"Ma-ra-na-tha\", in four equal syllables, listening to it rather than thinking about its meaning. When thoughts or images arrive, return to the word, without force. Sit for 20–30 minutes, morning and evening.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Sit still and upright with your eyes lightly closed."},{"@type":"HowToStep","position":2,"text":"Silently repeat one prayer-word, \"Ma-ra-na-tha\", in four equal syllables, listening to it rather than thinking about its meaning."},{"@type":"HowToStep","position":3,"text":"When thoughts or images arrive, return to the word, without force."},{"@type":"HowToStep","position":4,"text":"Sit for 20–30 minutes, morning and evening."}],"isBasedOn":["https://wccm.org/meditate/how-to-meditate/"],"about":[{"@id":"https://tantrafiles.xyz/tradition/christian-meditation-wccm"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/centering-prayer","url":"https://tantrafiles.xyz/practice/centering-prayer","name":"Centering Prayer","description":"Choose a sacred word as a sign of consent to God's presence. Sit comfortably and bring it in gently. When you notice you are engaged with a thought, return ever so gently to the word. End by resting in silence for a couple of minutes. Twice daily, 20 minutes.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Choose a sacred word as a sign of consent to God's presence."},{"@type":"HowToStep","position":2,"text":"Sit comfortably and bring it in gently."},{"@type":"HowToStep","position":3,"text":"When you notice you are engaged with a thought, return ever so gently to the word."},{"@type":"HowToStep","position":4,"text":"End by resting in silence for a couple of minutes."},{"@type":"HowToStep","position":5,"text":"Twice daily, 20 minutes."}],"isBasedOn":["https://www.cynthiabourgeault.org/meet-cynthia"],"about":[{"@id":"https://tantrafiles.xyz/tradition/wisdom-christianity"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/lectio-divina","url":"https://tantrafiles.xyz/practice/lectio-divina","name":"Lectio Divina","description":"Read a short scripture passage slowly, then again; notice the word that catches you; respond to it in prayer; rest in silence. Read, ponder, pray, rest.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Read a short scripture passage slowly, then again; notice the word that catches you; respond to it in prayer; rest in silence."},{"@type":"HowToStep","position":2,"text":"Read, ponder, pray, rest."}],"isBasedOn":["https://www.youtube.com/watch?v=YHtsSE2-nOI"],"about":[{"@id":"https://tantrafiles.xyz/tradition/franciscan-contemplative"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/the-jesus-prayer-prayer-of-the-heart","url":"https://tantrafiles.xyz/practice/the-jesus-prayer-prayer-of-the-heart","name":"The Jesus Prayer (prayer of the heart)","description":"Repeat \"Lord Jesus Christ, Son of God, have mercy on me\" slowly and attentively, often with a prayer rope, keeping the mind in the words and letting it descend into the heart. Begin with a fixed time each day; humility and stillness come before technique.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Repeat \"Lord Jesus Christ, Son of God, have mercy on me\" slowly and attentively, often with a prayer rope, keeping the mind in the words and letting it descend into the heart."},{"@type":"HowToStep","position":2,"text":"Begin with a fixed time each day; humility and stillness come before technique."}],"isBasedOn":["https://www.youtube.com/watch?v=03TkFLFTbhk"],"about":[{"@id":"https://tantrafiles.xyz/tradition/hesychasm"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/zikr-remembrance-in-the-inayati-way","url":"https://tantrafiles.xyz/practice/zikr-remembrance-in-the-inayati-way","name":"Zikr (remembrance) in the Inayati way","description":"Sitting quietly, repeat the phrase of divine unity (La ilaha illa'llah) aloud or silently, letting the breath and a gentle movement of the head carry it, until the remembrance continues on its own in the heart.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Sitting quietly, repeat the phrase of divine unity (La ilaha illa'llah) aloud or silently, letting the breath and a gentle movement of the head carry it, until the remembrance continues on its own in the heart."}],"isBasedOn":["https://www.youtube.com/watch?v=0E9efdH7hBQ"],"about":[{"@id":"https://tantrafiles.xyz/tradition/inayati"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/dhikr-and-breathwork","url":"https://tantrafiles.xyz/practice/dhikr-and-breathwork","name":"Dhikr and breathwork","description":"Join a short divine name or phrase to the in- and out-breath; keep attention on the heart; finish with silence and a prayer.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Join a short divine name or phrase to the in- and out-breath; keep attention on the heart; finish with silence and a prayer."}],"isBasedOn":["https://www.youtube.com/watch?v=SiO6IKavFUA"],"about":[{"@id":"https://tantrafiles.xyz/tradition/sufism"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/khatm-i-khwajagan-naqshbandi-group-dhikr","url":"https://tantrafiles.xyz/practice/khatm-i-khwajagan-naqshbandi-group-dhikr","name":"Khatm-i Khwajagan (Naqshbandi group dhikr)","description":"A set Naqshbandi litany of Qur'an recitation, blessings on the Prophet and silent or vocal remembrance, recited together under a shaykh's guidance.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"A set Naqshbandi litany of Qur'an recitation, blessings on the Prophet and silent or vocal remembrance, recited together under a shaykh's guidance."}],"isBasedOn":["https://www.youtube.com/watch?v=HVOW77p_j3o"],"about":[{"@id":"https://tantrafiles.xyz/tradition/naqshbandi"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/weekly-parashah-reflection-neo-hasidic","url":"https://tantrafiles.xyz/practice/weekly-parashah-reflection-neo-hasidic","name":"Weekly parashah reflection (neo-Hasidic)","description":"Each week read the Torah portion with a Hasidic commentary in mind and look for the inward, devotional teaching it holds for this week of your life.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"Each week read the Torah portion with a Hasidic commentary in mind and look for the inward, devotional teaching it holds for this week of your life."}],"isBasedOn":["https://www.youtube.com/watch?v=bBfGhEOzXcU"],"about":[{"@id":"https://tantrafiles.xyz/tradition/neo-hasidism"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/calming-and-contemplation-zhiguan","url":"https://tantrafiles.xyz/practice/calming-and-contemplation-zhiguan","name":"Calming and contemplation (zhiguan)","description":"First calm the mind (zhi) by settling the breath and posture. Then contemplate (guan) any present thought as simultaneously empty, provisionally existing, and the middle, which are the threefold truth. Zhiyi's Mohe zhiguan sets out four kinds of samadhi practice (constant sitting, constant walking, half-walking half-sitting, and neither).","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"First calm the mind (zhi) by settling the breath and posture."},{"@type":"HowToStep","position":2,"text":"Then contemplate (guan) any present thought as simultaneously empty, provisionally existing, and the middle, which are the threefold truth."},{"@type":"HowToStep","position":3,"text":"Zhiyi's Mohe zhiguan sets out four kinds of samadhi practice (constant sitting, constant walking, half-walking half-sitting, and neither)."}],"isBasedOn":["https://www.tendai.org"],"about":[{"@id":"https://tantrafiles.xyz/tradition/tiantai"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/rudi-s-double-breath","url":"https://tantrafiles.xyz/practice/rudi-s-double-breath","name":"Rudi's double breath","description":"Breathe in, bringing attention down from the throat into the heart, and then down to the navel and the base of the body. Breathing out, let the energy rise up the spine. Keep the movement gentle and continuous, and return to the heart when attention scatters.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Breathe in, bringing attention down from the throat into the heart, and then down to the navel and the base of the body. Breathing out, let the energy rise up the spine. Keep the movement gentle and continuous, and return to the heart when attention scatters."}],"isBasedOn":["https://www.youtube.com/watch?v=NOioVq5l6Yk"],"about":[{"@id":"https://tantrafiles.xyz/tradition/kashmir-shaivism"}],"warning":"Orientation only: this practice is traditionally learned from a qualified teacher in its lineage. Read and listen; do not attempt it from a summary.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/khecari-mudra-historical-description-only","url":"https://tantrafiles.xyz/practice/khecari-mudra-historical-description-only","name":"Khecarī mudrā (historical description only)","description":"Described in haṭha texts as turning the tongue back and up into the cavity above the soft palate, sometimes after gradually lengthening the tongue. We list it for context: the full form involves cutting the frenum and is not something to try from a video.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"Described in haṭha texts as turning the tongue back and up into the cavity above the soft palate, sometimes after gradually lengthening the tongue. We list it for context: the full form involves cutting the frenum and is not something to try from a video."}],"isBasedOn":["https://ora.ox.ac.uk/objects/uuid:945071bf-3282-4492-8f18-159417f5d554"],"about":[{"@id":"https://tantrafiles.xyz/tradition/hatha"}],"warning":"Orientation only: this practice is traditionally learned from a qualified teacher in its lineage. Read and listen; do not attempt it from a summary.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/dream-yoga-first-steps","url":"https://tantrafiles.xyz/practice/dream-yoga-first-steps","name":"Dream yoga, first steps","description":"During the day, keep reminding yourself \"this is a dream\" so that the habit carries into sleep. Before sleep, set a strong intention to recognise dreams. Visualise a luminous syllable at the throat as you fall asleep. Each morning, review whether you recognised a dream, and renew the intention.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"During the day, keep reminding yourself \"this is a dream\" so that the habit carries into sleep."},{"@type":"HowToStep","position":2,"text":"Before sleep, set a strong intention to recognise dreams."},{"@type":"HowToStep","position":3,"text":"Visualise a luminous syllable at the throat as you fall asleep."},{"@type":"HowToStep","position":4,"text":"Each morning, review whether you recognised a dream, and renew the intention."}],"isBasedOn":["https://ligmincha.org"],"about":[{"@id":"https://tantrafiles.xyz/tradition/bon"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/feeding-your-demons-a-modern-adaptation-of-chod","url":"https://tantrafiles.xyz/practice/feeding-your-demons-a-modern-adaptation-of-chod","name":"Feeding your demons (a modern adaptation of Chöd)","description":"Find a struggle, such as fear or a craving, and feel where it lives in the body. Picture it as a figure in front of you and ask what it wants and what it really needs. Then imagine dissolving your body into nectar that gives it exactly that, until it is satisfied. Rest in the open space that remains.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"Find a struggle, such as fear or a craving, and feel where it lives in the body."},{"@type":"HowToStep","position":2,"text":"Picture it as a figure in front of you and ask what it wants and what it really needs."},{"@type":"HowToStep","position":3,"text":"Then imagine dissolving your body into nectar that gives it exactly that, until it is satisfied."},{"@type":"HowToStep","position":4,"text":"Rest in the open space that remains."}],"isBasedOn":["https://taramandala.org"],"about":[{"@id":"https://tantrafiles.xyz/tradition/nyingma"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/the-view-from-above-spiritual-exercise","url":"https://tantrafiles.xyz/practice/the-view-from-above-spiritual-exercise","name":"The view from above (spiritual exercise)","description":"In imagination, rise above your situation until your concerns appear in the scale of the cosmos; return with a lighter, more just sense of what matters. One of the ancient \"spiritual exercises\" Pierre Hadot described.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"In imagination, rise above your situation until your concerns appear in the scale of the cosmos; return with a lighter, more just sense of what matters."},{"@type":"HowToStep","position":2,"text":"One of the ancient \"spiritual exercises\" Pierre Hadot described."}],"isBasedOn":["https://iep.utm.edu/hadot"],"about":[{"@id":"https://tantrafiles.xyz/tradition/independent"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/hermetic-ascent-and-rebirth-corpus-hermeticum-xiii","url":"https://tantrafiles.xyz/practice/hermetic-ascent-and-rebirth-corpus-hermeticum-xiii","name":"Hermetic ascent and rebirth (Corpus Hermeticum XIII)","description":"Read slowly and as contemplation, not just as information: the treatise guides the reader to put away the \"torments\" of matter and be reborn as the intellect praising God in silence.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"Read slowly and as contemplation, not just as information: the treatise guides the reader to put away the \"torments\" of matter and be reborn as the intellect praising God in silence."}],"isBasedOn":["https://en.wikisource.org/wiki/The_Divine_Pymander"],"about":[{"@id":"https://tantrafiles.xyz/tradition/hermeticism"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/active-imagination-imaginal-attention","url":"https://tantrafiles.xyz/practice/active-imagination-imaginal-attention","name":"Active imagination / imaginal attention","description":"Stay with an image (from a dream, a text or a place) as a living presence; let it speak and move; respond to it honestly rather than interpreting it away. In Corbin's terms it is a perception of the mundus imaginalis.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"Stay with an image (from a dream, a text or a place) as a living presence; let it speak and move; respond to it honestly rather than interpreting it away."},{"@type":"HowToStep","position":2,"text":"In Corbin's terms it is a perception of the mundus imaginalis."}],"isBasedOn":["https://www.youtube.com/watch?v=E-sFVUF5FQQ"],"about":[{"@id":"https://tantrafiles.xyz/tradition/imaginal"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/neelakantha-meditation","url":"https://tantrafiles.xyz/practice/neelakantha-meditation","name":"Neelakantha Meditation (mantra-based)","description":"This is an initiated mantra practice: the mantra is received from an authorised teacher. In outline, one sits twice a day, repeats the given mantra inwardly and lets it become subtle, treating the body as a stable platform rather than an obstacle. Learn it from the school; we describe it only so users know what the clips refer to.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"This is an initiated mantra practice: the mantra is received from an authorised teacher."},{"@type":"HowToStep","position":2,"text":"In outline, one sits twice a day, repeats the given mantra inwardly and lets it become subtle, treating the body as a stable platform rather than an obstacle."},{"@type":"HowToStep","position":3,"text":"Learn it from the school; we describe it only so users know what the clips refer to."}],"isBasedOn":["https://www.youtube.com/watch?v=kJ9w9Xvh-W4"],"about":[{"@id":"https://tantrafiles.xyz/tradition/kashmir-shaivism"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/nyasa","url":"https://tantrafiles.xyz/practice/nyasa","name":"Nyāsa — placing mantra on the body","description":"Touch or attend to specific points of the body (heart, head, crown, arms) while silently repeating the syllables assigned to them, so the body is treated as a seat of the deity before worship or meditation. Traditionally learnt with the specific mantra from a teacher.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Touch or attend to specific points of the body (heart, head, crown, arms) while silently repeating the syllables assigned to them, so the body is treated as a seat of the deity before worship or meditation."},{"@type":"HowToStep","position":2,"text":"Traditionally learnt with the specific mantra from a teacher."}],"isBasedOn":["https://www.youtube.com/watch?v=Jj5G8ev3Hiw"],"about":[{"@id":"https://tantrafiles.xyz/tradition/sri-vidya"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/twelve-kalis","url":"https://tantrafiles.xyz/practice/twelve-kalis","name":"Contemplating the Twelve Kālīs (Krama)","description":"Take one Kālī of the Krama sequence at a time (e.g. Sṛṣṭikālī, the Kālī of creation). Study what phase of cognition she stands for — an object arising, being held, being withdrawn into the knower — and watch that phase in your own experience during the day.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"Take one Kālī of the Krama sequence at a time (e.g."},{"@type":"HowToStep","position":2,"text":"Sṛṣṭikālī, the Kālī of creation)."},{"@type":"HowToStep","position":3,"text":"Study what phase of cognition she stands for — an object arising, being held, being withdrawn into the knower — and watch that phase in your own experience during the day."}],"isBasedOn":["https://www.youtube.com/watch?v=TgM_9d-fe-M"],"about":[{"@id":"https://tantrafiles.xyz/tradition/krama"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/metta-loving-kindness","url":"https://tantrafiles.xyz/practice/metta-loving-kindness","name":"Mettā (loving-kindness)","description":"Wish well to yourself, then a benefactor, a friend, a neutral person, a difficult person and finally all beings, using simple phrases or a felt sense of goodwill, letting it spread in every direction.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"Wish well to yourself, then a benefactor, a friend, a neutral person, a difficult person and finally all beings, using simple phrases or a felt sense of goodwill, letting it spread in every direction."}],"isBasedOn":["https://www.accesstoinsight.org/tipitaka/kn/snp/snp.1.08.amar.html"],"about":[{"@id":"https://tantrafiles.xyz/tradition/early-suttas"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/body-sweeping-goenka-vipassana","url":"https://tantrafiles.xyz/practice/body-sweeping-goenka-vipassana","name":"Body sweeping (Goenka vipassanā)","description":"After a few days of ānāpāna to sharpen attention, move attention systematically through the body from head to feet, observing every sensation with equanimity, as taught in ten-day residential courses.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"After a few days of ānāpāna to sharpen attention, move attention systematically through the body from head to feet, observing every sensation with equanimity, as taught in ten-day residential courses."}],"isBasedOn":["https://www.dhamma.org/en/about/vipassana"],"about":[{"@id":"https://tantrafiles.xyz/tradition/goenka-vipassana"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/yoga-nidra","url":"https://tantrafiles.xyz/practice/yoga-nidra","name":"Yoga nidrā","description":"Lying down, rotate awareness through the body, then breath, opposite sensations and visualisations while staying awake, ending with a personal resolve (saṅkalpa).","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Lying down, rotate awareness through the body, then breath, opposite sensations and visualisations while staying awake, ending with a personal resolve (saṅkalpa)."}],"isBasedOn":["https://www.biharyoga.net/"],"about":[{"@id":"https://tantrafiles.xyz/tradition/bihar-yoga"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/five-points-of-yoga-sivananda","url":"https://tantrafiles.xyz/practice/five-points-of-yoga-sivananda","name":"Five points of yoga (Sivananda)","description":"Proper exercise (āsana), proper breathing (prāṇāyāma), proper relaxation, proper diet and positive thinking with meditation, as summarised by Swami Vishnudevananda.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Proper exercise (āsana), proper breathing (prāṇāyāma), proper relaxation, proper diet and positive thinking with meditation, as summarised by Swami Vishnudevananda."}],"isBasedOn":["https://www.sivananda.org/teachings/"],"about":[{"@id":"https://tantrafiles.xyz/tradition/sivananda-yoga"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell. Reflections on death can stir grief. Go gently, and set the practice aside if it overwhelms you.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/breath-centred-individually-adapted-asana-viniyoga","url":"https://tantrafiles.xyz/practice/breath-centred-individually-adapted-asana-viniyoga","name":"Breath-centred, individually adapted āsana (viniyoga)","description":"Link every movement to a slow inhale or exhale and adapt sequence, length and intensity to the person's body, age and aims, as taught by Krishnamacharya and T. K. V. Desikachar.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Link every movement to a slow inhale or exhale and adapt sequence, length and intensity to the person's body, age and aims, as taught by Krishnamacharya and T."},{"@type":"HowToStep","position":2,"text":"Desikachar."}],"isBasedOn":["https://www.kym.org/"],"about":[{"@id":"https://tantrafiles.xyz/tradition/krishnamacharya-yoga"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/shamatha-with-object","url":"https://tantrafiles.xyz/practice/shamatha-with-object","name":"Calm abiding with a support","description":"Sit upright and relaxed. Rest your attention lightly on a simple support, such as the breath at the nostrils, a pebble, or a sound. When you notice the mind has wandered, return to the support without scolding yourself. Aim for many short, clear sessions rather than a few long, dull ones. Over time, loosen your grip until attention rests on its own.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Sit upright and relaxed."},{"@type":"HowToStep","position":2,"text":"Rest your attention lightly on a simple support, such as the breath at the nostrils, a pebble, or a sound."},{"@type":"HowToStep","position":3,"text":"When you notice the mind has wandered, return to the support without scolding yourself."},{"@type":"HowToStep","position":4,"text":"Aim for many short, clear sessions rather than a few long, dull ones."},{"@type":"HowToStep","position":5,"text":"Over time, loosen your grip until attention rests on its own."}],"isBasedOn":["https://tergar.org"],"about":[{"@id":"https://tantrafiles.xyz/tradition/tibetan"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/tonglen","url":"https://tantrafiles.xyz/practice/tonglen","name":"Tonglen (sending and taking)","description":"Flash briefly on open, spacious mind. Then breathe in a feeling of heaviness and heat, and breathe out a feeling of coolness and light. Start with a real person who is suffering, perhaps yourself, and breathe in their pain while breathing out relief. Widen this to everyone who feels the same. Keep it simple and close to how you actually feel.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Flash briefly on open, spacious mind."},{"@type":"HowToStep","position":2,"text":"Then breathe in a feeling of heaviness and heat, and breathe out a feeling of coolness and light."},{"@type":"HowToStep","position":3,"text":"Start with a real person who is suffering, perhaps yourself, and breathe in their pain while breathing out relief."},{"@type":"HowToStep","position":4,"text":"Widen this to everyone who feels the same."},{"@type":"HowToStep","position":5,"text":"Keep it simple and close to how you actually feel."}],"isBasedOn":["https://pemachodronfoundation.org"],"about":[{"@id":"https://tantrafiles.xyz/tradition/tibetan"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/lojong-slogans","url":"https://tantrafiles.xyz/practice/lojong-slogans","name":"Mind training (lojong) slogans","description":"Choose one of the 59 slogans of Atisha's Seven Points, such as \"Drive all blames into one\". Carry it through the day. When irritation or self-cherishing comes up, recall the slogan and look again at the situation. Review the day each evening.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Choose one of the 59 slogans of Atisha's Seven Points, such as \"Drive all blames into one\"."},{"@type":"HowToStep","position":2,"text":"Carry it through the day."},{"@type":"HowToStep","position":3,"text":"When irritation or self-cherishing comes up, recall the slogan and look again at the situation."},{"@type":"HowToStep","position":4,"text":"Review the day each evening."}],"isBasedOn":["https://www.lotsawahouse.org/topics/lojong/"],"about":[{"@id":"https://tantrafiles.xyz/tradition/tibetan"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/nine-breathings","url":"https://tantrafiles.xyz/practice/nine-breathings","name":"Nine breathings of purification","description":"Visualise the three channels: a central blue channel with a white one on the right and a red one on the left. Breathe in through the right nostril and out through the left three times, releasing anger. Then breathe in through the left and out through the right three times, releasing attachment. Finally, breathe in through both and push the breath up the central channel three times, releasing ignor","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Visualise the three channels: a central blue channel with a white one on the right and a red one on the left."},{"@type":"HowToStep","position":2,"text":"Breathe in through the right nostril and out through the left three times, releasing anger."},{"@type":"HowToStep","position":3,"text":"Then breathe in through the left and out through the right three times, releasing attachment."},{"@type":"HowToStep","position":4,"text":"Finally, breathe in through both and push the breath up the central channel three times, releasing ignorance."},{"@type":"HowToStep","position":5,"text":"Rest afterwards."}],"isBasedOn":["https://ligmincha.org"],"about":[{"@id":"https://tantrafiles.xyz/tradition/bon"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/zazen","url":"https://tantrafiles.xyz/practice/zazen","name":"Zazen posture and breath","description":"Sit on a cushion with your knees on the floor, or on a chair, with the spine upright. Rest the hands in the cosmic mudra, left on right with the thumbs lightly touching, and keep the eyes half-open and lowered. Breathe naturally through the nose. Beginners can count breaths from one to ten and start again whenever they lose count.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Sit on a cushion with your knees on the floor, or on a chair, with the spine upright."},{"@type":"HowToStep","position":2,"text":"Rest the hands in the cosmic mudra, left on right with the thumbs lightly touching, and keep the eyes half-open and lowered."},{"@type":"HowToStep","position":3,"text":"Breathe naturally through the nose."},{"@type":"HowToStep","position":4,"text":"Beginners can count breaths from one to ten and start again whenever they lose count."}],"isBasedOn":["https://www.sotozen.com/eng/practice/zazen/howto/"],"about":[{"@id":"https://tantrafiles.xyz/tradition/soto-zen"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/huatou","url":"https://tantrafiles.xyz/practice/huatou","name":"Huatou (critical phrase)","description":"Take up a short question, such as \"What is wu?\" or \"Before my parents were born, what was my original face?\" Keep asking it with a sense of genuine not-knowing until a \"great doubt\" gathers. Return to the question whenever you lose it. This is Sheng Yen's method, best done in retreat with guidance.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"Take up a short question, such as \"What is wu?\" or \"Before my parents were born, what was my original face?\" Keep asking it with a sense of genuine not-knowing until a \"great doubt\" gathers."},{"@type":"HowToStep","position":2,"text":"Return to the question whenever you lose it."},{"@type":"HowToStep","position":3,"text":"This is Sheng Yen's method, best done in retreat with guidance."}],"isBasedOn":["https://www.chancenter.org/en/publications"],"about":[{"@id":"https://tantrafiles.xyz/tradition/chan"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/mindful-breathing-pv","url":"https://tantrafiles.xyz/practice/mindful-breathing-pv","name":"Mindful breathing with gathas","description":"Breathe in and silently say \"In\"; breathe out and say \"Out\". As you settle, shorten it to \"Deep / Slow\", \"Calm / Ease\" or \"Smile / Release\". Use a bell or a phone chime as a reminder to stop, breathe three times and come back to the body.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Breathe in and silently say \"In\"; breathe out and say \"Out\"."},{"@type":"HowToStep","position":2,"text":"As you settle, shorten it to \"Deep / Slow\", \"Calm / Ease\" or \"Smile / Release\"."},{"@type":"HowToStep","position":3,"text":"Use a bell or a phone chime as a reminder to stop, breathe three times and come back to the body."}],"isBasedOn":["https://plumvillage.org"],"about":[{"@id":"https://tantrafiles.xyz/tradition/plum-village"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/walking-meditation","url":"https://tantrafiles.xyz/practice/walking-meditation","name":"Walking meditation","description":"Walk slowly and coordinate your steps with your breath, for example two steps on the in-breath and three on the out-breath. Feel each foot touching the earth as if kissing it. You are not trying to arrive anywhere; every step is the arrival.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Walk slowly and coordinate your steps with your breath, for example two steps on the in-breath and three on the out-breath."},{"@type":"HowToStep","position":2,"text":"Feel each foot touching the earth as if kissing it."},{"@type":"HowToStep","position":3,"text":"You are not trying to arrive anywhere; every step is the arrival."}],"isBasedOn":["https://plumvillage.org"],"about":[{"@id":"https://tantrafiles.xyz/tradition/plum-village"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/ajikan","url":"https://tantrafiles.xyz/practice/ajikan","name":"Ajikan (A-syllable meditation)","description":"Shingon practitioners visualise the Sanskrit syllable A on a moon disc above a lotus. The A signifies the unborn source of all things. They join it with the breath and expand the moon until it fills the universe, then contract it into the heart. Formal ajikan is taught after initiation; this entry is an orientation only.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Shingon practitioners visualise the Sanskrit syllable A on a moon disc above a lotus. The A signifies the unborn source of all things. They join it with the breath and expand the moon until it fills the universe, then contract it into the heart. Formal ajikan is taught after initiation; this entry is an orientation only."}],"isBasedOn":["http://www.shingonbuddhism.org"],"about":[{"@id":"https://tantrafiles.xyz/tradition/shingon"}],"warning":"Orientation only: this practice is traditionally learned from a qualified teacher in its lineage. Read and listen; do not attempt it from a summary.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/video-lectio","url":"https://tantrafiles.xyz/practice/video-lectio","name":"Video lectio (short contemplative reading)","description":"Watch a short image or text slowly, then sit with a single phrase that stays with you before meditating.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Watch a short image or text slowly, then sit with a single phrase that stays with you before meditating."}],"isBasedOn":["https://www.youtube.com/watch?v=YzoDzlP0mYk"],"about":[{"@id":"https://tantrafiles.xyz/tradition/christian-meditation-wccm"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/welcoming-practice","url":"https://tantrafiles.xyz/practice/welcoming-practice","name":"Welcoming Practice","description":"When a strong reaction arises, feel it as a sensation in the body; say \"welcome\" to it instead of resisting; then let go of the desire for security, approval or control, and so release it into presence.","totalTime":"PT5M","step":[{"@type":"HowToStep","position":1,"text":"When a strong reaction arises, feel it as a sensation in the body; say \"welcome\" to it instead of resisting; then let go of the desire for security, approval or control, and so release it into presence."}],"isBasedOn":["https://www.youtube.com/watch?v=_bClyhR2ZPc"],"about":[{"@id":"https://tantrafiles.xyz/tradition/wisdom-christianity"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/neoplatonic-contemplation","url":"https://tantrafiles.xyz/practice/neoplatonic-contemplation","name":"Neoplatonic contemplation (\"strip away everything\")","description":"Following Plotinus, turn attention from objects to the activity of knowing, then let even that subtle self-image fall away, resting in the simple presence it comes from. Usually practised after a period of calming meditation.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Following Plotinus, turn attention from objects to the activity of knowing, then let even that subtle self-image fall away, resting in the simple presence it comes from."},{"@type":"HowToStep","position":2,"text":"Usually practised after a period of calming meditation."}],"isBasedOn":["https://www.youtube.com/watch?v=s22FBKKmpwQ"],"about":[{"@id":"https://tantrafiles.xyz/tradition/neoplatonism"}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/unio-mystica-letters","url":"https://tantrafiles.xyz/practice/unio-mystica-letters","name":"Letter-combination meditation (ecstatic Kabbalah)","description":"Abulafia's path: combine and permute the Hebrew letters of divine names, with breath and pronunciation, to loosen ordinary thinking. Historically taught only under a teacher. Listed here for context, not as instruction.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Abulafia's path: combine and permute the Hebrew letters of divine names, with breath and pronunciation, to loosen ordinary thinking."},{"@type":"HowToStep","position":2,"text":"Historically taught only under a teacher."},{"@type":"HowToStep","position":3,"text":"Listed here for context, not as instruction."}],"isBasedOn":["https://www.youtube.com/watch?v=PXL_OYU3IqM"],"about":[{"@id":"https://tantrafiles.xyz/tradition/kabbalah"}],"warning":"Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/middle-pillar-outline","url":"https://tantrafiles.xyz/practice/middle-pillar-outline","name":"The Middle Pillar (outline)","description":"Stand or sit straight. Picture a slender pillar of light along the midline of the body. Bring attention to five centers in turn, seeing each as a sphere of its colour: brilliant white above the crown; soft lavender at the throat; rose pink at the heart; deep violet at the loins; and at the feet the four earth tones quartered. Dwell briefly at each. Then picture light circulating: down the front of","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Stand or sit straight. Picture a slender pillar of light along the midline of the body. Bring attention to five centers in turn, seeing each as a sphere of its colour: brilliant white above the crown; soft lavender at the throat; rose pink at the heart; deep violet at the loins; and at the feet the four earth tones quartered. Dwell briefly at each. Then picture light circulating: down the front of the body and up the spine, around and around, steady with the breath. Close by letting the light settle and fade. Learn the full form from the order or a qualified teacher; this outline only shows wh"}],"isBasedOn":["https://en.wikipedia.org/wiki/Middle_Pillar"],"about":[{"@id":"https://tantrafiles.xyz/tradition/golden-dawn"}],"warning":"Energy visualisation: stop if you feel agitated, pressured in the head or chest, or unwell. Psychologically intense imagery; set aside if it overwhelms you. Orientation only: this practice is traditionally learned from a qualified teacher in its lineage. Read and listen; do not attempt it from a summary.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/ease-through-the-body-trika-prep","url":"https://tantrafiles.xyz/practice/ease-through-the-body-trika-prep","name":"Ease through the body with the breath (Trika prep)","description":"Sit upright and let the breath settle into a comfortable rhythm. Notice where the breath is clearest and rest attention there. Let that sense of ease spread through the whole body, using the breath as a home base for steady attention. When the mind wanders, return gently to the breath without force. Close by sitting quietly for a few breaths and noticing the whole body at once.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Sit upright and let the breath settle into a comfortable rhythm."},{"@type":"HowToStep","position":2,"text":"Notice where the breath is clearest and rest attention there."},{"@type":"HowToStep","position":3,"text":"Let that sense of ease spread through the whole body, using the breath as a home base for steady attention."},{"@type":"HowToStep","position":4,"text":"When the mind wanders, return gently to the breath without force."},{"@type":"HowToStep","position":5,"text":"Close by sitting quietly for a few breaths and noticing the whole body at once."}],"isBasedOn":["https://www.dhammatalks.org/books/WithEachAndEveryBreath/Contents.html"],"about":[{"@id":"https://tantrafiles.xyz/tradition/kashmir-shaivism"}],"warning":"Keep the breath natural; never hold it or force it. If you feel disoriented, unreal or anxious, open the eyes, feel the feet and the seat, and stop for today. This week is a foundation only. Initiated Trika practice (mantra, breath retention, subtle-body work) is learned from a qualified teacher in the tradition. Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/vbt-sound-dissolution","url":"https://tantrafiles.xyz/practice/vbt-sound-dissolution","name":"Listening to the inner sound (VBT verses 38-39)","description":"Sit comfortably and let the breath settle by itself. Listen for a faint inner sound, a soft ringing or hum beneath the sounds of the room. Rest attention on it lightly, without straining to hear. Let it be loud, soft, present or absent; do not follow it into images or stories. When the mind wanders, come back to listening. If the sound fades into quiet, rest in the quiet. When you finish, notice t","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Sit comfortably and let the breath settle by itself."},{"@type":"HowToStep","position":2,"text":"Listen for a faint inner sound, a soft ringing or hum beneath the sounds of the room."},{"@type":"HowToStep","position":3,"text":"Rest attention on it lightly, without straining to hear."},{"@type":"HowToStep","position":4,"text":"Let it be loud, soft, present or absent; do not follow it into images or stories."},{"@type":"HowToStep","position":5,"text":"When the mind wanders, come back to listening."},{"@type":"HowToStep","position":6,"text":"If the sound fades into quiet, rest in the quiet."},{"@type":"HowToStep","position":7,"text":"When you finish, notice the ordinary sounds around you again."}],"isBasedOn":["https://tantra112.app/vijnana-bhairava-tantra"],"about":[{"@id":"https://tantrafiles.xyz/tradition/kashmir-shaivism"}],"warning":"If you live with tinnitus that distresses you, listen instead to an outer sound such as a bell or a held note as it fades (verses 40-41). If you feel disoriented, unreal or anxious, open the eyes, feel the feet and the seat, and stop for today. The rest of the Vijñāna Bhairava (breath retention, mantra, the subtle-body and burning practices) is learned from a qualified teacher in the Trika tradition; Satsang lists places to practise. Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/vbt-body-as-consciousness","url":"https://tantrafiles.xyz/practice/vbt-body-as-consciousness","name":"The body as awareness (VBT verse 63)","description":"Sit and let attention rest on the whole body at once: not one part, the whole field of sensation. Then take the body, and the world around it, as made of awareness. Let this be felt rather than thought. When the mind narrows back to \"me\" and \"mine\", return to the wider field and rest there. The body stays where it is; only the sense of it being separate softens.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Sit and let attention rest on the whole body at once: not one part, the whole field of sensation."},{"@type":"HowToStep","position":2,"text":"Then take the body, and the world around it, as made of awareness."},{"@type":"HowToStep","position":3,"text":"Let this be felt rather than thought."},{"@type":"HowToStep","position":4,"text":"When the mind narrows back to \"me\" and \"mine\", return to the wider field and rest there."},{"@type":"HowToStep","position":5,"text":"The body stays where it is; only the sense of it being separate softens."}],"isBasedOn":["https://tantra112.app/vijnana-bhairava-tantra"],"about":[{"@id":"https://tantrafiles.xyz/tradition/kashmir-shaivism"}],"warning":"If you feel disoriented, unreal or anxious, open the eyes, feel the feet and the seat, and stop for today. If you have a history of trauma, dissociation, psychosis or severe anxiety, keep sits short with eyes open, or practise with a qualified teacher or clinician. The rest of the Vijñāna Bhairava (breath retention, mantra, the subtle-body and burning practices) is learned from a qualified teacher in the Trika tradition; Satsang lists places to practise.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/vbt-mind-between-objects","url":"https://tantrafiles.xyz/practice/vbt-mind-between-objects","name":"Resting between objects (VBT verse 62)","description":"First settle with the breath for a few minutes. Then notice the moment the mind lets go of one thing, a sensation, a thought, a sound, and before it takes up the next. Rest in that in-between. Do not chase the next object and do not push it away. When you find you have already moved on, come back to the gap. Practise the breath-pause sit first; this one needs a little steadiness.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"First settle with the breath for a few minutes."},{"@type":"HowToStep","position":2,"text":"Then notice the moment the mind lets go of one thing, a sensation, a thought, a sound, and before it takes up the next."},{"@type":"HowToStep","position":3,"text":"Rest in that in-between."},{"@type":"HowToStep","position":4,"text":"Do not chase the next object and do not push it away."},{"@type":"HowToStep","position":5,"text":"When you find you have already moved on, come back to the gap."},{"@type":"HowToStep","position":6,"text":"Practise the breath-pause sit first; this one needs a little steadiness."}],"isBasedOn":["https://tantra112.app/vijnana-bhairava-tantra"],"about":[{"@id":"https://tantrafiles.xyz/tradition/kashmir-shaivism"}],"warning":"If you feel disoriented, unreal or anxious, open the eyes, feel the feet and the seat, and stop for today. The rest of the Vijñāna Bhairava (breath retention, mantra, the subtle-body and burning practices) is learned from a qualified teacher in the Trika tradition; Satsang lists places to practise. Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/vbt-space-contemplation","url":"https://tantrafiles.xyz/practice/vbt-space-contemplation","name":"Spaciousness: a wall of skin with nothing inside (VBT verses 43-48)","description":"Sit and notice the space of the room around you, the space that holds the walls and your body. Then sense the space inside the body: the chest, the mouth, the skull. Feel the skin as a thin wall with open space within and without. Let the inner and outer space be one field and rest in that openness. When the mind reaches for something solid, notice the reaching and return to space. Stay alert; thi","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Sit and notice the space of the room around you, the space that holds the walls and your body."},{"@type":"HowToStep","position":2,"text":"Then sense the space inside the body: the chest, the mouth, the skull."},{"@type":"HowToStep","position":3,"text":"Feel the skin as a thin wall with open space within and without."},{"@type":"HowToStep","position":4,"text":"Let the inner and outer space be one field and rest in that openness."},{"@type":"HowToStep","position":5,"text":"When the mind reaches for something solid, notice the reaching and return to space."},{"@type":"HowToStep","position":6,"text":"Stay alert; this is not a blank or sleepy state."}],"isBasedOn":["https://tantra112.app/vijnana-bhairava-tantra"],"about":[{"@id":"https://tantrafiles.xyz/tradition/kashmir-shaivism"}],"warning":"If you feel disoriented, unreal or anxious, open the eyes, feel the feet and the seat, and stop for today. If you have a history of trauma, dissociation, psychosis or severe anxiety, keep sits short with eyes open, or practise with a qualified teacher or clinician. The rest of the Vijñāna Bhairava (breath retention, mantra, the subtle-body and burning practices) is learned from a qualified teacher in the Trika tradition; Satsang lists places to practise.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/vbt-twelve-centres","url":"https://tantrafiles.xyz/practice/vbt-twelve-centres","name":"Touching the end-of-twelve through the day (VBT verse 51)","description":"This is a daily-life practice, not a sit. Several times a day, while walking, waiting or eating, let attention rest for a few breaths at the space just above the crown of the head, the \"end of twelve\", then carry on with what you were doing. Keep the touch light and brief. The remembering is the practice.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"This is a daily-life practice, not a sit."},{"@type":"HowToStep","position":2,"text":"Several times a day, while walking, waiting or eating, let attention rest for a few breaths at the space just above the crown of the head, the \"end of twelve\", then carry on with what you were doing."},{"@type":"HowToStep","position":3,"text":"Keep the touch light and brief."},{"@type":"HowToStep","position":4,"text":"The remembering is the practice."}],"isBasedOn":["https://tantra112.app/vijnana-bhairava-tantra"],"about":[{"@id":"https://tantrafiles.xyz/tradition/kashmir-shaivism"}],"warning":"If attention above the head brings headache, pressure or dizziness, rest it in the heart or the soles of the feet instead. If you feel disoriented, unreal or anxious, open the eyes, feel the feet and the seat, and stop for today. The rest of the Vijñāna Bhairava (breath retention, mantra, the subtle-body and burning practices) is learned from a qualified teacher in the Trika tradition; Satsang lists places to practise. Keep the breath natural and unforced. Stop if you feel dizzy, anxious or unwell.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/vbt-inner-outer-spaces","url":"https://tantrafiles.xyz/practice/vbt-inner-outer-spaces","name":"Merging the sense spaces (VBT verses 32-33)","description":"Sit and bring attention to one sense contact: a sound, a touch, something seen. Notice the outer space where it arrives, the room and the distance. Then notice the inner space where it is received. Rest in both at once, the outer and the inner as one field with the sensation in the middle. When attention falls to one side, come back to both.","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"Sit and bring attention to one sense contact: a sound, a touch, something seen."},{"@type":"HowToStep","position":2,"text":"Notice the outer space where it arrives, the room and the distance."},{"@type":"HowToStep","position":3,"text":"Then notice the inner space where it is received."},{"@type":"HowToStep","position":4,"text":"Rest in both at once, the outer and the inner as one field with the sensation in the middle."},{"@type":"HowToStep","position":5,"text":"When attention falls to one side, come back to both."}],"isBasedOn":["https://tantra112.app/vijnana-bhairava-tantra"],"about":[{"@id":"https://tantrafiles.xyz/tradition/kashmir-shaivism"}],"warning":"If you feel disoriented, unreal or anxious, open the eyes, feel the feet and the seat, and stop for today. The rest of the Vijñāna Bhairava (breath retention, mantra, the subtle-body and burning practices) is learned from a qualified teacher in the Trika tradition; Satsang lists places to practise.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"HowTo","@id":"https://tantrafiles.xyz/practice/recollection-of-past-lives-orientation","url":"https://tantrafiles.xyz/practice/recollection-of-past-lives-orientation","name":"Recollection of former lives (pubbenivāsānussati): orientation, with the Pa-Auk method","description":"In the early discourses this is the first of the three knowledges the Buddha describes on the night of his awakening (MN 4), and Buddhaghosa's Visuddhimagga (chapter XIII) presents it as a by-product of fully mastered concentration. The Pa-Auk method, taught at Pa-Auk Forest Monastery in Myanmar and its branch centres, gives it a place inside insight practice: a meditator first develops deep jhāna","totalTime":"PT10M","step":[{"@type":"HowToStep","position":1,"text":"In the early discourses this is the first of the three knowledges the Buddha describes on the night of his awakening (MN 4), and Buddhaghosa's Visuddhimagga (chapter XIII) presents it as a by-product of fully mastered concentration. The Pa-Auk method, taught at Pa-Auk Forest Monastery in Myanmar and its branch centres, gives it a place inside insight practice: a meditator first develops deep jhāna, usually through mindfulness of breathing, then learns to discern the momentary mind and matter of the present, and only then, in the stage called discerning causes and conditions, turns back through"}],"isBasedOn":["https://www.dhammatalks.org/suttas/MN/MN4.html"],"about":[{"@id":"https://tantrafiles.xyz/tradition/pa-auk"}],"warning":"These claims are central to the Pa-Auk and early Buddhist traditions but are not independently verified. No results are promised, and memories that seem to surface can be imagination; the tradition warns against clinging to them either way. Requires deep jhāna and a qualified teacher, typically on a long residential retreat. Do not try it from a summary or a video, and do not use regression techniques. Stop if it becomes distressing. Not for anyone living with dissociation, psychosis or unresolved trauma: stay with grounding breath practice and speak to a qualified teacher or clinician. Orientation only: this practice is traditionally learned from a qualified teacher in its lineage. Read and listen; do not attempt it from a summary.","license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/rebirth","url":"https://tantrafiles.xyz/topic/rebirth","name":"Rebirth","description":"Does anything carry on after death, and if so, what? The Buddha said a stream of becoming continues without a fixed self. The Upanishads said the Self is untouched while the subtle body moves on. Plato told the Myth of Er. Theosophy and Steiner rebuilt the idea for the modern West. Start anywhere and keep going.","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"rebirth","hasPart":[{"@type":"Question","name":"What is reborn?","text":"If there is no fixed self, what links one life to the next? Consciousness, karma, a subtle body, a soul."},{"@type":"Question","name":"Remembering past lives","text":"The Buddha's first knowledge on the night of awakening, children's memories, and why most of us forget."},{"@type":"Question","name":"Karma and the next life","text":"How intention shapes what comes next, and what it would mean to take that seriously now."},{"@type":"Question","name":"Between lives: the bardo","text":"The Tibetan map of the passage from death to birth, and practices for meeting it awake."},{"@type":"Question","name":"The West: Er, Pythagoras, Steiner","text":"Plato's Myth of Er, the Pythagoreans, Plotinus, Kabbalah's gilgul, Theosophy and Anthroposophy."},{"@type":"Question","name":"Dying and near-death","text":"What the dying, the near-dead and the people who sit with them report."},{"@type":"Question","name":"Ending the round","text":"Liberation as the end of rebirth: nibbana, moksha, the deathless, no coming and no going."}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/rebirth/samsara","url":"https://tantrafiles.xyz/topic/rebirth/samsara","name":"Samsara","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"rebirth/samsara","broader":{"@id":"https://tantrafiles.xyz/topic/rebirth"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/rebirth/western","url":"https://tantrafiles.xyz/topic/rebirth/western","name":"Western reincarnation","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"rebirth/western","broader":{"@id":"https://tantrafiles.xyz/topic/rebirth"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/kamma","url":"https://tantrafiles.xyz/topic/kamma","name":"Karma","description":"Karma is intention, said the Buddha. The Gita says act, and let go of the fruit. The West rebuilt it as moral law and destiny.","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"kamma","hasPart":[{"@type":"Question","name":"Karma as intention","text":"What makes an action skilful."},{"@type":"Question","name":"Karma yoga","text":"Acting without clinging to the result."},{"@type":"Question","name":"Results and destiny","text":"Fate, free will and the ripening of deeds."}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/kamma/karma-yoga","url":"https://tantrafiles.xyz/topic/kamma/karma-yoga","name":"Karma yoga","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"kamma/karma-yoga","broader":{"@id":"https://tantrafiles.xyz/topic/kamma"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/kamma/western","url":"https://tantrafiles.xyz/topic/kamma/western","name":"Karma in Western esotericism","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"kamma/western","broader":{"@id":"https://tantrafiles.xyz/topic/kamma"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/self","url":"https://tantrafiles.xyz/topic/self","name":"Self & not-self","description":"Who am I? The Buddha said: not this, not this, not this. The Upanishads said: that thou art. Ramana said: ask, and find out.","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"self","hasPart":[{"@type":"Question","name":"Not-self","text":"The Buddha's strategy of not identifying."},{"@type":"Question","name":"Self-enquiry: who am I?","text":"Ramana's question, and those who teach it."},{"@type":"Question","name":"The Self (ātman)","text":"Vedānta's witness that was never born."},{"@type":"Question","name":"Ego and identity","text":"How the sense of a separate me is built."}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/self/self-enquiry","url":"https://tantrafiles.xyz/topic/self/self-enquiry","name":"Self-enquiry","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"self/self-enquiry","broader":{"@id":"https://tantrafiles.xyz/topic/self"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/self/emptiness","url":"https://tantrafiles.xyz/topic/self/emptiness","name":"Emptiness","description":"Form is emptiness, emptiness is form. For the Madhyamaka, nothing exists from its own side; for Zen, emptiness is this very moment; for Thich Nhat Hanh, it is interbeing; for Dzogchen, it is the open ground of mind. Here the Buddhist schools, and a few outside them, explain what emptiness is and is not.","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"self/emptiness","broader":{"@id":"https://tantrafiles.xyz/topic/self"},"hasPart":[{"@type":"Question","name":"The Heart Sūtra","text":"The shortest and most chanted text on emptiness."},{"@type":"Question","name":"The middle way: Nāgārjuna","text":"Neither existence nor non-existence."},{"@type":"Question","name":"Interbeing","text":"Thich Nhat Hanh's word for it."},{"@type":"Question","name":"Buddha-nature","text":"Empty, yet luminous: the other side of the teaching."}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/meditation","url":"https://tantrafiles.xyz/topic/meditation","name":"Meditation","description":"Breath, mantra, koan, prayer, open awareness. The same question asked in many ways: how do we come home?","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"meditation","hasPart":[{"@type":"Question","name":"The breath","text":"Mindfulness of breathing in every tradition."},{"@type":"Question","name":"Guided practice","text":"Sit along with a teacher."},{"@type":"Question","name":"Open awareness","text":"Resting as awareness itself."},{"@type":"Question","name":"Goodwill and compassion","text":"Metta, tonglen, the heart practices."},{"@type":"Question","name":"When it's hard","text":"Restlessness, doubt, sleepiness, pain."}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/meditation/breath","url":"https://tantrafiles.xyz/topic/meditation/breath","name":"Breath","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"meditation/breath","broader":{"@id":"https://tantrafiles.xyz/topic/meditation"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/meditation/guided","url":"https://tantrafiles.xyz/topic/meditation/guided","name":"Guided contemplation","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"meditation/guided","broader":{"@id":"https://tantrafiles.xyz/topic/meditation"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/meditation/mantra","url":"https://tantrafiles.xyz/topic/meditation/mantra","name":"Mantra & japa","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"meditation/mantra","broader":{"@id":"https://tantrafiles.xyz/topic/meditation"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/meditation/kriya","url":"https://tantrafiles.xyz/topic/meditation/kriya","name":"Kriya Yoga","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"meditation/kriya","broader":{"@id":"https://tantrafiles.xyz/topic/meditation"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/meditation/koan","url":"https://tantrafiles.xyz/topic/meditation/koan","name":"Koan","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"meditation/koan","broader":{"@id":"https://tantrafiles.xyz/topic/meditation"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/meditation/prayer","url":"https://tantrafiles.xyz/topic/meditation/prayer","name":"Prayer & contemplation","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"meditation/prayer","broader":{"@id":"https://tantrafiles.xyz/topic/meditation"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/meditation/kundalini","url":"https://tantrafiles.xyz/topic/meditation/kundalini","name":"Kundalini & the subtle body","description":"The subtle body: channels, centres and a coiled power at the base of the spine. Haṭha yoga, the tantras of Kashmir and the Goddess, Tibetan yogas and modern teachers describe it differently, and scholars trace where the idea came from. Here are the teachers, the history, and the cautions.","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"meditation/kundalini","broader":{"@id":"https://tantrafiles.xyz/topic/meditation"},"hasPart":[{"@type":"Question","name":"Where kuṇḍalinī comes from","text":"The scholars on the tantras and early haṭha texts."},{"@type":"Question","name":"Śaktipāt: the descent of grace","text":"Awakening given by a teacher."},{"@type":"Question","name":"Chakras and the subtle body","text":"Maps of the inner body."},{"@type":"Question","name":"Haṭha yoga","text":"Posture, breath and the seals."}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/meditation/hatha","url":"https://tantrafiles.xyz/topic/meditation/hatha","name":"Haṭha yoga","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"meditation/hatha","broader":{"@id":"https://tantrafiles.xyz/topic/meditation"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/meditation/dzogchen","url":"https://tantrafiles.xyz/topic/meditation/dzogchen","name":"Dzogchen","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"meditation/dzogchen","broader":{"@id":"https://tantrafiles.xyz/topic/meditation"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/meditation/lojong","url":"https://tantrafiles.xyz/topic/meditation/lojong","name":"Lojong (mind training)","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"meditation/lojong","broader":{"@id":"https://tantrafiles.xyz/topic/meditation"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/meditation/silent-illumination","url":"https: