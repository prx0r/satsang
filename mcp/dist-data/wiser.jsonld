m schools.","geo":{"@type":"GeoCoordinates","latitude":29.92,"longitude":78.05},"address":{"@type":"PostalAddress","addressLocality":"Bahadrabad, Haridwar","addressCountry":"IN"},"sameAs":["https://divyayoga.com"],"email":"divyayoga@divyayoga.com","telephone":"+91-1334-240008"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/shantikunj","url":"https://tantrafiles.xyz/place/shantikunj","name":"Shantikunj (AWGP)","description":"All World Gayatri Pariwar HQ (founded 1971 by Shriram Sharma Acharya); sadhana shivirs, yagyas, Vedic college, 3500+ centres worldwide.","geo":{"@type":"GeoCoordinates","latitude":29.95,"longitude":78.16},"address":{"@type":"PostalAddress","addressLocality":"Haridwar","addressCountry":"IN"},"sameAs":["https://www.awgp.org"],"email":"shantikunj@awgp.org","telephone":"91-1334-260602"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/wat-chom-tong","url":"https://tantrafiles.xyz/place/wat-chom-tong","name":"Wat Phra That Si Chom Thong","description":"Ajahn Tong's royal monastery (abbot 1991–2019); Northern Vipassana international dept; 7–21-day courses, centres in 11+ countries.","geo":{"@type":"GeoCoordinates","latitude":18.42,"longitude":98.68},"address":{"@type":"PostalAddress","addressLocality":"Chom Tong, Chiang Mai","addressCountry":"TH"},"sameAs":["https://www.watchomtong.com/?lang=en"]},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/wat-phu-kong-tong","url":"https://tantrafiles.xyz/place/wat-phu-kong-tong","name":"Wat Phu Kong Tong","description":"Ajahn Martin's forest monastery (Maha Bua line); intensive practice, walk-ins welcome; 3 free books, talks answered in desanas.","geo":{"@type":"GeoCoordinates","latitude":17.17,"longitude":102.44},"address":{"@type":"PostalAddress","addressLocality":"Nongbua Lamphu","addressCountry":"TH"},"sameAs":["https://www.forestdhammatalks.org/"],"email":"th.forest.dhamma@protonmail.com"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/ishwar-ashram-srinagar","url":"https://tantrafiles.xyz/place/ishwar-ashram-srinagar","name":"Ishwar Ashram (Ishber), Srinagar — Ishwar Ashram Trust","description":"Swami Lakshmanjoo’s ashram (built 1962) with the Amriteshwar Bhairava temple","geo":{"@type":"GeoCoordinates","latitude":34.12535,"longitude":74.88153},"address":{"@type":"PostalAddress","addressLocality":"Srinagar (Ishber, Nishat), Jammu & Kashmir","addressCountry":"IN"},"sameAs":["https://www.kashmirshaivainstitute.com/"],"email":"iatsrinagar@gmail.com","telephone":"+91 93116 11344"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/kashmir-shaiva-institute-jammu","url":"https://tantrafiles.xyz/place/kashmir-shaiva-institute-jammu","name":"Kashmir Shaiva Institute (Ishwar Ashram Trust), Jammu","description":"The Trust’s education wing: workshops, seminars and residential programmes on Kashmir Shaiva texts; publications (Lakshmanjoo’s works, the journal Malini).","geo":{"@type":"GeoCoordinates","latitude":32.7273,"longitude":74.8523},"address":{"@type":"PostalAddress","addressLocality":"Jammu","addressCountry":"IN"},"sameAs":["https://www.kashmirshaivainstitute.com/"],"email":"kashmirshaivainstitute@gmail.com","telephone":"0191-2501199"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/ishwar-ashram-trust-delhi","url":"https://tantrafiles.xyz/place/ishwar-ashram-trust-delhi","name":"Ishwar Ashram Trust — Delhi Ashram (Sarita Vihar)","description":"Weekly Sunday puja (Gurustuti and Lakshmanjoo recordings), birthday and Mahasamadhi functions, seminars; library and bookshop","geo":{"@type":"GeoCoordinates","latitude":28.53816,"longitude":77.28856},"address":{"@type":"PostalAddress","addressLocality":"New Delhi","addressCountry":"IN"},"sameAs":["https://www.ishwarashramtrust.com/"],"email":"iatdelhi@gmail.com","telephone":"+91 11-46510874"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/lakshmanjoo-academy","url":"https://tantrafiles.xyz/place/lakshmanjoo-academy","name":"Lakshmanjoo Academy / Universal Shaiva Fellowship (online, Oregon; Kashmir retreats)","description":"Publishes Lakshmanjoo’s recorded teachings; free weekly online sangha (Sat) and puja (Sun); four-week free webinar \"Meditation in Kashmir Shaivism\"; spring and fall online study retreats; an annual in","address":{"@type":"PostalAddress","addressLocality":"Oregon (USA) and online","addressCountry":"US"},"sameAs":["https://www.lakshmanjooacademy.org/"]},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/anuttara-trika-kula-varanasi","url":"https://tantrafiles.xyz/place/anuttara-trika-kula-varanasi","name":"Anuttara Trika Kula — Mark Dyczkowski’s teaching (Varanasi / online)","description":"Archive of Dyczkowski’s lectures and courses (Tantrāloka chapter courses, Spanda, Śiva Sūtras, Vijñānabhairava, Kubjikā); free lectures; online Reading Circles continuing the Tantrāloka (Ch","address":{"@type":"PostalAddress","addressLocality":"Varanasi, Uttar Pradesh (online)","addressCountry":"IN"},"sameAs":["https://www.anuttaratrikakula.org/"],"email":"info@anuttaratrikakula.org"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/samvidalaya-varanasi","url":"https://tantrafiles.xyz/place/samvidalaya-varanasi","name":"Samvidalaya — Abhinavagupta Research Library (Bettina Bäumer), Varanasi and Ishvar Parvat","description":"Research library on Kashmir Śaivism and Tantra","geo":{"@type":"GeoCoordinates","latitude":25.2686,"longitude":83.01658},"address":{"@type":"PostalAddress","addressLocality":"Varanasi (Samne Ghat) / Phulchatti, Pauri Garhwal","addressCountry":"IN"},"sameAs":["https://www.utpaladeva.in/"],"email":"baeumer.bettina@gmail.com"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/muktabodha-indological-research-institute","url":"https://tantrafiles.xyz/place/muktabodha-indological-research-institute","name":"Muktabodha Indological Research Institute (New Delhi office; Varanasi digitisation)","description":"Free digital library: 3,000+ digitised manuscripts and 570+ searchable Sanskrit e-texts (Kashmir Śaiva, Śaiva Siddhānta, IFP paper transcripts, Gokarna Vedic manuscripts); translation series; joint pr","geo":{"@type":"GeoCoordinates","latitude":28.61389,"longitude":77.20901},"address":{"@type":"PostalAddress","addressLocality":"New Delhi","addressCountry":"IN"},"sameAs":["https://muktabodha.org/"],"email":"info@muktabodha.org"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/gorakhnath-math-gorakhpur","url":"https://tantrafiles.xyz/place/gorakhnath-math-gorakhpur","name":"Shri Gorakhnath Mandir (Gorakhnath Math), Gorakhpur","description":"Chief seat of the Nāth order: daily aarti (3–4 am, 11 am, 6–8 pm), samādhi shrines of Brahmanath, Gambhirnath, Digvijaynath and Avedyanath, akhand dhuni and bhandara; the temple publishes Gorakhnath l","geo":{"@type":"GeoCoordinates","latitude":26.77415,"longitude":83.35774},"address":{"@type":"PostalAddress","addressLocality":"Gorakhpur, Uttar Pradesh","addressCountry":"IN"},"sameAs":["https://www.gorakhnathmandir.in/"],"telephone":"0551-2255453"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/devipatan-shaktipeeth-tulsipur","url":"https://tantrafiles.xyz/place/devipatan-shaktipeeth-tulsipur","name":"Devi Patan Shaktipeeth (Nāth temple), Tulsipur","description":"Ancient Śakti-pīṭha administered by the Nāth order; guru of Guru Yogi Matsyendranath (nathas.org)","geo":{"@type":"GeoCoordinates","latitude":27.53672,"longitude":82.39529},"address":{"@type":"PostalAddress","addressLocality":"Tulsipur, Balrampur district, Uttar Pradesh","addressCountry":"IN"},"sameAs":[]},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/arsha-vidya-pitham-rishikesh","url":"https://tantrafiles.xyz/place/arsha-vidya-pitham-rishikesh","name":"Swami Dayananda Ashram — Arsha Vidya Pitham, Rishikesh","description":"Traditional Vedānta and Sanskrit: 3-year long-term residential course, 3-month short course, 6-month courses (Vidya Varshini; Hindi), Dayananda Memorial Retreats; Dakshinamurti shrine and Ganga ghat.","geo":{"@type":"GeoCoordinates","latitude":30.11983,"longitude":78.30629},"address":{"@type":"PostalAddress","addressLocality":"Swami Dayananda Nagar, Muni Ki Reti, Rishikesh","addressCountry":"IN"},"sameAs":["https://www.dayananda.org/"],"email":"sakshat1949@gmail.com","telephone":"0135-2430769"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/arsha-vijnana-gurukulam-nagpur","url":"https://tantrafiles.xyz/place/arsha-vijnana-gurukulam-nagpur","name":"Dr. Shrikant Jichkar Memorial Arsha Vijnana Gurukulam, Vedapuri (Nagpur)","description":"Indian philosophy, Vedānta, Sanskrit and yoga in a forest campus; past 3- and 6-month residential Vedānta/Sanskrit courses; Dakshinamurti temple (renovation appeal).","geo":{"@type":"GeoCoordinates","latitude":21.13876,"longitude":78.77115},"address":{"@type":"PostalAddress","addressLocality":"Vedapuri, Bazargaon, Nagpur district, Maharashtra","addressCountry":"IN"},"sameAs":["https://avgnagpur.org/"],"email":"brahmapra@gmail.com","telephone":"+91 98902 93641"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/krishnamacharya-yoga-mandiram","url":"https://tantrafiles.xyz/place/krishnamacharya-yoga-mandiram","name":"Krishnamacharya Yoga Mandiram (KYM), Chennai","description":"Yoga therapy, teacher training, Vedic chanting (Healing Chants TTC 2026–27 with SKWC Bengaluru), Yoga Sūtra immersion with Vyāsa-bhāṣya and Yogavallī, Heart of Yoga intensive, online practice sessions","geo":{"@type":"GeoCoordinates","latitude":13.02584,"longitude":80.26279},"address":{"@type":"PostalAddress","addressLocality":"Mandaveli, Chennai, Tamil Nadu","addressCountry":"IN"},"sameAs":["https://www.kym.org/"],"email":"mails@kym.org","telephone":"+91 96000 98829"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/devipuram","url":"https://tantrafiles.xyz/place/devipuram","name":"Devipuram (Sri Vidya Trust), near Visakhapatnam","description":"Śrī Vidyā courses online and residential (mandatory Starter Regime and assessment before the Beginner’s course), Sri Meru Nilayam temple, festivals.","geo":{"@type":"GeoCoordinates","latitude":17.76299,"longitude":83.09048},"address":{"@type":"PostalAddress","addressLocality":"Devipuram, Anakapalli district, Andhra Pradesh","addressCountry":"IN"},"sameAs":["https://devipuram.org/"],"email":"info@devipuram.org","telephone":"+91 9440845333"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/kamakhya-temple","url":"https://tantrafiles.xyz/place/kamakhya-temple","name":"Maa Kamakhya Devalaya, Nilachal Hill, Guwahati","description":"Foremost Tantric Śākta pīṭha (Kālikā Purāṇa, Yoni-pīṭha); Daśamahāvidyā shrines; no formal courses (practitioners study with local lineages privately).","geo":{"@type":"GeoCoordinates","latitude":26.16511,"longitude":91.70593},"address":{"@type":"PostalAddress","addressLocality":"Guwahati, Assam","addressCountry":"IN"},"sameAs":["https://maakamakhya.org/"]},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/bhu-svdv","url":"https://tantrafiles.xyz/place/bhu-svdv","name":"Banaras Hindu University — Faculty of Sanskrit Vidya Dharma Vijnan (SVDV)","description":"Traditional Śāstra and Veda departments (Vedānta, Dharmaśāstra, Jyotiṣa, Vyākaraṇa, Sāhitya, Āgama-Tantra); also the Dept of Philosophy and Religion (Arts) which hosted Dyczkowski lectures.","geo":{"@type":"GeoCoordinates","latitude":25.26638,"longitude":82.99047},"address":{"@type":"PostalAddress","addressLocality":"Varanasi, Uttar Pradesh","addressCountry":"IN"},"sameAs":["https://www.bhu.ac.in/"]},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/ifp-pondicherry","url":"https://tantrafiles.xyz/place/ifp-pondicherry","name":"French Institute of Pondicherry (IFP) — Indology Department & Śaiva manuscripts","description":"UNESCO Memory of the World “Śaiva manuscripts of Pondicherry” (≈8,187 palm-leaf bundles + transcripts), digitised online; critical editions (Collection Indologie with EFEO); library of 75,000 books; W","geo":{"@type":"GeoCoordinates","latitude":11.9289,"longitude":79.83135},"address":{"@type":"PostalAddress","addressLocality":"Puducherry","addressCountry":"IN"},"sameAs":["https://www.ifpindia.org/research/indology/"],"email":"library@ifpindia.org"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/efeo-pondicherry","url":"https://tantrafiles.xyz/place/efeo-pondicherry","name":"École française d’Extrême-Orient — Pondicherry Centre","description":"Indological library (11,000+ titles) and 1,662 palm-leaf bundles; Early Tantra and Śaiva Siddhānta editions (Niśvāsatattvasaṃhitā, Kāraṇāgama); Sanskrit/Tamil reading workshops for researchers.","geo":{"@type":"GeoCoordinates","latitude":11.9289,"longitude":79.83135},"address":{"@type":"PostalAddress","addressLocality":"Puducherry","addressCountry":"IN"},"sameAs":["https://www.efeo.fr/"],"email":"library@efeo-pondicherry.org"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/maharaja-sanskrit-college-mysore","url":"https://tantrafiles.xyz/place/maharaja-sanskrit-college-mysore","name":"Maharaja’s Sanskrit College (Srimanmaharaja Samskrita PG Centre), Mysuru","description":"Traditional Veda, Āgama and Śāstra courses (2 to 13 years); historic manuscript collection.","geo":{"@type":"GeoCoordinates","latitude":12.30518,"longitude":76.65536},"address":{"@type":"PostalAddress","addressLocality":"Mysuru, Karnataka","addressCountry":"IN"},"sameAs":[]},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/ltwa-dharamsala","url":"https://tantrafiles.xyz/place/ltwa-dharamsala","name":"Library of Tibetan Works and Archives (LTWA), Dharamsala","description":"Daily Buddhist philosophy classes by geshes with English translation (Mar–Dec), Tibetan language, one-year special philosophy course, six-year diploma, Intensive Translation Programme (Jul–Sep).","address":{"@type":"PostalAddress","addressLocality":"Gangchen Kyishong, Dharamsala, Himachal Pradesh","addressCountry":"IN"},"sameAs":["https://tibetanlibrary.org/"],"email":"office@tibetanlibrary.org","telephone":"01892-297513"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/cihts-sarnath","url":"https://tantrafiles.xyz/place/cihts-sarnath","name":"Central Institute of Higher Tibetan Studies (deemed university), Sarnath","description":"Shastri/Acharya/PhD in Buddhist philosophy, Tibetan language and literature, Sowa Rigpa, Bhot Jyotish, fine arts; SWAYAM MOOCs","geo":{"@type":"GeoCoordinates","latitude":25.37763,"longitude":83.0276},"address":{"@type":"PostalAddress","addressLocality":"Sarnath, Varanasi","addressCountry":"IN"},"sameAs":["https://cihts.ac.in/"],"email":"vcoffice@cihts.ac.in","telephone":"+91 542 2585242"},{"@type":"Place","@id":"https://tantrafiles.xyz/place/root-institute-bodhgaya","url":"https://tantrafiles.xyz/place/root-institute-bodhgaya","name":"Root Institute for Wisdom Culture (FPMT), Bodh Gaya","description":"Seasonal programme (Oct–Feb): introductory meditation and Buddhism courses, Lamrim, Nāgārjuna, retreats; some sessions streamed on YouTube.","geo":{"@type":"GeoCoordinates","latitude":24.69383,"longitude":84.97631},"address":{"@type":"PostalAddress","addressLocality":"Bodh Gaya, Bihar","addressCountry":"IN"},"sameAs":["https://www.rootinstitute.ngo/"],"telephone":"+91 9931 518 858 (SMS/WhatsApp preferred)"},{"@type":"Place","@id":"https://tantrafiles.xyz/place/dhamma-giri-igatpuri","url":"https://tantrafiles.xyz/place/dhamma-giri-igatpuri","name":"Dhamma Giri — Vipassana International Academy, Igatpuri","description":"One of the largest Vipassana centres: 10-day, teenager, short and long courses; Vipassana Research Institute (Pāli texts).","geo":{"@type":"GeoCoordinates","latitude":19.70246,"longitude":73.55396},"address":{"@type":"PostalAddress","addressLocality":"Igatpuri, Nashik district, Maharashtra","addressCountry":"IN"},"sameAs":["https://www.dhamma.org/en/schedules/schgiri"],"telephone":"(02553) 244076"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/rangjung-yeshe-institute","url":"https://tantrafiles.xyz/place/rangjung-yeshe-institute","name":"Rangjung Yeshe Institute — Kathmandu University Centre for Buddhist Studies, Boudha","description":"BA/MA/PhD in Buddhist Studies; Classical Tibetan, Sanskrit, Nepali and Chinese (on campus and online); 8-week summer intensives; translator training.","geo":{"@type":"GeoCoordinates","latitude":27.72441,"longitude":85.36319},"address":{"@type":"PostalAddress","addressLocality":"Boudha, Kathmandu","addressCountry":"NP"},"sameAs":["https://ryi.org/"]}]}