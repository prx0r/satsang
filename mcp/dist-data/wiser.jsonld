@id":"https://tantrafiles.xyz/clip/ivCzQx7DQJs"}},{"@type":"ListItem","position":7,"item":{"@id":"https://tantrafiles.xyz/practice/koan-practice-with-mu"}}]},"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"CreativeWorkSeries","@id":"https://tantrafiles.xyz/collection/middle-pillar-week","url":"https://tantrafiles.xyz/collection/middle-pillar-week","name":"Middle Pillar week","description":"One outline, seven sittings. Each day adds one centre to the pillar, then rests in the circulation. Ten minutes a day. This is orientation only: the full form is learnt in the order or from a qualified teacher.","hasPart":{"@type":"ItemList","itemListOrder":"https://schema.org/ItemListOrderAscending","itemListElement":[{"@type":"ListItem","position":1,"item":{"@id":"https://tantrafiles.xyz/practice/middle-pillar-outline"}},{"@type":"ListItem","position":2,"item":{"@id":"https://tantrafiles.xyz/collection/middle-pillar-week"}},{"@type":"ListItem","position":3,"item":{"@id":"https://tantrafiles.xyz/practice/middle-pillar-outline"}},{"@type":"ListItem","position":4,"item":{"@id":"https://tantrafiles.xyz/collection/middle-pillar-week"}},{"@type":"ListItem","position":5,"item":{"@id":"https://tantrafiles.xyz/practice/middle-pillar-outline"}},{"@type":"ListItem","position":6,"item":{"@id":"https://tantrafiles.xyz/collection/middle-pillar-week"}},{"@type":"ListItem","position":7,"item":{"@id":"https://tantrafiles.xyz/practice/middle-pillar-outline"}},{"@type":"ListItem","position":8,"item":{"@id":"https://tantrafiles.xyz/collection/middle-pillar-week"}},{"@type":"ListItem","position":9,"item":{"@id":"https://tantrafiles.xyz/practice/middle-pillar-outline"}},{"@type":"ListItem","position":10,"item":{"@id":"https://tantrafiles.xyz/collection/middle-pillar-week"}},{"@type":"ListItem","position":11,"item":{"@id":"https://tantrafiles.xyz/practice/middle-pillar-outline"}},{"@type":"ListItem","position":12,"item":{"@id":"https://tantrafiles.xyz/collection/middle-pillar-week"}},{"@type":"ListItem","position":13,"item":{"@id":"https://tantrafiles.xyz/practice/middle-pillar-outline"}},{"@type":"ListItem","position":14,"item":{"@id":"https://tantrafiles.xyz/collection/middle-pillar-week"}}]},"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"Course","@id":"https://tantrafiles.xyz/collection/trika-prep-week","url":"https://tantrafiles.xyz/collection/trika-prep-week","name":"Trika prep week","description":"Seven days of foundation for Abhinavagupta and VBT study: steady breath, the turn of the breath, and recognition. Ten minutes a day. Initiated practices are not here: when the gap is steady, take the next step with a qualified teacher in the tradition.","provider":{"@type":"Organization","name":"Satsang","url":"https://tantrafiles.xyz"},"hasCourseInstance":{"@type":"CourseInstance","courseMode":"online","courseSchedule":{"@type":"Schedule","repeatFrequency":"P1D","repeatCount":7}},"syllabusSections":[{"@type":"Syllabus","name":"Settle","description":"The home base: ease through the body with the breath."},{"@type":"Syllabus","name":"The turn","description":"Notice where the in-breath becomes the out-breath. Rest there; hold nothing."},{"@type":"Syllabus","name":"Recognition","description":"One sutra slowly, then look: does anything appear outside awareness?"},{"@type":"Syllabus","name":"Return to ease","description":"Same foundation, deeper seat. The gap work needs a rested body."},{"@type":"Syllabus","name":"Longer turn","description":"Same gap practice, full sit. Let attention fall in; never force it."},{"@type":"Syllabus","name":"Recognition again","description":"Same contemplation, fresh experience. Sound, thought, feeling — inside or outside?"},{"@type":"Syllabus","name":"The week in one sit","description":"Ease, then the turn, then recognition — one short sit chaining all three in order."}],"hasPart":{"@type":"ItemList","itemListOrder":"https://schema.org/ItemListOrderAscending","itemListElement":[{"@type":"ListItem","position":1,"item":{"@id":"https://tantrafiles.xyz/practice/ease-through-the-body-trika-prep"}},{"@type":"ListItem","position":2,"item":{"@id":"https://tantrafiles.xyz/collection/trika-prep-week"}},{"@type":"ListItem","position":3,"item":{"@id":"https://tantrafiles.xyz/practice/resting-in-the-gap-between-breaths-vijnana-bhairava-dharana"}},{"@type":"ListItem","position":4,"item":{"@id":"https://tantrafiles.xyz/collection/trika-prep-week"}},{"@type":"ListItem","position":5,"item":{"@id":"https://tantrafiles.xyz/practice/recognition-pratyabhijna-contemplation"}},{"@type":"ListItem","position":6,"item":{"@id":"https://tantrafiles.xyz/collection/trika-prep-week"}},{"@type":"ListItem","position":7,"item":{"@id":"https://tantrafiles.xyz/practice/ease-through-the-body-trika-prep"}},{"@type":"ListItem","position":8,"item":{"@id":"https://tantrafiles.xyz/collection/trika-prep-week"}},{"@type":"ListItem","position":9,"item":{"@id":"https://tantrafiles.xyz/practice/resting-in-the-gap-between-breaths-vijnana-bhairava-dharana"}},{"@type":"ListItem","position":10,"item":{"@id":"https://tantrafiles.xyz/collection/trika-prep-week"}},{"@type":"ListItem","position":11,"item":{"@id":"https://tantrafiles.xyz/practice/recognition-pratyabhijna-contemplation"}},{"@type":"ListItem","position":12,"item":{"@id":"https://tantrafiles.xyz/collection/trika-prep-week"}},{"@type":"ListItem","position":13,"item":{"@id":"https://tantrafiles.xyz/practice/ease-through-the-body-trika-prep"}},{"@type":"ListItem","position":14,"item":{"@id":"https://tantrafiles.xyz/collection/trika-prep-week"}}]},"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"CreativeWorkSeries","@id":"https://tantrafiles.xyz/collection/vbt-foundations","url":"https://tantrafiles.xyz/collection/vbt-foundations","name":"VBT Foundations","description":"Seven contemplative practices from the Vijñāna Bhairava Tantra, in a progression from the breath to daily life (not the text's own order): the turn of the breath, the gap between objects, inner sound, the body as awareness, the sense spaces, spaciousness, and the end-of-twelve through the day. Each is a quiet sit you can do on your own. The rest of the text (breath retention, mantra, the subtle-body practices) is learned from a qualified teacher: when one of these becomes your door, take it to a teacher in the tradition.","hasPart":{"@type":"ItemList","itemListOrder":"https://schema.org/ItemListOrderAscending","itemListElement":[{"@type":"ListItem","position":1,"item":{"@id":"https://tantrafiles.xyz/practice/resting-in-the-gap-between-breaths-vijnana-bhairava-dharana"}},{"@type":"ListItem","position":2,"item":{"@id":"https://tantrafiles.xyz/collection/vbt-foundations"}},{"@type":"ListItem","position":3,"item":{"@id":"https://tantrafiles.xyz/practice/vbt-mind-between-objects"}},{"@type":"ListItem","position":4,"item":{"@id":"https://tantrafiles.xyz/collection/vbt-foundations"}},{"@type":"ListItem","position":5,"item":{"@id":"https://tantrafiles.xyz/practice/vbt-sound-dissolution"}},{"@type":"ListItem","position":6,"item":{"@id":"https://tantrafiles.xyz/collection/vbt-foundations"}},{"@type":"ListItem","position":7,"item":{"@id":"https://tantrafiles.xyz/practice/vbt-body-as-consciousness"}},{"@type":"ListItem","position":8,"item":{"@id":"https://tantrafiles.xyz/collection/vbt-foundations"}},{"@type":"ListItem","position":9,"item":{"@id":"https://tantrafiles.xyz/practice/vbt-inner-outer-spaces"}},{"@type":"ListItem","position":10,"item":{"@id":"https://tantrafiles.xyz/collection/vbt-foundations"}},{"@type":"ListItem","position":11,"item":{"@id":"https://tantrafiles.xyz/practice/vbt-space-contemplation"}},{"@type":"ListItem","position":12,"item":{"@id":"https://tantrafiles.xyz/collection/vbt-foundations"}},{"@type":"ListItem","position":13,"item":{"@id":"https://tantrafiles.xyz/practice/vbt-twelve-centres"}},{"@type":"ListItem","position":14,"item":{"@id":"https://tantrafiles.xyz/collection/vbt-foundations"}}]},"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/wat-pah-pong","url":"https://tantrafiles.xyz/place/wat-pah-pong","name":"Wat Nong Pa Phong","description":"Ajahn Chah's home monastery and the root of his international branch network.","geo":{"@type":"GeoCoordinates","latitude":15.15906,"longitude":104.82794},"address":{"@type":"PostalAddress","addressLocality":"Warin Chamrap, Ubon Ratchathani","addressCountry":"TH"},"sameAs":["https://www.watnongpahpong.org","https://www.wikidata.org/wiki/Q2552319"]},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/wat-pah-nanachat","url":"https://tantrafiles.xyz/place/wat-pah-nanachat","name":"Wat Pah Nanachat","description":"International forest monastery set up by Ajahn Chah for Western and non-Thai monks, with English as the working language.","geo":{"@type":"GeoCoordinates","latitude":15.16528,"longitude":104.77625},"address":{"@type":"PostalAddress","addressLocality":"Ubon Ratchathani","addressCountry":"TH"},"sameAs":["https://www.watpahnanachat.org","https://www.wikidata.org/wiki/Q2552315"],"email":"watpahnanachat20@gmail.com"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/amaravati","url":"https://tantrafiles.xyz/place/amaravati","name":"Amaravati Buddhist Monastery","description":"Large Ajahn Chah lineage monastery in the Chiltern hills, with a retreat centre and both monks' and nuns' communities.","geo":{"@type":"GeoCoordinates","latitude":51.7917,"longitude":-0.52083},"address":{"@type":"PostalAddress","addressLocality":"Great Gaddesden, Hertfordshire","addressCountry":"GB"},"sameAs":["https://amaravati.org","https://www.wikidata.org/wiki/Q454953"]},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/cittaviveka","url":"https://tantrafiles.xyz/place/cittaviveka","name":"Chithurst Buddhist Monastery","description":"The first Ajahn Chah monastery in the West, in a Sussex woodland, home to monks and nuns.","geo":{"@type":"GeoCoordinat