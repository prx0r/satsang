rship","@id":"https://tantrafiles.xyz/place/haeinsa","url":"https://tantrafiles.xyz/place/haeinsa","name":"Haeinsa","description":"Jogye head temple; Tripitaka Koreana (80,000 blocks) in 15th-c depositories; UNESCO listed.","geo":{"@type":"GeoCoordinates","latitude":35.8,"longitude":128.1},"address":{"@type":"PostalAddress","addressLocality":"Hapcheon, Gyeongsangnam","addressCountry":"KR"},"sameAs":[]},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/fgs-kaohsiung","url":"https://tantrafiles.xyz/place/fgs-kaohsiung","name":"Fo Guang Shan Monastery","description":"Fo Guang Shan headquarters (Hsing Yun, 1967); Humanistic Buddhism; 200+ branch temples incl. Nan Tien.","geo":{"@type":"GeoCoordinates","latitude":22.75,"longitude":120.45},"address":{"@type":"PostalAddress","addressLocality":"Dashu, Kaohsiung","addressCountry":"TW"},"sameAs":["https://www.fgs.org.tw"]},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/nan-tien","url":"https://tantrafiles.xyz/place/nan-tien","name":"Nan Tien Temple","description":"Southern-hemisphere flagship Fo Guang Shan temple (opened 1995); tours, vegetarian meals, pilgrim lodge.","geo":{"@type":"GeoCoordinates","latitude":-34.47,"longitude":150.85},"address":{"@type":"PostalAddress","addressLocality":"Berkeley (Wollongong), NSW","addressCountry":"AU"},"sameAs":["https://www.nantien.org.au/en/visit-us"],"email":"info@nantien.org.au","telephone":"+61 (2) 4272 0600"},{"@type":"PlaceOfWorship","@id":"https://tantrafiles.xyz/place/konya-museum","url":"https://tantrafiles.xyz/place/konya-museum","name":"Mevlana Museum (Konya)","description":"Rumi's tomb-shrine (1274 Green Dome); museum since 1926; sema hall, dervish cells. State museum, not an active lodge.","geo":{"@type":"GeoCoordinates","latitude":37.87,"longitude":32.5},"address":{"@type":"PostalAddress","addressLocality":"Konya","addressCountry":"TR"},"sameAs":["https://muze.gov.tr/muze-detay?distId=MEV&sectionId=MEV01"],"email":"mevlanamüzesi@konyakultur.gov.