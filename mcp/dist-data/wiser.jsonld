ps://tantrafiles.xyz/topic/craving/sensuality","name":"Sensuality","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"craving/sensuality","broader":{"@id":"https://tantrafiles.xyz/topic/craving"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/mindfulness","url":"https://tantrafiles.xyz/topic/mindfulness","name":"Mindfulness","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"mindfulness","hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/virtue","url":"https://tantrafiles.xyz/topic/virtue","name":"Virtue","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"virtue","hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/renunciation","url":"https://tantrafiles.xyz/topic/renunciation","name":"Renunciation","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"renunciation","hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/death","url":"https://tantrafiles.xyz/topic/death","name":"Death","description":"Every tradition starts here. Remember death, the Buddha said, with every breath. The Stoics and Socrates practised it. The Tibetans mapped it. Ramana enacted it at sixteen.","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"death","hasPart":[{"@type":"Question","name":"Remembering death","text":"Maranasati and memento mori as daily practice."},{"@type":"Question","name":"Fear of dying","text":"Where the fear comes from, and what loosens it."},{"@type":"Question","name":"Grief and loss","text":"Losing the people we love."},{"@type":"Question","name":"The moment of dying","text":"What happens as we die, and how to meet it."},{"@type":"Question","name":"The deathless","text":"What was never born and cannot die."}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/death/bardo","url":"https://tantrafiles.xyz/topic/death/bardo","name":"Bardo","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"death/bardo","broader":{"@id":"https://tantrafiles.xyz/topic/death"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/emotions","url":"https://tantrafiles.xyz/topic/emotions","name":"Emotions","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"emotions","hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/emotions/anger","url":"https://tantrafiles.xyz/topic/emotions/anger","name":"Anger","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"emotions/anger","broader":{"@id":"https://tantrafiles.xyz/topic/emotions"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/emotions/fear","url":"https://tantrafiles.xyz/topic/emotions/fear","name":"Fear & anxiety","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"emotions/fear","broader":{"@id":"https://tantrafiles.xyz/topic/emotions"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/emotions/sadness","url":"https://tantrafiles.xyz/topic/emotions/sadness","name":"Sadness","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"emotions/sadness","broader":{"@id":"https://tantrafiles.xyz/topic/emotions"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://