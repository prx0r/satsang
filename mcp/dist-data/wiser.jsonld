type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/javad-nurbakhsh"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/hazrat-inayat-khan","url":"https://tantrafiles.xyz/person/hazrat-inayat-khan","name":"Hazrat Inayat Khan","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/inayati"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/vilayat-inayat-khan"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/vilayat-inayat-khan","url":"https://tantrafiles.xyz/person/vilayat-inayat-khan","name":"Vilayat Inayat Khan","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/inayati"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/pir-zia-inayat-khan"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/james-hillman","url":"https://tantrafiles.xyz/person/james-hillman","name":"James Hillman","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/jungian"}],"knows":[{"@type":"Role","roleName":"influenced","knows":{"@id":"https://tantrafiles.xyz/person/tom-cheetham"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/carl-jung","url":"https://tantrafiles.xyz/person/carl-jung","name":"Carl Jung","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/jungian"}],"knows":[{"@type":"Role","roleName":"influenced","knows":{"@id":"https://tantrafiles.xyz/person/james-hillman"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/pierre-hadot","url":"https://tantrafiles.xyz/person/pierre-hadot","name":"Pierre Hadot","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/platonic"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/antoine-faivre","url":"https://tantrafiles.xyz/person/antoine-faivre","name":"Antoine Faivre","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/western-esotericism-scholarship"}],"knows":[{"@type":"Role","roleName":"influenced","knows":{"@id":"https://tantrafiles.xyz/person/wouter-hanegraaff"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/egil-asprem","url":"https://tantrafiles.xyz/person/egil-asprem","name":"Egil Asprem","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/western-esotericism-scholarship"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/marco-pasi","url":"https://tantrafiles.xyz/person/marco-pasi","name":"Marco Pasi","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/western-esotericism-scholarship"}],"knows":[{"@type":"Role","roleName":"academic_supervisor_of","knows":{"@id":"https://tantrafiles.xyz/person/egil-asprem"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/linden-west","url":"https://tantrafiles.xyz/person/linden-west","name":"Linden West","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/imaginal"}],"knows":[{"@type":"Role","roleName":"academic_supervisor_of","knows":{"@id":"https://tantrafiles.xyz/person/louise-livingstone"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/thomas-taylor","url":"https://tantrafiles.xyz/person/thomas-taylor","name":"Thomas Taylor","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/neoplatonism"}],"knows":[{"@type":"Role","roleName":"translated","knows":{"@id":"https://tantrafiles.xyz/person/iamblichus"}},{"@type":"Role","roleName":"translated","knows":{"@id":"https://tantrafiles.xyz/person/proclus"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/iamblichus","url":"https://tantrafiles.xyz/person/iamblichus","name":"Iamblichus","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/theurgy"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/porphyry","url":"https://tantrafiles.xyz/person/porphyry","name":"Porphyry","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/neoplatonism"}],"knows":[{"@type":"Role","roleName":"studied_with","knows":{"@id":"https://tantrafiles.xyz/person/iamblichus"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/syrianus","url":"https://tantrafiles.xyz/person/syrianus","name":"Syrianus","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/neoplatonism"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/proclus"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/francis-of-assisi","url":"https://tantrafiles.xyz/person/francis-of-assisi","name":"Francis of Assisi","alternateName":"Francis of Assisi","description":"Troubadour turned friar of Assisi; married Lady Poverty and preached to birds, sultans and lepers alike.","birthDate":"1181","deathDate":"1226","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/franciscan-contemplative"}],"knows":[{"@type":"Role","roleName":"studied_with","knows":{"@id":"https://tantrafiles.xyz/person/clare-of-assisi"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/clare-of-assisi","url":"https://tantrafiles.xyz/person/clare-of-assisi","name":"Clare of Assisi","alternateName":"Clare of Assisi","description":"First follower of Francis and founder of the Poor Clares; kept the privilege of poverty against popes and cardinals.","birthDate":"1194","deathDate":"1253","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/franciscan-contemplative"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/bonaventure","url":"https://tantrafiles.xyz/person/bonaventure","name":"Bonaventure","alternateName":"Bonaventure","description":"Franciscan minister general who joined Aristotle to the mystical ascent: the soul's journey into God in six illuminations.","birthDate":"1221","deathDate":"1274","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/franciscan-contemplative"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/isaac-luria","url":"https://tantrafiles.xyz/person/isaac-luria","name":"Isaac Luria","alternateName":"Isaac Luria (the Ari)","description":"Mystic of Safed whose two years of teaching (1569–1572) remade Kabbalah around tzimtzum, shevirat ha-kelim and tikkun.","birthDate":"1534","deathDate":"1572","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/lurianic"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/hayyim-vital"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/hayyim-vital","url":"https://tantrafiles.xyz/person/hayyim-vital","name":"Hayyim Vital","alternateName":"Hayyim Vital","description":"Foremost disciple of Luria, whose notebooks (Etz Chaim) preserve nearly all we have of the master's teaching.","birthDate":"1542","deathDate":"1620","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/lurianic"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/moinuddin-chishti","url":"https://tantrafiles.xyz/person/moinuddin-chishti","name":"Muinuddin Chishti","alternateName":"Muinuddin Chishti","description":"Founder of the Chishti order in India, settled in Ajmer; remembered for service to the poor and love without distinction.","birthDate":"1143","deathDate":"1236","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/chishti"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/nizamuddin-auliya","url":"https://tantrafiles.xyz/person/nizamuddin-auliya","name":"Nizamuddin Auliya","alternateName":"Nizamuddin","description":"Chishti master of Delhi whose assemblies joined princes and paupers; Amir Khusrau was his foremost disciple.","birthDate":"1238","deathDate":"1325","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/chishti"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/amir-khusrau"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/amir-khusrau","url":"https://tantrafiles.xyz/person/amir-khusrau","name":"Amir Khusrau","alternateName":"Amir Khusrau","description":"Poet, musician and disciple of Nizamuddin; credited with shaping qawwali and Hindavi poetry at the Chishti court of Delhi.","birthDate":"1253","deathDate":"1325","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/chishti"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/abdul-qadir-gilani","url":"https://tantrafiles.xyz/person/abdul-qadir-gilani","name":"Abdul Qadir Gilani","alternateName":"Abdul Qadir Gilani","description":"Hanbali preacher and mystic of Baghdad whose teaching founded the Qadiri order, the first widespread Sufi order.","birthDate":"1077","deathDate":"1166","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/qadiri"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/cornelius-agrippa","url":"https://tantrafiles.xyz/person/cornelius-agrippa","name":"Heinrich Cornelius Agrippa","alternateName":"Agrippa","description":"Author of the Three Books of Occult Philosophy, the Renaissance summa joining natural, celestial and ceremonial magic.","birthDate":"1486","deathDate":"1535","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/learned-magic"}],"knows":[{"@type":"Role","roleName":"influenced","knows":{"@id":"https://tantrafiles.xyz/person/john-dee"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/john-dee","url":"https://tantrafiles.xyz/person/john-dee","name":"John Dee","alternateName":"John Dee","description":"Mathematician, astrologer and angel-conversationalist to Elizabeth I; his Enochian workings with Edward Kelley defined English learned magic.","birthDate":"1527","deathDate":"1609","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/learned-magic"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/giordano-bruno","url":"https://tantrafiles.xyz/person/giordano-bruno","name":"Giordano Bruno","alternateName":"Giordano Bruno","description":"Dominican turned Hermetic philosopher, burned in Rome in 1600; read the infinite universe as the unfolding of the divine mind.","birthDate":"1548","deathDate":"1600","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/learned-magic"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/sayalay-dipankara","url":"https://tantrafiles.xyz/person/sayalay-dipankara","name":"Sayalay Dipankara","alternateName":"Sayalay Dipankara","description":"Pa-Auk-trained Burmese nun (b. 1964); teaches the 40 kammatthana and vipassana worldwide; founder/abbess of the Brahma Vihari centres.","birthDate":"1964","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/pa-auk"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/ariyananda","url":"https://tantrafiles.xyz/person/ariyananda","name":"Ven. Ariyananda","alternateName":"Ven. Ariyananda","description":"Senior meditation teacher of Na Uyana Monastery; gives the weekly English Dhamma talks and retreat interviews in the Pa-Auk system.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/pa-auk"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/dhammajiva","url":"https://tantrafiles.xyz/person/dhammajiva","name":"Uda Eriyagama Dhammajiva","alternateName":"Ven. Dhammajiva","description":"Abbot and chief preceptor of Meetirigala Nissarana Vanaya; scholar-practitioner of samatha and vipassana, author of 40+ publications.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/theravada"}],"hasOccupation":{"@type":"Occupation","name":"Scholar"}},{"@type":"Person","@id":"https://tantrafiles.xyz/person/aggacitta","url":"https://tantrafiles.xyz/person/aggacitta","name":"Ven. Aggacitta","alternateName":"Ven. Aggacitta","description":"Malaysian monk; founder and guiding teacher of Sasanarakkha Buddhist Sanctuary (Taiping), answering the shortage of trained local monks.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/theravada"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/thubten-chodron","url":"https://tantrafiles.xyz/person/thubten-chodron","name":"Bhikshuni Thubten Chodron","alternateName":"Thubten Chodron","description":"American-born Tibetan Buddhist nun (bhikshuni); founder and abbess of Sravasti Abbey; author and imprison-chaplaincy pioneer.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/tibetan"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/amma","url":"https://tantrafiles.xyz/person/amma","name":"Mata Amritanandamayi (Amma)","alternateName":"Amma","description":"Hugging saint of Kerala; heads the Mata Amritanandamayi Math and its worldwide charities; gives darshan to millions.","birthDate":"1953","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/hindu"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/mestre-irineu","url":"https://tantrafiles.xyz/person/mestre-irineu","name":"Raimundo Irineu Serra (Mestre Irineu)","alternateName":"Mestre Irineu","description":"Rubber-tapper turned prophet of Acre; founded the Santo Daime doctrine in the 1930s, weaving Christianity, shamanism and African spirit ways around the Daime sacrament.","birthDate":"1892","deathDate":"1971","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/santo-daime"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/mestre-gabriel","url":"https://tantrafiles.xyz/person/mestre-gabriel","name":"José Gabriel da Costa (Mestre Gabriel)","alternateName":"Mestre Gabriel","description":"Rubber-tapper of Rondônia; founded the União do Vegetal, teaching love of God and neighbour through the hoasca sacrament; doctrine affirmed by the US Supreme Court (2006).","birthDate":"1922","deathDate":"1971","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/udv"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/guru-nanak","url":"https://tantrafiles.xyz/person/guru-nanak","name":"Guru Nanak","alternateName":"Guru Nanak","description":"Founder of Sikhism (1469–1539); taught one God, honest work and shared food; composed the Japji Sahib.","birthDate":"1469","deathDate":"1539","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sikh"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/gobind-singh","url":"https://tantrafiles.xyz/person/gobind-singh","name":"Guru Gobind Singh","alternateName":"Guru Gobind Singh","description":"Tenth Sikh Guru; founded the Khalsa (1699), closed the human Guruship in the Guru Granth Sahib.","birthDate":"1666","deathDate":"1708","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sikh"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/yogi-bhajan","url":"https://tantrafiles.xyz/person/yogi-bhajan","name":"Yogi Bhajan","alternateName":"Yogi Bhajan","description":"Brought Kundalini Yoga and Sikh Dharma to the West; founded the Espanola Mother Ashram (1970) and 3HO.","birthDate":"1929","deathDate":"2004","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sikh"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/mahavira","url":"https://tantrafiles.xyz/person/mahavira","name":"Mahavira (Vardhamana)","alternateName":"Mahavira","description":"24th tirthankara (traditional dates); reformer of the Jain path; taught ahimsa and anekantavada in the Gangetic plain.","birthDate":"-0540","deathDate":"-0468","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/jain"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/sushil-kumar","url":"https://tantrafiles.xyz/person/sushil-kumar","name":"Acharya Sushil Kumarji","alternateName":"Sushil Kumarji","description":"Jain monk who carried Mahavira's message West from 1975; founded Siddhachalam (1983), the only Jain tirth outside India; taught Arhum Yoga. No successor.","birthDate":"1926","deathDate":"1994","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/jain"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/laozi","url":"https://tantrafiles.xyz/person/laozi","name":"Laozi","alternateName":"Laozi","description":"Traditional author of the Daodejing (6th c. BCE, traditional); root figure of philosophical and religious Taoism.","birthDate":"-0006","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/taoist"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/bahaullah","url":"https://tantrafiles.xyz/person/bahaullah","name":"Baha'u'llah","alternateName":"Baha'u'llah","description":"Founder of the Baha'i Faith (1817–1892); Kitab-i-Aqdas; taught the oneness of God, religion and humanity.","birthDate":"1817","deathDate":"1892","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/bahai"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/abdu-l-baha","url":"https://tantrafiles.xyz/person/abdu-l-baha","name":"Abdu'l-Baha","alternateName":"Abdu'l-Baha","description":"Son and appointed successor of Baha'u'llah (1844–1921); spread the Faith in the West; no clergy — elected order.","birthDate":"1844","deathDate":"1921","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/bahai"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/sogyal-rinpoche","url":"https://tantrafiles.xyz/person/sogyal-rinpoche","name":"Sogyal Rinpoche","alternateName":"Sogyal Rinpoche","description":"Founder of Rigpa; Tibetan teacher (Nyingma tulku) whose books reached millions; stepped back in 2017 after misconduct allegations, died 2019.","birthDate":"1947","deathDate":"2019","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/rigpa"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/sakyong-mipham","url":"https://tantrafiles.xyz/person/sakyong-mipham","name":"Sakyong Mipham Rinpoche","alternateName":"Sakyong Mipham","description":"Head of the Shambhala lineage (son of Chögyam Trungpa); stepped back from teaching duties in 2018 after misconduct claims and investigation.","birthDate":"1962","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/shambhala"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/amrit-desai","url":"https://tantrafiles.xyz/person/amrit-desai","name":"Yogi Amrit Desai","alternateName":"Amrit Desai","description":"Founder of Kripalu (1972); resigned 1994 after admitting affairs; federal litigation followed; Kripalu restructured without him.","birthDate":"1932","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/hindu"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/kumaradza","url":"https://tantrafiles.xyz/person/kumaradza","name":"Rigdzin Kumaradza","alternateName":"Kumaradza","description":"Dzogchen master; root guru of Longchenpa (Vima Nyingthig) and teacher of the 3rd Karmapa Rangjung Dorje.","birthDate":"1266","deathDate":"1343","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/nyingma"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/longchenpa"}},{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/rangjung-dorje"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/longchenpa","url":"https://tantrafiles.xyz/person/longchenpa","name":"Longchen Rabjam (Longchenpa)","alternateName":"Longchenpa","description":"Systematiser of Dzogchen (Seven Treasuries); successor of Kumaradza; visions of Padmasambhava; re-revealed by Jigme Lingpa centuries later.","birthDate":"1308","deathDate":"1363","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/nyingma"}],"knows":[{"@type":"Role","roleName":"influenced","knows":{"@id":"https://tantrafiles.xyz/person/jigme-lingpa"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/jigme-lingpa","url":"https://tantrafiles.xyz/person/jigme-lingpa","name":"Jigme Lingpa","alternateName":"Jigme Lingpa","description":"Tertön whose Longchen Nyingtik visions made Longchenpa's Heart Essence the dominant Nyingma practice cycle.","birthDate":"1729","deathDate":"1798","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/nyingma"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/jigme-gyalwai-nyugu"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/jigme-gyalwai-nyugu","url":"https://tantrafiles.xyz/person/jigme-gyalwai-nyugu","name":"Jigme Gyalwai Nyugu","alternateName":"Gyalwai Nyugu","description":"Hermit of Dzachuka; heart-disciple of Jigme Lingpa and root guru of Patrul (ngöndro 25 times).","birthDate":"1765","deathDate":"1842","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/nyingma"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/patrul"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/patrul","url":"https://tantrafiles.xyz/person/patrul","name":"Patrul Rinpoche","alternateName":"Patrul","description":"Wandering yogi-scholar; Words of My Perfect Teacher; root-guru lineage Jigme Lingpa→Gyalwai Nyugu→Patrul→Mipham.","birthDate":"1808","deathDate":"1887","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/nyingma"}],"hasOccupation":{"@type":"Occupation","name":"Scholar"},"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/mipham"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/mipham","url":"https://tantrafiles.xyz/person/mipham","name":"Jamgon Mipham (Ju Mipham)","alternateName":"Mipham","description":"Prolific Nyingma scholar (30+ volumes); student of Patrul, Kongtrul and Khyentse Wangpo; teacher of Shechen Gyaltsap; named infant Dilgo Khyentse.","birthDate":"1846","deathDate":"1912","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/nyingma"}],"hasOccupation":{"@type":"Occupation","name":"Scholar"},"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/shechen-gyaltsap"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/jamgon-kongtrul","url":"https://tantrafiles.xyz/person/jamgon-kongtrul","name":"Jamgon Kongtrul Lodro Thaye","alternateName":"Jamgon Kongtrul","description":"Rimé collector (Five Treasuries) with Khyentse Wangpo and Chokgyur Lingpa; teacher of Mipham; emanation-source of Kalu Rinpoche's line.","birthDate":"1813","deathDate":"1899","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/kagyu"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/mipham"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/jamyang-khyentse-wangpo","url":"https://tantrafiles.xyz/person/jamyang-khyentse-wangpo","name":"Jamyang Khyentse Wangpo","alternateName":"Khyentse Wangpo","description":"Tertön and Rimé founder with Kongtrul; root guru of Mipham; incarnation line continues (Khyentse Chökyi Lodrö, Dilgo, Dzongsar).","birthDate":"1820","deathDate":"1892","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/nyingma"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/mipham"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/shechen-gyaltsap","url":"https://tantrafiles.xyz/person/shechen-gyaltsap","name":"Shechen Gyaltsap","alternateName":"Shechen Gyaltsap","description":"Mipham's heart-disciple; root guru of Dilgo Khyentse (enthroned him as Khyentse Wangpo's mind emanation).","birthDate":"1871","deathDate":"1926","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/nyingma"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/dilgo-khyentse"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/jamyang-khyentse-chokyi-lodro","url":"https://tantrafiles.xyz/person/jamyang-khyentse-chokyi-lodro","name":"Jamyang Khyentse Chökyi Lodrö","alternateName":"Khyentse Chökyi Lodrö","description":"Activity emanation of Khyentse Wangpo; second root teacher of Dilgo Khyentse; taught all four schools to 80+ masters' heir.","birthDate":"1893","deathDate":"1959","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sakya"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/dilgo-khyentse"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/jigme-phuntsok","url":"https://tantrafiles.xyz/person/jigme-phuntsok","name":"Khenchen Jigme Phuntsok","alternateName":"Jigme Phuntsok","description":"Founder of Larung Gar (world's largest Buddhist institute); root guru of Khenpo Sodargye; nonsectarian tertön.","birthDate":"1933","deathDate":"2004","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/nyingma"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/khenpo-sodargye"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/khamtrul-8","url":"https://tantrafiles.xyz/person/khamtrul-8","name":"8th Khamtrul Rinpoche Dongyud Nyima","alternateName":"Khamtrul Dongyud Nyima","description":"Drukpa master of Khampagar (Tashi Jong); root guru of Jetsunma Tenzin Palmo (ordained her 1964).","birthDate":"1930","deathDate":"1980","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/drukpa"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/jetsunma-tenzin-palmo"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/yonten-gyatso","url":"https://tantrafiles.xyz/person/yonten-gyatso","name":"Yonten Gyatso","alternateName":"Yonten Gyatso","description":"Jonang throne-holder; gave Dolpopa the complete Kalachakra/Dro transmission and named him heir (1326).","birthDate":"1260","deathDate":"1327","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/jonang"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/dolpopa"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/huiguo","url":"https://tantrafiles.xyz/person/huiguo","name":"Huiguo","alternateName":"Huiguo","description":"Tang court master at Qinglong Monastery; poured the two-mandala transmission into Kukai in months (805); 7th Shingon patriarch.","birthDate":"0746","deathDate":"0805","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/chan"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/kukai"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/rendawa","url":"https://tantrafiles.xyz/person/rendawa","name":"Rendawa Zhonnu Lodro","alternateName":"Rendawa","description":"Sakya master of explanation; Tsongkhapa's foremost teacher (Pramanavarttika, Madhyamaka); later mutual instruction.","birthDate":"1349","deathDate":"1412","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sakya"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/tsongkhapa"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/phagmo-drupa","url":"https://tantrafiles.xyz/person/phagmo-drupa","name":"Phagmo Drupa Dorje Gyalpo","alternateName":"Phagmo Drupa","description":"Gampopa's chief disciple; teacher of Jigten Sumgon; the eight Kagyu branches divide from his seat.","birthDate":"1110","deathDate":"1170","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/kagyu"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/jigten-sumgon"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/sachen","url":"https://tantrafiles.xyz/person/sachen","name":"Sachen Kunga Nyingpo","alternateName":"Sachen","description":"Founder of Sakya (1073); first of the Five Forefathers; father and first teacher of Dragpa Gyaltsen.","birthDate":"1092","deathDate":"1158","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sakya"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/dragpa-gyaltsen"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/dragpa-gyaltsen","url":"https://tantrafiles.xyz/person/dragpa-gyaltsen","name":"Jetsun Dragpa Gyaltsen","alternateName":"Dragpa Gyaltsen","description":"Third Sakya patriarch; son and student of Sachen; principal teacher of his nephew Sakya Pandita.","birthDate":"1147","deathDate":"1216","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sakya"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/sakya-pandita"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/sakya-pandita","url":"https://tantrafiles.xyz/person/sakya-pandita","name":"Sakya Pandita Kunga Gyaltsen","alternateName":"Sakya Pandita","description":"Fourth Sakya forefather; epistemologist (Treasury of Reasoning); student of Dragpa Gyaltsen and Sakya Shri; negotiated Tibet's surrender (1244).","birthDate":"1182","deathDate":"1251","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sakya"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/tsangpa-gyare","url":"https://tantrafiles.xyz/person/tsangpa-gyare","name":"Tsangpa Gyare","alternateName":"Tsangpa Gyare","description":"Founder of the Drukpa Kagyu (student of Ling Repa); 'Thunder-Dragon' line of the Himalayas.","birthDate":"1161","deathDate":"1211","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/drukpa"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/ling-repa","url":"https://tantrafiles.xyz/person/ling-repa","name":"Lingchen Repa Pema Dorje","alternateName":"Ling Repa","description":"Drukpa yogi; teacher of Tsangpa Gyare (medium confidence — confirm before treating as settled).","birthDate":"1128","deathDate":"1188","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/drukpa"}],"knows":[{"@type":"Role","roleName":"studied_with","knows":{"@id":"https://tantrafiles.xyz/person/tsangpa-gyare"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/jigten-sumgon","url":"https://tantrafiles.xyz/person/jigten-sumgon","name":"Jigten Sumgon","alternateName":"Jigten Sumgon","description":"Founder of Drikung Kagyu (Drikung Thil 1179); chief disciple of Phagmo Drupa; Gongchig (Single Intention).","birthDate":"1143","deathDate":"1217","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/drikung"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/niguma","url":"https://tantrafiles.xyz/person/niguma","name":"Niguma","alternateName":"Niguma","description":"Wisdom dakini of Kashmir; sister of Naropa; source of the Shangpa transmission to Khyungpo Naljor.","birthDate":"0010","deathDate":"0011","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/shangpa"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/khyungpo-naljor"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/khyungpo-naljor","url":"https://tantrafiles.xyz/person/khyungpo-naljor","name":"Khyungpo Naljor","alternateName":"Khyungpo Naljor","description":"Founder of Shangpa Kagyu; seven India journeys; received Niguma/Sukhasiddhi transmissions; one-to-one lineage begins.","birthDate":"0990","deathDate":"1139","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/shangpa"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/yizhin-norbu","url":"https://tantrafiles.xyz/person/yizhin-norbu","name":"Yizhin Norbu (Tsa Tsa Drubgen)","alternateName":"Yizhin Norbu","description":"Abbot of Tsa Tsa Monastery; gave Kalu Rinpoche the complete Shangpa cycle in closed retreat (1940s).","birthDate":"2005","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/shangpa"}],"knows":[{"@type":"Role","roleName":"studied_with","knows":{"@id":"https://tantrafiles.xyz/person/kalu-rinpoche"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/khenchen-appey","url":"https://tantrafiles.xyz/person/khenchen-appey","name":"Khenchen Appey Rinpoche","alternateName":"Appey Rinpoche","description":"Sakya scholar (International Buddhist Academy founder); teacher of senior Sakya masters including Dzongsar Khyentse.","birthDate":"1927","deathDate":"2010","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sakya"}],"hasOccupation":{"@type":"Occupation","name":"Scholar"},"knows":[{"@type":"Role","roleName":"studied_with","knows":{"@id":"https://tantrafiles.xyz/person/dzongsar-khyentse"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/rangjung-dorje","url":"https://tantrafiles.xyz/person/rangjung-dorje","name":"Rangjung Dorje (3rd Karmapa)","alternateName":"Rangjung Dorje","description":"3rd Karmapa; student of Kumaradza (Vima Nyingthig); discussed view with Dolpopa at Tsurphu (1321).","birthDate":"1284","deathDate":"1339","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/kagyu"}],"knows":[{"@type":"Role","roleName":"studied_with","knows":{"@id":"https://tantrafiles.xyz/person/longchenpa"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/chenga-chokyi-gyalpo","url":"https://tantrafiles.xyz/person/chenga-chokyi-gyalpo","name":"Chenga Chokyi Gyalpo","alternateName":"Chenga Rinpoche","description":"Drikung patriarch under whom Tsongkhapa studied Mahamudra and the Six Dharmas of Naropa.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/drikung"}],"knows":[{"@type":"Role","roleName":"studied_with","knows":{"@id":"https://tantrafiles.xyz/person/tsongkhapa"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/garab-dorje","url":"https://tantrafiles.xyz/person/garab-dorje","name":"Garab Dorje","alternateName":"Garab Dorje","description":"First human holder of Dzogchen (traditional account); taught Mañjushrimitra; lineage root of the mind section.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/dzogchen"}],"knows":[{"@type":"Role","roleName":"studied_with","knows":{"@id":"https://tantrafiles.xyz/person/manjushrimitra"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/manjushrimitra","url":"https://tantrafiles.xyz/person/manjushrimitra","name":"Mañjushrimitra","alternateName":"Mañjushrimitra","description":"Second Dzogchen holder (traditional); student of Garab Dorje, teacher of Shri Simha.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/dzogchen"}],"knows":[{"@type":"Role","roleName":"studied_with","knows":{"@id":"https://tantrafiles.xyz/person/shri-simha"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/shri-simha","url":"https://tantrafiles.xyz/person/shri-simha","name":"Shri Simha","alternateName":"Shri Simha","description":"Third Dzogchen holder (traditional); student of Mañjushrimitra, teacher of Jñanasutra.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/dzogchen"}],"knows":[{"@type":"Role","roleName":"studied_with","knows":{"@id":"https://tantrafiles.xyz/person/jnanasutra"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/jnanasutra","url":"https://tantrafiles.xyz/person/jnanasutra","name":"Jñanasutra","alternateName":"Jñanasutra","description":"Fourth Dzogchen holder (traditional); student of Shri Simha, teacher of Vimalamitra.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/dzogchen"}],"knows":[{"@type":"Role","roleName":"studied_with","knows":{"@id":"https://tantrafiles.xyz/person/vimalamitra"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/vimalamitra","url":"https://tantrafiles.xyz/person/vimalamitra","name":"Vimalamitra","alternateName":"Vimalamitra","description":"Fifth Dzogchen holder (traditional); student of Jñanasutra; contemporary of Padmasambhava at Samye.","birthDate":"0008","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/dzogchen"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/saraha","url":"https://tantrafiles.xyz/person/saraha","name":"Saraha","alternateName":"Saraha","description":"Mahasiddha of the doha songs; Mahamudra root figure; inspiration-line for Maitripa and Marpa's second transmission.","birthDate":"0008","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/mahamudra"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/maitripa","url":"https://tantrafiles.xyz/person/maitripa","name":"Maitripa (Advayavajra)","alternateName":"Maitripa","description":"Mahamudra master (1007–1085); Marpa's second guru after Naropa; Amanasikara cycle.","birthDate":"1007","deathDate":"1085","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/mahamudra"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/marpa"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/aryadeva","url":"https://tantrafiles.xyz/person/aryadeva","name":"Aryadeva","alternateName":"Aryadeva","description":"Nagarjuna's direct disciple; Four Hundred Verses; carried Madhyamaka to the south (and, traditionally, to Sri Lanka).","birthDate":"0003","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/madhyamaka"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/ronald-davidson","url":"https://tantrafiles.xyz/person/ronald-davidson","name":"Ronald Davidson","alternateName":"Ronald Davidson","description":"Fairfield historian of Indian esoteric Buddhism (Indian Esoteric Buddhism, Tibetan Renaissance); Vajrayana institutional history.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/tibetan"}],"hasOccupation":{"@type":"Occupation","name":"Scholar"}},{"@type":"Person","@id":"https://tantrafiles.xyz/person/jayaratha","url":"https://tantrafiles.xyz/person/jayaratha","name":"Jayaratha","alternateName":"Jayaratha","description":"13th-century Kashmir commentator whose Tantraloka-viveka unpacks Abhinavagupta's 37 chapters line by line.","birthDate":"0013","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/trika"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/yogaraja","url":"https://tantrafiles.xyz/person/yogaraja","name":"Yogaraja","alternateName":"Yogaraja","description":"Kashmir exegete; commentary on Abhinavagupta's Paramarthasara (Essence of the Highest Reality).","birthDate":"0011","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/trika"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/bhaskararaya","url":"https://tantrafiles.xyz/person/bhaskararaya","name":"Bhaskararaya Makhin","alternateName":"Bhaskararaya","description":"Sri Vidya polymath (1690–1785); Saubhagyabhaskara on the Lalita Sahasranama (1728), Setubandha (1748); initiated by Sivadatta Shukla at Surat.","birthDate":"1690","deathDate":"1785","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sri-vidya"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/sadyojyoti","url":"https://tantrafiles.xyz/person/sadyojyoti","name":"Sadyojyoti","alternateName":"Sadyojyoti","description":"Systematiser of Shaiva Siddhanta doctrine (c. 7th–9th c.); root figure of the dualist Shaiva schools.","birthDate":"0007","deathDate":"0009","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/shaiva-siddhanta"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/meykandar","url":"https://tantrafiles.xyz/person/meykandar","name":"Meykandar","alternateName":"Meykandar","description":"13th-century Tamil philosopher; Sivajnanabodham (12 sutras); founded the Meykandar (Santana) Santana line via Paranjyoti's diksha.","birthDate":"0013","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/shaiva-siddhanta"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/paranjyoti","url":"https://tantrafiles.xyz/person/paranjyoti","name":"Paranjyoti Munivar","alternateName":"Paranjyoti","description":"The sage 'descended from Kailash' who initiated the boy Meykandar on the street of Thiruvennainallur (traditional).","birthDate":"0013","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/shaiva-siddhanta"}],"knows":[{"@type":"Role","roleName":"studied_with","knows":{"@id":"https://tantrafiles.xyz/person/meykandar"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/tirumular","url":"https://tantrafiles.xyz/person/tirumular","name":"Tirumular","alternateName":"Tirumular","description":"Author of the Tirumantiram (3000 verses); among Nandinatha's eight disciples (traditional); Tamil Siddha root.","birthDate":"0005","deathDate":"0006","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/shaiva-siddhanta"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/nandinatha","url":"https://tantrafiles.xyz/person/nandinatha","name":"Nandinatha","alternateName":"Nandinatha","description":"Legendary root guru of the Nandinatha Sampradaya; eight disciples incl. Tirumular (traditional).","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/shaiva-siddhanta"}],"knows":[{"@type":"Role","roleName":"studied_with","knows":{"@id":"https://tantrafiles.xyz/person/tirumular"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/sukhasiddhi","url":"https://tantrafiles.xyz/person/sukhasiddhi","name":"Sukhasiddhi","alternateName":"Sukhasiddhi","description":"Wisdom dakini; student of Virupa; co-teacher (with Niguma) of Khyungpo Naljor's Shangpa transmission.","birthDate":"0010","deathDate":"0011","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/shangpa"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/khyungpo-naljor"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/yajnavalkya","url":"https://tantrafiles.xyz/person/yajnavalkya","name":"Yajnavalkya","alternateName":"Yajnavalkya","description":"Upanishadic sage of the Brihadaranyaka; neti-neti dialogues with Maitreyi; debated by Gargi.","birthDate":"-0008","deathDate":"-0007","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/vedic"}],"knows":[{"@type":"Role","roleName":"studied_with","knows":{"@id":"https://tantrafiles.xyz/person/maitreyi"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/uddalaka","url":"https://tantrafiles.xyz/person/uddalaka","name":"Uddalaka Aruni","alternateName":"Uddalaka","description":"Father-teacher of Shvetaketu (Chandogya); 'Tat Tvam Asi' — thou art that.","birthDate":"-0008","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/vedic"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/shvetaketu"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/shvetaketu","url":"https://tantrafiles.xyz/person/shvetaketu","name":"Shvetaketu","alternateName":"Shvetaketu","description":"Uddalaka's son; received the nine homilies culminating in Tat Tvam Asi (Chandogya 6).","birthDate":"-0008","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/vedic"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/gargi","url":"https://tantrafiles.xyz/person/gargi","name":"Gargi Vachaknavi","alternateName":"Gargi","description":"Philosopher at Janaka's court; questioned Yajnavalkya on the woven-and-warped Brahman (Brihadaranyaka 3.6–3.8).","birthDate":"-0008","deathDate":"-0007","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/vedic"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/maitreyi","url":"https://tantrafiles.xyz/person/maitreyi","name":"Maitreyi","alternateName":"Maitreyi","description":"Yajnavalkya's wife-interlocutor; chose knowledge over wealth (Brihadaranyaka 2.4, 4.5).","birthDate":"-0008","deathDate":"-0007","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/vedic"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/nachiketa","url":"https://tantrafiles.xyz/person/nachiketa","name":"Nachiketa","alternateName":"Nachiketa","description":"Boy who questioned Death (Yama) and received the fire-doctrine and Self-knowledge (Katha Upanishad).","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/vedic"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/satyakama","url":"https://tantrafiles.xyz/person/satyakama","name":"Satyakama Jabala","alternateName":"Satyakama","description":"Student of Haridrumata Gautama; truthfulness as qualification (Chandogya 4).","birthDate":"-0008","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/vedic"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/vashistha","url":"https://tantrafiles.xyz/person/vashistha","name":"Vashistha","alternateName":"Vashistha","description":"Vedic seer (Rig Veda mandala 7); priest of Ikshvaku kings; Yoga-Vasishtha interlocutor.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/vedic"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/vishvamitra","url":"https://tantrafiles.xyz/person/vishvamitra","name":"Vishvamitra","alternateName":"Vishvamitra","description":"Seer of the Gayatri mantra (Rig Veda 3.62.10); rival-counterpart of Vashistha.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/vedic"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/vyasa","url":"https://tantrafiles.xyz/person/vyasa","name":"Vyasa (Krishna Dvaipayana)","alternateName":"Vyasa","description":"Traditional compiler of the Vedas and author of the Mahabharata; root figure of smriti.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/vedic"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/valmiki","url":"https://tantrafiles.xyz/person/valmiki","name":"Valmiki","alternateName":"Valmiki","description":"Traditional author of the Ramayana; 'first poet' (adikavi).","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/vedic"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/agastya","url":"https://tantrafiles.xyz/person/agastya","name":"Agastya","alternateName":"Agastya","description":"Vedic seer who carried the tradition south; Rig Vedic hymns + Tamil tradition root.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/vedic"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/kallata","url":"https://tantrafiles.xyz/person/kallata","name":"Kallaṭa","alternateName":"Kallata","description":"Chief disciple of Vasugupta; received the Spanda-karika; bridge Vasugupta→Kashmir line.","birthDate":"0009","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/spanda"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/rumi","url":"https://tantrafiles.xyz/person/rumi","name":"Jalaluddin Rumi","alternateName":"Rumi","description":"Persian poet-mystic (1207–1273); Divan and 25,000-verse Mathnawi; transformed by Shams (1244); order organized by son Sultan Walad.","birthDate":"1207","deathDate":"1273","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/mevlevi-rumi"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/sultan-walad"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/shams-tabrizi","url":"https://tantrafiles.xyz/person/shams-tabrizi","name":"Shams-i Tabrizi","alternateName":"Shams","description":"Wandering dervish whose 1244 Konya meeting transformed Rumi; Divan named for him; disappeared 1248 (traditional).","birthDate":"1248","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sufism"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/rumi"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/baha-walad","url":"https://tantrafiles.xyz/person/baha-walad","name":"Baha al-Din Walad","alternateName":"Baha Walad","description":"Rumi's father; Hanafi scholar-mystic of Balkh; family fled the Mongols to Konya; Rumi's first formation.","birthDate":"1231","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sufism"}],"hasOccupation":{"@type":"Occupation","name":"Scholar"},"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/rumi"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/burhan-aldin","url":"https://tantrafiles.xyz/person/burhan-aldin","name":"Sayyid Burhan al-Din","alternateName":"Burhan al-Din","description":"Rumi's first Sufi master after his father (from 1232); nine years' training, forty-day retreats; directed his Aleppo studies.","birthDate":"1241","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sufism"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/rumi"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/sultan-walad","url":"https://tantrafiles.xyz/person/sultan-walad","name":"Sultan Walad","alternateName":"Sultan Walad","description":"Rumi's son; first organizer of the Mevlevi order after Husam's death; Ibtidanama chronicler.","birthDate":"1226","deathDate":"1312","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/mevlevi-rumi"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/qunawi","url":"https://tantrafiles.xyz/person/qunawi","name":"Sadr al-Din al-Qunawi","alternateName":"Qunawi","description":"Ibn Arabi's stepson and foremost disciple (ijaza for all works); systematized the school (wujūd, Perfect Man); teacher of Tilimsani, Jandi, Iraqi.","birthDate":"1209","deathDate":"1274","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/akbarian"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/plethon","url":"https://tantrafiles.xyz/person/plethon","name":"Gemistus Plethon","alternateName":"Plethon","description":"Byzantine Platonist of Mistra; Bessarion's teacher; Laws manuscript burned as pagan; Council of Florence catalyst.","birthDate":"1355","deathDate":"1452","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/platonic"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/bessarion"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/bessarion","url":"https://tantrafiles.xyz/person/bessarion","name":"Basil Bessarion","alternateName":"Bessarion","description":"Plethon's student turned cardinal; carried Plato west (In calumniatorem Platonis); exegetical schemes fed Ficino.","birthDate":"1403","deathDate":"1472","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/christian"}],"knows":[{"@type":"Role","roleName":"influenced","knows":{"@id":"https://tantrafiles.xyz/person/marsilio-ficino"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/pico-della-mirandola","url":"https://tantrafiles.xyz/person/pico-della-mirandola","name":"Giovanni Pico della Mirandola","alternateName":"Pico","description":"Florentine Academy junior; Oration on the Dignity of Man (900 theses); Christian Kabbalah with Ficino's Platonism.","birthDate":"1463","deathDate":"1494","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/platonic"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/augustine","url":"https://tantrafiles.xyz/person/augustine","name":"Augustine of Hippo","alternateName":"Augustine","description":"Bishop of Hippo (354–430); read the Platonists (Enneads in Latin); Confessions/City of God; baptized Neoplatonism into Christianity.","birthDate":"0354","deathDate":"0430","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/christian"}],"knows":[{"@type":"Role","roleName":"influenced","knows":{"@id":"https://tantrafiles.xyz/person/aquinas"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/erigena","url":"https://tantrafiles.xyz/person/erigena","name":"John Scottus Eriugena","alternateName":"Eriugena","description":"9th-century Irish scholar at Laon; translated Pseudo-Dionysius into Latin; Periphyseon; channeled theosis west.","birthDate":"0800","deathDate":"0877","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/christian"}],"hasOccupation":{"@type":"Occupation","name":"Scholar"}},{"@type":"Person","@id":"https://tantrafiles.xyz/person/cusa","url":"https://tantrafiles.xyz/person/cusa","name":"Nicholas of Cusa","alternateName":"Cusa","description":"Cardinal-philosopher (1401–1464); learned ignorance (De docta ignorantia); Eckhart and Proclus/Dionysius debts.","birthDate":"1401","deathDate":"1464","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/christian"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/parmenides","url":"https://tantrafiles.xyz/person/parmenides","name":"Parmenides","alternateName":"Parmenides","description":"Presocratic of Elea (c. 515–450 BCE); the Way of Truth; read by the tradition (and Peter Kingsley) as mystic, not logician.","birthDate":"-0515","deathDate":"-0450","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/presocratic-mysticism"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/empedocles","url":"https://tantrafiles.xyz/person/empedocles","name":"Empedocles","alternateName":"Empedocles","description":"Sicilian healer-prophet (c. 495–435 BCE); four roots + Love/Strife; mystic-physician of the Western root.","birthDate":"-0495","deathDate":"-0435","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/presocratic-mysticism"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/hsing-yun","url":"https://tantrafiles.xyz/person/hsing-yun","name":"Hsing Yun","alternateName":"Hsing Yun","description":"Founder of Fo Guang Shan (1967) and 200+ branch temples incl. Nan Tien; Humanistic Buddhism.","birthDate":"1927","deathDate":"2023","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/mahayana"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/swami-ramdev","url":"https://tantrafiles.xyz/person/swami-ramdev","name":"Swami Ramdev","alternateName":"Ramdev","description":"Yoga teacher and Patanjali Yogpeeth co-founder; mass yoga camps, Ayurveda institutions.","birthDate":"1965","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/hindu"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/shriram-sharma","url":"https://tantrafiles.xyz/person/shriram-sharma","name":"Shriram Sharma Acharya","alternateName":"Shriram Sharma","description":"Founder of Shantikunj/AWGP (1971); Gayatri sadhana, Yug Nirman mission; 3500+ centres.","birthDate":"1911","deathDate":"1990","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/hindu"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/chidanand-saraswati","url":"https://tantrafiles.xyz/person/chidanand-saraswati","name":"Swami Chidanand Saraswati","alternateName":"Chidanand Saraswati","description":"President of Parmarth Niketan; Ganga Aarti host; interfaith water/environment work.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/hindu"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/ajahn-tong","url":"https://tantrafiles.xyz/person/ajahn-tong","name":"Ajahn Tong Sirimangalo","alternateName":"Ajahn Tong","description":"Mahasi student (Rangoon 1957); abbot of Chom Tong 1991–2019; spread four-foundations vipassana to 11+ countries; Northern Vipassana dept.","birthDate":"1923","deathDate":"2019","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/mahasi"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/ajahn-martin","url":"https://tantrafiles.xyz/person/ajahn-martin","name":"Ajahn Martin Piyadhammo","alternateName":"Ajahn Martin","description":"German-born Thai Forest monk (Maha Bua line); Wat Phu Kong Tong; blunt desanas answered from practitioner questions; 3 free books.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/thai-forest"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/ajahn-suphan","url":"https://tantrafiles.xyz/person/ajahn-suphan","name":"Ajahn Suphan","alternateName":"Ajahn Suphan","description":"Abbot of Wat Ram Poeng (Tapotaram); carries Ajahn Tong's Northern Insight 26-day curriculum.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/mahasi"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/suhrawardi","url":"https://tantrafiles.xyz/person/suhrawardi","name":"Shihab al-Din Suhrawardi","alternateName":"Suhrawardi","description":"Founder of Illuminationism (1154–1191, Aleppo); Hikmat al-Ishraq; light metaphysics; executed.","birthDate":"1154","deathDate":"1191","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sufism"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/ghazali","url":"https://tantrafiles.xyz/person/ghazali","name":"Al-Ghazali","alternateName":"Ghazali","description":"Theologian-mystic (1058–1111); Revival of the Religious Sciences; studied under al-Juwayni; Sufi turn after crisis.","birthDate":"1058","deathDate":"1111","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sufism"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/hallaj","url":"https://tantrafiles.xyz/person/hallaj","name":"Mansur al-Hallaj","alternateName":"Hallaj","description":"Ecstatic martyr (858–922, Baghdad); 'I am the Truth'; associated with Junayd's circle.","birthDate":"0858","deathDate":"0922","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sufism"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/attar","url":"https://tantrafiles.xyz/person/attar","name":"Fariduddin Attar","alternateName":"Attar","description":"Nishapur poet-pharmacist (c. 1145–1221); Conference of the Birds, Memorial of the Saints.","birthDate":"1145","deathDate":"1221","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sufism"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/sanai","url":"https://tantrafiles.xyz/person/sanai","name":"Sanai","alternateName":"Sanai","description":"Ghazna court poet turned mystic (d. c. 1131); Hadiqa (Walled Garden), first great Persian Sufi mathnawi.","birthDate":"1131","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sufism"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/mulla-sadra","url":"https://tantrafiles.xyz/person/mulla-sadra","name":"Mulla Sadra","alternateName":"Mulla Sadra","description":"Safavid philosopher (1571–1640); transcendent theosophy (al-hikmah al-muta'aliyah); student of Mir Damad.","birthDate":"1571","deathDate":"1640","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sufism"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/mir-damad","url":"https://tantrafiles.xyz/person/mir-damad","name":"Mir Damad","alternateName":"Mir Damad","description":"Safavid philosopher-scientist (d. 1631); teacher of Mulla Sadra; School of Isfahan.","birthDate":"1631","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sufism"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/mulla-sadra"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/juwayni","url":"https://tantrafiles.xyz/person/juwayni","name":"Al-Juwayni","alternateName":"Juwayni","description":"Asharite theologian of Nishapur (1028–1085); Ghazali's master; Shafi'i authority.","birthDate":"1028","deathDate":"1085","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sufism"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/ghazali"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/junayd","url":"https://tantrafiles.xyz/person/junayd","name":"Junayd al-Baghdadi","alternateName":"Junayd","description":"Baghdad master (d. 910); sober Sufism; Hallaj moved in his circle and was reproved by him.","birthDate":"0910","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/sufism"}],"knows":[{"@type":"Role","roleName":"studied_with","knows":{"@id":"https://tantrafiles.xyz/person/hallaj"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/marinus","url":"https://tantrafiles.xyz/person/marinus","name":"Marinus of Neapolis","alternateName":"Marinus","description":"Successor of Proclus as head of the Athenian school; wrote the Life of Proclus.","birthDate":"0005","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/platonic"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/aquinas","url":"https://tantrafiles.xyz/person/aquinas","name":"Thomas Aquinas","alternateName":"Aquinas","description":"Dominican theologian (1225–1274); Summa; baptized Aristotle through Augustine's Platonist legacy.","birthDate":"1225","deathDate":"1274","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/christian"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/chandrakirti","url":"https://tantrafiles.xyz/person/chandrakirti","name":"Chandrakirti","alternateName":"Chandrakirti","description":"7th-century Madhyamaka commentator (Madhyamakavatara); Prasangika reading of Nagarjuna.","birthDate":"0600","deathDate":"0650","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/madhyamaka"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/shantideva","url":"https://tantrafiles.xyz/person/shantideva","name":"Shantideva","alternateName":"Shantideva","description":"8th-century monk-scholar; Bodhicaryavatara (Way of the Bodhisattva); taught by Patrul/Mipham line ever after.","birthDate":"0008","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/madhyamaka"}],"hasOccupation":{"@type":"Occupation","name":"Scholar"}},{"@type":"Person","@id":"https://tantrafiles.xyz/person/asanga","url":"https://tantrafiles.xyz/person/asanga","name":"Asanga","alternateName":"Asanga","description":"4th-century systematizer (with brother Vasubandhu); Yogacara/Cittamatra; Abhidharmasamuccaya.","birthDate":"0004","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/mahayana"}],"knows":[{"@type":"Role","roleName":"studied_with","knows":{"@id":"https://tantrafiles.xyz/person/vasubandhu"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/vasubandhu","url":"https://tantrafiles.xyz/person/vasubandhu","name":"Vasubandhu","alternateName":"Vasubandhu","description":"Abhidharmakosha author; converted to Mahayana by brother Asanga (traditional); Yogacara co-founder.","birthDate":"0004","deathDate":"0005","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/mahayana"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/shantarakshita","url":"https://tantrafiles.xyz/person/shantarakshita","name":"Shantarakshita","alternateName":"Shantarakshita","description":"Nalanda abbot invited to Tibet (8th c.); founded Samye with Padmasambhava; teacher of Kamalashila.","birthDate":"0725","deathDate":"0788","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/mahayana"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/kamalashila"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/kamalashila","url":"https://tantrafiles.xyz/person/kamalashila","name":"Kamalashila","alternateName":"Kamalashila","description":"Disciple of Shantarakshita; Samye debate victor (traditional); Stages of Meditation.","birthDate":"0008","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/mahayana"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/taranatha","url":"https://tantrafiles.xyz/person/taranatha","name":"Jetsun Taranatha","alternateName":"Taranatha","description":"Jonang historian-yogi (1575–1634); Damchö Ling founder; Kālacakra systematizer after Dolpopa.","birthDate":"1575","deathDate":"1634","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/jonang"}],"hasOccupation":{"@type":"Occupation","name":"Scholar"}},{"@type":"Person","@id":"https://tantrafiles.xyz/person/yeshe-tsogyal","url":"https://tantrafiles.xyz/person/yeshe-tsogyal","name":"Yeshe Tsogyal","alternateName":"Yeshe Tsogyal","description":"Padmasambhava's consort-disciple (8th c., traditional); treasure revealer; Nyingma mother-line root.","birthDate":"0008","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/nyingma"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/alara-kalama","url":"https://tantrafiles.xyz/person/alara-kalama","name":"Alara Kalama","alternateName":"Alara Kalama","description":"Meditation teacher of the Bodhisatta (formless attainments); left unsatisfied for Uddaka, then alone.","birthDate":"-0006","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/early-suttas"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/the-buddha"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/uddaka-ramaputta","url":"https://tantrafiles.xyz/person/uddaka-ramaputta","name":"Uddaka Ramaputta","alternateName":"Uddaka","description":"Second teacher of the Bodhisatta (neither-perception-nor-non-perception); declined, went forth alone.","birthDate":"-0006","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/early-suttas"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/the-buddha"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/arjun-seernels","url":"https://tantrafiles.xyz/person/arjun-seernels","name":"Arjun Seernels","description":"Close student of Mark Dyczkowski who co-leads the Anuttara Trika Kula online Reading Circles on the Tantrāloka (from April 2026).","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/trika"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/brian-campbell","url":"https://tantrafiles.xyz/person/brian-campbell","name":"Brian Campbell","description":"Student of Mark Dyczkowski and Sanskritist who co-leads the Anuttara Trika Kula Reading Circles; announced Dyczkowski’s death and the completed Tantrāloka translation on the INDOLOGY list.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/trika"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/rameshwar-jha","url":"https://tantrafiles.xyz/person/rameshwar-jha","name":"Acharya Rameshwar Jha","description":"Varanasi pandit and Kashmir Śaiva teacher under whom the young Mark Dyczkowski studied.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/trika"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/mark-dyczkowski"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/hemendra-chakravarti","url":"https://tantrafiles.xyz/person/hemendra-chakravarti","name":"Pandit Hemendra (Hemant) Nath Chakravarti","description":"Varanasi scholar, disciple of Gopinath Kaviraj, editor of a Tantrasāra translation; teacher of Mark Dyczkowski from 1971.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/trika"}],"hasOccupation":{"@type":"Occupation","name":"Scholar"},"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/mark-dyczkowski"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/gopinath-kaviraj","url":"https://tantrafiles.xyz/person/gopinath-kaviraj","name":"Gopinath Kaviraj","description":"Varanasi Sanskrit scholar and Tantric adept, disciple of Vishuddhananda and close to Anandamayi Ma.","birthDate":"1887","deathDate":"1976","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/shakta"}],"hasOccupation":{"@type":"Occupation","name":"Scholar"},"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/hemendra-chakravarti"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/gurumayi-chidvilasananda","url":"https://tantrafiles.xyz/person/gurumayi-chidvilasananda","name":"Gurumayi Chidvilasananda","description":"Head of Siddha Yoga who inaugurated the Muktabodha Indological Research Institute in 1997.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/siddha-yoga"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/yogi-matsyendranath-maharaj","url":"https://tantrafiles.xyz/person/yogi-matsyendranath-maharaj","name":"Guru Yogi Matsyendranath Maharaj (Matsyeshvarnath)","description":"Russian-born Nāth yogi who lived long among Nāths in India, received full initiation and guru status, and teaches Nāth haṭha and tantric sādhanā internationally through nathas.org.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/siddha-siddhanta"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/yogi-lakshminath","url":"https://tantrafiles.xyz/person/yogi-lakshminath","name":"Yogi Lakshminath Maharaj","description":"Teacher in the nathas.org community who leads online courses on prāṇāyāma, meditation, āsana and Śiva Sūtra satsangs.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/siddha-siddhanta"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/yogi-allamanath","url":"https://tantrafiles.xyz/person/yogi-allamanath","name":"Yogi Allamanath","description":"Teacher in the nathas.org community (tea satsangs and talks on the NathaChannel).","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/siddha-siddhanta"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/yogi-kamalnath","url":"https://tantrafiles.xyz/person/yogi-kamalnath","name":"Yogi Kamalnath","description":"Main pujari of the Gorakhnath Mandir, Gorakhpur; teacher of Yogi Mithileshnath.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/siddha-siddhanta"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/yogi-mithileshnath"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/swami-sadatmananda","url":"https://tantrafiles.xyz/person/swami-sadatmananda","name":"Swami Sadatmananda Saraswati","description":"Chief ācārya of Arsha Vidya Gurukulam, Anaikatti, since 2014 and paramount trustee of Sruti Seva Trust; trained under Swami Brahmatmananda (Baroda, 1986) and taught at Arsha Vidya Kendra Bangalore 1994–2014.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/arsha-vidya"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/swami-brahmatmananda","url":"https://tantrafiles.xyz/person/swami-brahmatmananda","name":"Swami Brahmatmananda","description":"Student of Swami Dayananda who ran a three-year Vedānta course in Baroda (1986) attended by Swami Sadatmananda.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/arsha-vidya"}],"knows":[{"@type":"Role","roleName":"teacher_of","knows":{"@id":"https://tantrafiles.xyz/person/swami-sadatmananda"}}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/swami-shankarananda-avg","url":"https://tantrafiles.xyz/person/swami-shankarananda-avg","name":"Swami Shankarananda Saraswati (Arsha Vidya)","description":"Disciple of Swami Dayananda teaching online Vedānta classes and retreats for AVG Anaikatti; ācārya of its Jan–Mar 2027 residential course. Distinct from Swami Shankarananda of Shiva Ashram (Kashmir Shaivism).","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/arsha-vidya"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/swami-sakshatkrtananda","url":"https://tantrafiles.xyz/person/swami-sakshatkrtananda","name":"Swami Sakshatkrtananda Saraswati","description":"Senior Arsha Vidya teacher associated with Swami Dayananda Ashram, Rishikesh (listed in its About menu; ashram contact address sakshat1949@).","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/arsha-vidya"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/swamini-brahmaprakasananda","url":"https://tantrafiles.xyz/person/swamini-brahmaprakasananda","name":"Mahamahopadhyaya Swamini Brahmaprakasananda Saraswati","description":"Senior disciple of Swami Dayananda and chief ācārya of Arsha Vijnana Gurukulam, Nagpur.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/arsha-vidya"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/swamini-vedarthananda","url":"https://tantrafiles.xyz/person/swamini-vedarthananda","name":"Swamini Vedarthananda Saraswati","description":"Faculty member at AVG Anaikatti who also looks after its temples.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/arsha-vidya"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/swamini-saradananda","url":"https://tantrafiles.xyz/person/swamini-saradananda","name":"Swamini Saradananda Saraswati","description":"Faculty member at AVG Anaikatti who also looks after its temples.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/arsha-vidya"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/swami-muktatmananda","url":"https://tantrafiles.xyz/person/swami-muktatmananda","name":"Swami Muktatmananda Saraswati","description":"Arsha Vidya teacher (Vedānta-sāra, Significance of OM series) at AVG Saylorsburg.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/arsha-vidya"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/swami-sachidananda-avg","url":"https://tantrafiles.xyz/person/swami-sachidananda-avg","name":"Swami Sachidananda (AVG)","description":"Arsha Vidya teacher and chanter at AVG Saylorsburg (Yoga of Objectivity series, satsangs).","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/arsha-vidya"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/swami-advayatmananda","url":"https://tantrafiles.xyz/person/swami-advayatmananda","name":"Swami Advayatmananda","description":"Arsha Vidya teacher (Hastāmalakīyam course, guided meditations) at AVG Saylorsburg, 2025.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/arsha-vidya"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/swami-pratyagbodhananda","url":"https://tantrafiles.xyz/person/swami-pratyagbodhananda","name":"Swami Pratyagbodhananda","description":"Arsha Vidya teacher whose talks appear on the AVG channel.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/arsha-vidya"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/swamini-paraprajnananda","url":"https://tantrafiles.xyz/person/swamini-paraprajnananda","name":"Swamini Paraprajnananda","description":"Arsha Vidya teacher whose classes appear on the AVG channel.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/arsha-vidya"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/swami-atmaswarupananda","url":"https://tantrafiles.xyz/person/swami-atmaswarupananda","name":"Swami Atmaswarupananda","description":"Senior Divine Life Society monk who gives the morning meditation talks at the Christmas–New Year retreats, Sivananda Ashram.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/divine-life-society"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/swami-krishnananda","url":"https://tantrafiles.xyz/person/swami-krishnananda","name":"Swami Krishnananda","description":"General secretary of the Divine Life Society for decades and prolific Vedānta lecturer (archival recordings).","birthDate":"1922","deathDate":"2001","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/divine-life-society"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/kym-faculty","url":"https://tantrafiles.xyz/person/kym-faculty","name":"KYM faculty (Krishnamacharya Yoga Mandiram)","description":"Collective teaching uploads of the Krishnamacharya Yoga Mandiram: chanting, Dhanur-dhyāna sādhanā, prāṇa lecture series.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/krishnamacharya-yoga"}]},{"@type":"Person","@id":"https://tantrafiles.xyz/person/geshe-lhakdor","url":"https://tantrafiles.xyz/person/geshe-lhakdor","name":"Geshe Lhakdor (Lobsang Jordhen)","description":"Director of the Library of Tibetan Works and Archives, former English translator to the Dalai Lama; teaches introductory Buddhism and Atiśa at LTWA.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/gelug"}],"hasOccupation":{"@type":"Occupation","name":"Scholar"}},{"@type":"Person","@id":"https://tantrafiles.xyz/person/tenzin-gache","url":"https://tantrafiles.xyz/person/tenzin-gache","name":"Ven. Tenzin Gache","description":"FPMT teacher presenting Nāgārjuna’s Seventy Stanzas and Sixty Stanzas at Root Institute.","knowsAbout":[{"@id":"https://tantrafiles.xyz/tradition/tibetan"}]},