e"],"@id":"https://tantrafiles.xyz/topic/awakening/buddha-nature","url":"https://tantrafiles.xyz/topic/awakening/buddha-nature","name":"Buddha-nature","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"awakening/buddha-nature","broader":{"@id":"https://tantrafiles.xyz/topic/awakening"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/feeling","url":"https://tantrafiles.xyz/topic/feeling","name":"Feeling","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"feeling","hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/thought","url":"https://tantrafiles.xyz/topic/thought","name":"Thinking","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"thought","hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/defilements","url":"https://tantrafiles.xyz/topic/defilements","name":"Defilements & hindrances","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"defilements","hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/kindness","url":"https://tantrafiles.xyz/topic/kindness","name":"Kindness","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"kindness","hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/kindness/compassion","url":"https://tantrafiles.xyz/topic/kindness/compassion","name":"Compassion","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"kindness/compassion","broader":{"@id":"https://tantrafiles.xyz/topic/kindness"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/faith","url":"https://tantrafiles.xyz/topic/faith","name":"Faith & devotion","description":"Devotion is the path of the heart: love turned toward the divine, a teacher, or a name. Bhakti sings it, Pure Land entrusts itself to Amida, the Sufi remembers God with every breath, the Christian prays without ceasing. Here the traditions describe what surrender is, and how it is practised.","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"faith","hasPart":[{"@type":"Question","name":"Bhakti: the love of God","text":"Devotion in the Hindu traditions: the name, the song, the beloved."},{"@type":"Question","name":"Grace","text":"What is given rather than earned."},{"@type":"Question","name":"Pure Land: other power","text":"Entrusting oneself to Amida Buddha."},{"@type":"Question","name":"Prayer and remembrance","text":"Centering prayer, the Jesus Prayer, dhikr."},{"@type":"Question","name":"Ritual, worship and initiation","text":"Pūjā, mantra, empowerment: devotion in form."},{"@type":"Question","name":"Surrender","text":"Letting go into something larger than oneself."}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/faith/bhakti","url":"https://tantrafiles.xyz/topic/faith/bhakti","name":"Bhakti (devotion)","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"faith/bhakti","broader":{"@id":"https://tantrafiles.xyz/topic/faith"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/faith/grace","url":"https://tantrafiles.xyz/topic/faith/grace","name":"Grace","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"faith/grace","broader":{"@id":"https://tantrafiles.xyz/topic/faith"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/faith/pure-land","url":"https://tantrafiles.xyz/topic/faith/pure-land","name":"Pure Land","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"faith/pure-land","broader":{"@id":"https://tantrafiles.xyz/topic/faith"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/faith/ritual","url":"https://tantrafiles.xyz/topic/faith/ritual","name":"Ritual, worship & initiation","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"faith/ritual","broader":{"@id":"https://tantrafiles.xyz/topic/faith"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/daily-life","url":"https://tantrafiles.xyz/topic/daily-life","name":"Everyday life","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"daily-life","hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/texts","url":"https://tantrafiles.xyz/topic/texts","name":"Reading the texts","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"texts","hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/texts/tantra","url":"https://tantrafiles.xyz/topic/texts/tantra","name":"The tantras","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"texts/tantra","broader":{"@id":"https://tantrafiles.xyz/topic/texts"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/consciousness","url":"https://tantrafiles.xyz/topic/consciousness","name":"Consciousness","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"consciousness","hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/consciousness/states","url":"https://tantrafiles.xyz/topic/consciousness/states","name":"Waking, dream & deep sleep","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"consciousness/states","broader":{"@id":"https://tantrafiles.xyz/topic/consciousness"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/reality","url":"https://tantrafiles.xyz/topic/reality","name":"Reality & illusion","description":"Not two. Advaita says the world is Brahman appearing as many; Kashmir Shaivism says it is consciousness recognising itself; Dzogchen and Zen point to a nature that was never divided; the philosophers of the sacred ask whether mind comes first. Here is nonduality, and the question of what is real.","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"reality","hasPart":[{"@type":"Question","name":"Nonduality","text":"Advaita, the direct path and modern nondual teachers."},{"@type":"Question","name":"Māyā: is the world an illusion?","text":"The rope and the snake."},{"@type":"Question","name":"Recognition: consciousness knowing itself","text":"Kashmir Shaivism's answer."},{"@type":"Question","name":"Does mind come first?","text":"Idealism and the philosophers of the sacred."},{"@type":"Question","name":"Emptiness and interbeing","text":"The Buddhist middle way between being and non-being."}],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/reality/maya","url":"https://tantrafiles.xyz/topic/reality/maya","name":"Maya","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"reality/maya","broader":{"@id":"https://tantrafiles.xyz/topic/reality"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/reality/nonduality","url":"https://tantrafiles.xyz/topic/reality/nonduality","name":"Nonduality","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"reality/nonduality","broader":{"@id":"https://tantrafiles.xyz/topic/reality"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/guru","url":"https://tantrafiles.xyz/topic/guru","name":"The guru","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"guru","hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/soul","url":"https://tantrafiles.xyz/topic/soul","name":"The soul","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"soul","hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/gnosis","url":"https://tantrafiles.xyz/topic/gnosis","name":"Gnosis","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"gnosis","hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/divine","url":"https://tantrafiles.xyz/topic/divine","name":"The divine","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"divine","hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/divine/the-one","url":"https://tantrafiles.xyz/topic/divine/the-one","name":"The One","inDefinedTermSet":"https://tantrafiles.xyz/topic/","termCode":"divine/the-one","broader":{"@id":"https://tantrafiles.xyz/topic/divine"},"hasPart":[],"license":"https://creativecommons.org/licenses/by/4.0/"},{"@type":["DefinedTerm","CollectionPage"],"@id":"https://tantrafiles.xyz/topic/divine/goddess","url":"https://tantrafiles.xyz/topic/divine/go