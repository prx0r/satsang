 ],
 "summary": "A short goodwill reflection from the Karaṇīya Metta Sutta: may all beings be happy at heart, whatever they are; let no one wish another to suffer; guard this goodwill as a mother guards her only child, and let it go out without limit, above, below and all around.",
 "steps": [
  {
   "n": 1,
   "text": "Any posture (standing, walking, sitting, lying down), as long as you are not drowsy.",
   "cue": "breath",
   "instr": [
    "i01"
   ]
  },
  {
   "n": 2,
   "text": "Think: happy, at rest, may all beings be happy at heart.",
   "cue": "breath",
   "instr": [
    "i02"
   ]
  },
  {
   "n": 3,
   "text": "Whatever beings there may be, weak or strong, seen or unseen, near or far, born or seeking birth: may all be happy at heart.",
   "cue": "breath",
   "instr": [
    "i03"
   ]
  },
  {
   "n": 4,
   "text": "Let no one deceive or despise another, or wish another to suffer.",
   "cue": "breath",
   "instr": [
    "i04"
   ]
  },
  {
   "n": 5,
   "text": "Guard this goodwill as a mother guards her only child.",
   "cue": "breath",
   "instr": [
    "i05"
   ]
  },
  {
   "n": 6,
   "text": "Goodwill for the entire cosmos, without limit: above, below, all around, without hostility or hate.",
   "cue": "breath",
   "instr": [
    "i06"
   ]
  }
 ],
