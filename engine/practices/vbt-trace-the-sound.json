  "id": "vbt-trace-the-sound",
  "name": "Trace the Sound",
  "kind": "meditation",
  "subkind": "dharana",
  "traditions": [
    "kashmir-shaivism-trika"
  ],
  "summary": "A two-minute play. Pick any sound, follow it inward and let it fade on its own. When the line goes flat, rest in what is left. The voice speaks, then stops: the pause is the practice. Repeat it through the day on different sounds.",
  "steps": [
    {
      "n": 1,
      "text": "Pick a sound that is already here: the room, a fan, traffic, your own breath.",
      "cue": "voice",
      "visual": "wave: bright, answering the voice"
    },
    {
      "n": 2,
      "text": "Follow it inward until it is only a vibration, not a thing out there.",
      "cue": "voice",
      "visual": "wave narrows toward the head; particles travel in"
    },
    {
      "n": 3,
      "text": "Let it fade the way sounds fade. You are not making it stop.",
      "cue": "silent",
      "visual": "wave dims"
    },
    {
      "n": 4,
      "text": "Notice that you cannot force quiet, and cannot stop trying either.",
      "cue": "voice"
    },
    {
      "n": 5,
      "text": "When the line is flat, rest in the silence for as long as it lasts. Tap when you are back.",
      "cue": "silent",
      "visual": "flat line + rest timer"
    }
  ],
  "duration": {
    "min": 2,
    "max": 3,
    "default": 2.7
  },
  "level": "first-steps",
  "posture": "any",
  "eyes": "either",
  "needsTeacher": false,
  "contraindications": [
    "If silence brings up distress, dizziness or a sense of unreality, open your eyes, feel your feet, and stop for today.",
    "This is a short attention play, not the full teaching. Learn the rest of the Vijnana Bhairava practices from a qualified teacher."
  ],
