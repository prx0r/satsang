{
 "type": "practice",
 "schema_version": 2,
 "id": "ajahn-lee-method-2",
 "name": "Seven steps · Ajahn Lee, Method 2",
 "kind": "meditation",
 "subkind": "breath",
 "traditions": [
  "theravada-thai-forest"
 ],
 "summary": "Ajaan Lee’s seven basic steps: a few long breaths with bud-dho, clear awareness of each breath, finding a comfortable breath and letting it spread from the base of the skull down the spine, legs and arms and down the front of the body, exploring ways of breathing, getting to know the resting spots of the breath, then letting breath and awareness fill the whole body.",
 "steps": [
  {
   "n": 1,
   "text": "Three (or seven) long breaths: bud on the in-breath, dho on the out, the word as long as the breath.",
   "cue": "breath",
   "instr": [
    "i01",
    "i02"
   ]
  },
  {
   "n": 2,
   "text": "Be clearly aware of each in-and-out breath.",
   "cue": "breath",
   "instr": [
    "i03"
   ]
  },
  {
   "n": 3,
   "text": "Observe the breath: comfortable or not, broad or narrow, fast or slow, short or long, warm or cool. Adjust it until it is comfortable.",
   "cue": "breath",
   "instr": [
    "i04",
    "i05"
   ]
  },
  {
   "n": 4,
   "text": "Let the comfortable breath spread: from the base of the skull down the spine, down each leg and out past the toes, over the shoulders and out through the fingertips; from the base of the throat down the front of the body; from the middle of the chest down to the belly. Let it all connect.",
   "cue": "breath",
   "instr": [
    "i06",
    "i07",
    "i08",
    "i09",
    "i10",
    "i11",
    "i12"
   ]
  },
  {
   "n": 5,
   "text": "Explore ways of breathing (long/short in and out) and breathe whichever way is most comfortable.",
   "cue": "breath",
   "instr": [
    "i13"
   ]
  },
  {
   "n": 6,
   "text": "Get to know the resting spots: tip of the nose, middle of the head, palate, base of the throat, breastbone, navel. Rest on whichever is most comfortable. Breathe freely and naturally; don’t force.",
   "cue": "breath",
   "instr": [
    "i15",
    "i16",
    "i17",
    "i18",
    "i19",
    "i20",
    "i21",
    "i22",
    "i23"
   ]
  },
  {
   "n": 7,
   "text": "Spread awareness through the entire body; let the breath sensations flow together, awareness as broad as possible.",
   "cue": "breath",
   "instr": [
    "i25",
    "i26"
   ]
  }
 ],
 "level": "first-steps",
 "posture": "seated",
 "eyes": "closed",
 "needsTeacher": false,
 "contraindications": [
  "Frequent headaches or nervous problems: don’t focus on any spot above the base of the throat (Ajaan Lee). The beginner form leaves out the head spots.",
  "Don’t force the breath or put yourself into a trance. Breathe freely and naturally."
 ],
