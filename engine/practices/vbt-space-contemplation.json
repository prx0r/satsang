   "n": 1,
   "text": "Notice the space of the room around you, holding the walls and your body.",
   "cue": "breath",
   "instr": [
    "i01"
   ]
  },
  {
   "n": 2,
   "text": "Sense the space inside the body: the chest, the mouth, the skull.",
   "cue": "breath",
   "instr": [
    "i02",
    "i03",
    "i04"
   ]
  },
  {
   "n": 3,
   "text": "Feel the skin as a thin wall, open space within and without.",
   "cue": "breath",
   "instr": [
    "i05"
   ]
  },
  {
   "n": 4,
   "text": "Let inner and outer space be one field; rest in that openness. When the mind reaches for something solid, return to space. Stay alert.",
   "cue": "breath",
   "instr": [
    "i06",
    "i07",
    "i08"
   ]
  }
 ],
