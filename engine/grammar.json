  },
  "phases": {
    "in":       { "label": "Inhale",      "volume": "0→1", "ease": "inOutSine" },
    "hold_in":  { "label": "Hold",        "volume": "1",   "ease": "linear", "note": "antara kumbhaka" },
    "out":      { "label": "Exhale",      "volume": "1→0", "ease": "inOutSine" },
    "hold_out": { "label": "Hold out",    "volume": "0",   "ease": "linear", "note": "bahya kumbhaka" },
    "natural":  { "label": "Breathe naturally", "volume": "suggested sine (in 5 s, out 6 s), drawn faint", "ease": "inOutSine" },
    "rest":     { "label": "Rest",        "volume": "free", "ease": "linear" }
  },
  "easings": {
    "linear": "p", "inOutSine": "0.5 - 0.5*cos(pi*p)", "outQuad": "1-(1-p)^2", "inQuad": "p^2", "outExpo": "1-2^(-10p)"
  },
  "primitives": {
    "locus":     { "addr": "loci.<id>", "does": "a named point of attention; marker + optional label + halo" },
    "path":      { "addr": "paths.<id>", "does": "flow along a curve between loci; arc-length parameterised (deitybody paths.js)", "modes": ["fill", "drain", "stream"] },
    "field":     { "addr": "regions.<id>", "does": "diffuse spread over a region or the whole body (deitybody mechanism field-suffusion)", "params": ["from (origin locus for expand)", "density"] },
    "attention": { "addr": "loci.<id> | regions.<id>", "does": "focus spotlight with dimmed periphery", "sizes": { "narrow": 0.32, "medium": 0.72, "wide": 1.6, "whole": 99 } }
  },
  "motions": {
    "flow":       { "on": ["path"], "breath": { "in": "fill (channel fills from its source to the breath front)", "out": "drain (column leaves through the far end, spray at an 'air' exit)" }, "deitybody": "nadi-flow", "operator": "procession" },
    "fill":       { "on": ["field", "locus"], "breath": { "in": "intensity 0→1" }, "operator": "appear" },
    "hold-glow":  { "on": ["locus", "path", "field"], "breath": { "hold_in": "steady halo, pressure shimmer grows with time held", "hold_out": "dim ember, stillness" }, "operator": "suspend" },
    "dissipate":  { "on": ["field", "path", "locus"], "breath": { "out": "intensity 1→0, particles drift outward and cool to smoke" }, "operator": "dissolve" },
    "expand":     { "on": ["field", "attention"], "breath": { "in": "front radius grows from the origin", "natural": "front grows over the whole cue" }, "deitybody": "field-suffusion", "operator": "expand" },
    "contract":   { "on": ["field", "attention"], "breath": { "out": "front radius shrinks toward the origin" }, "operator": "contract" },
    "rise":       { "on": ["path"], "breath": { "in": "flow upward along the central line" }, "deitybody": "kundalini-ascent" },
    "pulse":      { "on": ["locus"], "breath": { "out": "one impulse per stroke: ring + particle kick" }, "operator": "pulse" },
    "rotate":     { "on": ["locus"], "breath": { "*": "petal ring turns slowly (chakra)" }, "deitybody": "yantra-install" },
    "vibrate":    { "on": ["field"], "breath": { "out": "radial standing wave + ripples (sound)" }, "deitybody": "wave-interference" },
    "steady":     { "on": ["field", "locus", "path"], "breath": { "natural": "gentle glow that breathes with the volume" }, "operator": "rest" }
  },
  "verbs": {
    "draw":           { "to": { "prim": "path", "motion": "flow", "mode": "fill" }, "phase": "in",  "e.g.": "draw the breath up the left channel" },
    "inhale":         { "to": { "prim": "path", "motion": "flow", "mode": "fill" }, "phase": "in" },
    "send":           { "to": { "prim": "path", "motion": "flow", "mode": "fill" }, "e.g.": "send the current down the spine" },
    "hold":           { "to": { "prim": "locus", "motion": "hold-glow" }, "phase": "hold_in" },
    "retain":         { "to": { "prim": "locus", "motion": "hold-glow" }, "phase": "hold_in" },
    "release":        { "to": { "prim": "path", "motion": "flow", "mode": "drain" }, "phase": "out" },
    "exhale":         { "to": { "prim": "path", "motion": "flow", "mode": "drain" }, "phase": "out" },
    "spread":         { "to": { "prim": "field", "motion": "expand" }, "e.g.": "let the breath spread from the breastbone" },
    "let_flow":       { "to": { "prim": "path", "motion": "flow", "mode": "stream" }, "e.g.": "let it flow down the arms" },
    "fill":           { "to": { "prim": "field", "motion": "fill" } },
    "dissolve":       { "to": { "prim": "field", "motion": "dissipate" } },
    "rest_attention": { "to": { "prim": "attention" }, "e.g.": "rest attention inside the skull" },
    "fix":            { "to": { "prim": "attention", "size": "narrow" }, "e.g.": "fix the gaze at the tip of the nose" },
    "feel":           { "to": { "prim": "locus", "motion": "steady", "with_attention": "medium" } },
    "rise":           { "to": { "prim": "path", "motion": "rise" } },
    "hum":            { "to": { "prim": "field", "motion": "vibrate" }, "phase": "out" },
    "expel":          { "to": { "prim": "locus", "motion": "pulse" }, "phase": "out" },
    "unite":          { "to": { "prim": "field", "motion": "steady", "region": "whole_body" } }
  },
  "safety": {
    "player_enforced": true,
    "max_hold_s": 30,
    "beginner": { "use": "practice.safety.beginner_override if present", "strip_holds_over_s": 10 },
    "always": "Stop is always one key away. No competitive breath-holding (deitybody ARCHITECTURE)."
  },
  "audio": {
    "_note": "PRACTICE-MEDIA §1 sound vocabulary. Timeline audio events name a sound id; the player plays the practice's rendered kit (renders/<id>/cues/<id>.mp3) when present, else its WebAudio synth fallback. Levels: cues sit 18-24 dB under the voice.",
    "bowl-start": { "event": "session start", "desc": "singing bowl strike, long tail", "synth": { "f0": 196, "partials": [1, 2.76, 5.4, 8.93], "decay_s": 9 } },
    "bell-end":   { "event": "session end", "desc": "two bowl strikes", "synth": { "f0": 174.6, "strikes": 2 } },
    "bell-soft":  { "event": "round end (legacy)", "desc": "soft bell", "synth": { "f0": 528 } },
    "chime":      { "event": "stage change / round end", "desc": "tiny chime (earshot pluck/kalimba_soft E6)", "synth": { "f0": 1318.5 } },
    "tick":       { "event": "phase change (off by default)", "desc": "soft wooden tick", "synth": { "f0": 900, "dur_s": 0.05 } },
    "warn":       { "event": "safety stop", "desc": "distinct two-tone, never used elsewhere", "synth": { "tones": [660, 440] } }
  }
}
