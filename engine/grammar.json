    "arm_R":      { "pts": [[0,2.28],[-0.32,1.5],[-1.02,1.2],[-1.3,0.4],[-1.42,-0.3],[-1.62,-1.1],[-1.74,-1.62],[-2.04,-1.98]], "colour": "breath", "exit": "air" },
    "leg_L":      { "pts": [[0,-1.6],[0.62,-1.75],[1.3,-1.95],[1.95,-2.12],[1.0,-2.2],[0.1,-2.1],[-0.66,-1.92]], "colour": "breath", "exit": "air" },
    "leg_R":      { "pts": [[0,-1.6],[-0.62,-1.75],[-1.3,-1.95],[-1.95,-2.12],[-1.0,-2.2],[-0.1,-2.1],[0.66,-1.92]], "colour": "breath", "exit": "air" },
