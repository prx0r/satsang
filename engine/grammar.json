    "ida": { "pts": [[0.07,2.45],[0.07,2.62],[0,2.74],[-0.17,2.28],[0,1.74],[0.3,1.25],[0,0.78],[-0.32,-0.06],[0,-0.9],[0.26,-1.18],[0,-1.45],[-0.15,-1.7],[0,-1.92]],
             "colour": "lunar", "show": "channel", "label": "iḍā", "dir": "nostril→base", "from": "deitybody nadis-ten ida, re-drawn as the crossing helix, mirror-correct" },
    "pingala": { "pts": [[-0.07,2.45],[-0.07,2.62],[0,2.74],[0.17,2.28],[0,1.74],[-0.3,1.25],[0,0.78],[0.32,-0.06],[0,-0.9],[-0.26,-1.18],[0,-1.45],[0.15,-1.7],[0,-1.92]],
             "colour": "solar", "show": "channel", "label": "piṅgalā", "dir": "nostril→base" },
    "spine":      { "pts": [[0,2.28],[0,1.5],[0,0.4],[0,-0.9],[0,-1.92]], "colour": "breath", "label": "down the spine" },
