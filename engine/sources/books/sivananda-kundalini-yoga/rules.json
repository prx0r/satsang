   "passage_ids": [
    "s066-kapalabhati:p2.s11",
    "s066-kapalabhati:p2.s12"
   ],
   "quote": {
    "text": "To start with, have only one expulsion per second. In the beginning do 10 expulsions per round",
    "cite": "s066-kapalabhati:p2.s11"
   }
  },
  {
   "id": "sukha-purvaka-build",
   "paraphrase": "Sukha Purvaka: 6 rounds morning and evening to start, rising to 20.",
   "scope": [
    "sukha-purvaka"
   ],
   "severity": "guidance",
   "sources": [
    {
     "section": "s071-sukha-purvaka",
