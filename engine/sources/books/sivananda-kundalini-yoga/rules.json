   "passage_ids": [
    "s071-sukha-purvaka:p3.s1",
    "s072-bhastrika:p2.s2"
   ],
   "quote": {
    "text": "Be careful in doing the Kumbhaka as long as you can comfortably do",
    "cite": "s071-sukha-purvaka:p3.s1"
   }
  },
  {
   "id": "smooth-exhale-after-hold",
   "paraphrase": "Only hold as long as you can still exhale smoothly and in proportion afterwards; do not over-lengthen the exhale either.",
   "scope": [
    "pranayama"
   ],
   "severity": "caution",
   "sources": [
