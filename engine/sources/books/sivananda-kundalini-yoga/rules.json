    "s080-instructions-on-pranayama:p4.s3"
   ],
   "quote": {
    "text": "Some people twist the muscles of the face when they do Kumbhaka",
    "cite": "s080-instructions-on-pranayama:p4.s1"
   }
  },
  {
   "id": "no-suffocation",
   "paraphrase": "Set inhale, hold and exhale so there is never suffocation and no need for recovery breaths between rounds; a gasp means the hold was too long.",
   "scope": [
    "pranayama"
   ],
   "severity": "hard-stop",
   "sources": [
    {
     "section": "s080-instructions-on-pranayama",
     "passages": [
      "s080-instructions-on-pranayama:p17.s1"
     ],
     "start": 4086,
     "end": 4178
    },
    {
     "section": "s080-instructions-on-pranayama",
     "passages": [
      "s080-instructions-on-pranayama:p17.s2"
     ],
     "start": 4180,
     "end": 4290
    }
   ],
   "passage_ids": [
    "s080-instructions-on-pranayama:p17.s1",
    "s080-instructions-on-pranayama:p17.s2"
   ],
   "quote": {
    "text": "you should not experience the feeling of suffocation or discomfort at any stage of Pranayama",
    "cite": "s080-instructions-on-pranayama:p17.s1"
   }
  },
  {
   "id": "no-fatigue",
   "paraphrase": "Stop before tiredness; finish refreshed.",
   "scope": [
    "pranayama"
   ],
   "severity": "caution",
   "sources": [
    {
     "section": "s080-instructions-on-pranayama",
     "passages": [
