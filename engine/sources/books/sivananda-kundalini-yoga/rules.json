    }
   ],
   "passage_ids": [
    "s080-instructions-on-pranayama:p9.s1"
   ],
   "quote": {
    "text": "Do not perform the Pranayama till you are fatigued",
    "cite": "s080-instructions-on-pranayama:p9.s1"
   }
  },
  {
   "id": "beginners-no-kumbhaka",
   "paraphrase": "Beginners breathe in and out only (exhale twice the inhale, 1:2) for some days before any hold. This is the beginner form of every retention practice.",
   "scope": [
    "pranayama"
   ],
   "severity": "hard-stop",
   "sources": [
    {
     "section": "s080-instructions-on-pranayama",
     "passages": [
      "s080-instructions-on-pranayama:p14.s1"
     ],
     "start": 3359,
     "end": 3438
    },
    {
     "section": "s080-instructions-on-pranayama",
     "passages": [
      "s080-instructions-on-pranayama:p14.s3"
     ],
     "start": 3472,
     "end": 3516
    }
   ],
   "passage_ids": [
    "s080-instructions-on-pranayama:p14.s1",
    "s080-instructions-on-pranayama:p14.s3"
   ],
   "quote": {
    "text": "A neophyte should do Puraka and Rechaka only without any Kumbhaka for some days",
    "cite": "s080-instructions-on-pranayama:p14.s1"
   }
  },
  {
   "id": "kumbhaka-weekly-build",
   "paraphrase": "Build the hold slowly: about 4 s in week one, 8 s in week two, 12 s in week three, then gradually. The engine's 30 s cap still applies.",
   "scope": [
    "pranayama"
   ],
   "severity": "caution",
   "sources": [
    {
     "section": "s080-instructions-on-pranayama",
     "passages": [
      "s080-instructions-on-pranayama:p16.s2"
     ],
     "start": 3835,
     "end": 3944
    }
   ],
   "passage_ids": [
    "s080-instructions-on-pranayama:p16.s2"
   ],
   "quote": {
    "text": "Retain for 4 seconds in the first week, for 8 seconds in the second week and for 12 seconds in the third week",
    "cite": "s080-instructions-on-pranayama:p16.s2"
   }
  },
  {
   "id": "comfortable-hold",
   "paraphrase": "Hold only as long as is comfortable and increase it cautiously.",
   "scope": [
    "pranayama"
   ],
   "severity": "caution",
   "sources": [
    {
