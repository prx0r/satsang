   "passage_ids": [
    "s071-sukha-purvaka:p2.s13"
   ],
   "quote": {
    "text": "To start with do 6 Pranayamas in the morning and 6 in the evening",
    "cite": "s071-sukha-purvaka:p2.s13"
   }
  },
