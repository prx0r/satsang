   "passage_ids": [
    "s080-instructions-on-pranayama:p18.s7"
   ],
   "quote": {
    "text": "you must have efficient control over the lungs at the end of Kumbhaka",
    "cite": "s080-instructions-on-pranayama:p18.s7"
   }
  },
  {
   "id": "slow-silent-breath",
   "paraphrase": "Breathe slowly and quietly; bhastrika and kapalabhati may make a soft sound (ujjayi's throat sound is the book's own exception).",
