   ],
   "quote": {
    "text": "take a cup of milk or light tiffin after 10 minutes",
    "cite": "s080-instructions-on-pranayama:p2.s2"
   }
  },
  {
   "id": "bhastrika-build",
   "paraphrase": "Bhastrika starts at 10 breaths a round and 3 rounds with rest between; build slowly.",
