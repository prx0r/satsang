   "passage_ids": [
    "s080-instructions-on-pranayama:p2.s1"
   ],
   "quote": {
    "text": "Before you sit for Pranayama practice, thoroughly clean the nostrils",
    "cite": "s080-instructions-on-pranayama:p2.s1"
   }
  },
  {
   "id": "fifteen-minutes-daily",
   "paraphrase": "Beginners: at least 15 minutes a day, regularly; results are not instant.",
   "scope": [
    "pranayama"
   ],
   "severity": "guidance",
   "sources": [
    {
     "section": "s080-instructions-on-pranayama",
     "passages": [
      "s080-instructions-on-pranayama:p12.s2"
     ],
     "start": 2860,
     "end": 2954
    }
   ],
   "passage_ids": [
    "s080-instructions-on-pranayama:p12.s2"
   ],
   "quote": {
    "text": "At least you must have 15 minutes’ daily practice in the beginning regularly for days together",
    "cite": "s080-instructions-on-pranayama:p12.s2"
   }
  },
  {
   "id": "after-practice",
   "paraphrase": "Light food about 10 minutes after; rub sweat in by hand; avoid cold draughts.",
   "scope": [
    "pranayama"
   ],
   "severity": "traditional",
   "sources": [
    {
     "section": "s080-instructions-on-pranayama",
