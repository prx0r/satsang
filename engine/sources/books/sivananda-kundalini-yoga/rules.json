    }
   ],
   "passage_ids": [
    "s080-instructions-on-pranayama:p6.s4"
   ],
   "quote": {
    "text": "The Asana should be steady and as firm as a rock when you do Pranayama, Japa and meditation",
    "cite": "s080-instructions-on-pranayama:p6.s4"
   }
  },
  {
   "id": "clean-nostrils",
   "paraphrase": "Clear the nostrils before practice.",
   "scope": [
    "pranayama"
   ],
   "severity": "guidance",
   "sources": [
