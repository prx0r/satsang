   "passage_ids": [
    "s071-sukha-purvaka:p2.s15"
   ],
   "quote": {
    "text": "The ratio of inhalation, retention and exhalation is 1:4:2",
    "cite": "s071-sukha-purvaka:p2.s15"
   }
  },
