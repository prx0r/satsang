    }
   ],
   "passage_ids": [
    "s136-hints-on-yoga:p44.s2"
   ],
   "quote": {
    "text": "Do not take the movements of rheumatic winds in the back from chronic lumbago for ascent of Kundalini",
    "cite": "s136-hints-on-yoga:p44.s2"
   }
  },
  {
   "id": "reject-siddhis",
   "paraphrase": "Powers are distractions to be ignored; never offer them as goals or narrate them.",
