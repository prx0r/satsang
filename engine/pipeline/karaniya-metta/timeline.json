  "voice": [
   {
    "t": 6,
    "dur": 8,
    "text": "Standing, walking, sitting or lying down: any posture, as long as you are not drowsy.",
    "say": "Standing, walking, sitting or lying down: any posture, as long as you are not drowsy.",
    "once": false,
    "block": "i01",
    "stage": "posture"
   },
   {
    "t": 14,
    "dur": 5,
    "text": "Think: happy, at rest, may all beings be happy at heart.",
    "say": "Think: happy, at rest, may all beings be happy at heart.",
    "once": false,
    "block": "i02.b1.in",
    "quote": {
     "text": "may all beings be happy at heart.",
     "cite": "The Buddha (Pali Canon), Karaṇīya Metta Sutta: Goodwill (Sn 1:8 = Khp 9), snp1-8:p13.s1 (tr. Ṭhānissaro Bhikkhu)"
    },
    "stage": "wishes"
   },
   {
    "t": 36,
    "dur": 5,
    "text": "Whatever beings there may be, weak or strong, seen or unseen, near or far, born or seeking birth: may all beings be happy at heart.",
    "say": "Whatever beings there may be, weak or strong, seen or unseen, near or far, born or seeking birth: may all beings be happy at heart.",
    "once": false,
    "block": "i03.b1.in",
    "stage": "wishes"
   },
   {
    "t": 58,
    "dur": 5,
    "text": "Let no one deceive another, or despise anyone anywhere, or wish for another to suffer.",
    "say": "Let no one deceive another, or despise anyone anywhere, or wish for another to suffer.",
    "once": false,
    "block": "i04.b1.in",
    "stage": "wishes"
   },
   {
    "t": 80,
    "dur": 5,
    "text": "As a mother would protect her only child, protect this goodwill toward all beings.",
    "say": "As a mother would protect her only child, protect this goodwill toward all beings.",
    "once": false,
    "block": "i05.b1.in",
    "quote": {
     "text": "One should protect one’s goodwill toward all beings in the same way that a mother would protect her only child.",
     "cite": "The Buddha (Pali Canon), Karaṇīya Metta Sutta: Goodwill (Sn 1:8 = Khp 9), snp1-8:p48.s2 (tr. Ṭhānissaro Bhikkhu)"
    },
    "stage": "wishes"
   },
   {
    "t": 102,
    "dur": 5,
    "text": "With goodwill for the entire cosmos, let the heart go out without limit: above, below, and all around.",
    "say": "With goodwill for the entire cosmos, let the heart go out without limit: above, below, and all around.",
    "once": false,
    "block": "i06.b1.in",
    "stage": "limitless"
   }
  ],
