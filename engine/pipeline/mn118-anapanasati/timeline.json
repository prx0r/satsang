  "voice": [
   {
    "t": 6,
    "dur": 10.1,
    "text": "Sit with your legs crossed, or in any steady seat. Hold the body erect, and bring mindfulness to the fore.",
    "say": "Sit with your legs crossed, or in any steady seat. Hold the body erect, and bring mindfulness to the fore.",
    "once": false,
    "block": "i01",
    "stage": "sitting"
   },
   {
    "t": 16.1,
    "dur": 5,
    "text": "Always mindful, breathe in. Mindful, breathe out.",
    "say": "Always mindful, breathe in. Mindful, breathe out.",
    "once": false,
    "block": "i02.b1.in",
    "stage": "sitting"
   },
   {
    "t": 49.1,
    "dur": 5,
    "text": "When the breath is long, discern: I am breathing in long… I am breathing out long.",
    "say": "When the breath is long, discern: I am breathing in long… I am breathing out long.",
    "once": false,
    "block": "i03.b1.in",
    "quote": {
     "text": "Breathing in long, he discerns, ‘I am breathing in long’",
     "cite": "The Buddha (Pali Canon), Ānāpānasati Sutta: Mindfulness of Breathing (MN 118), mn118:p18.s1 (tr. Ṭhānissaro Bhikkhu)"
    },
    "stage": "body"
   },
   {
    "t": 82.1,
    "dur": 5,
    "text": "When it is short, discern: I am breathing in short… breathing out short.",
    "say": "When it is short, discern: I am breathing in short… breathing out short.",
    "once": false,
    "block": "i04.b1.in",
    "stage": "body"
   },
   {
    "t": 115.1,
    "dur": 5,
    "text": "Breathe in sensitive to the entire body. Breathe out sensitive to the entire body.",
    "say": "Breathe in sensitive to the entire body. Breathe out sensitive to the entire body.",
    "once": false,
    "block": "i05.b1.in",
    "stage": "body"
   },
   {
    "t": 148.1,
    "dur": 5,
    "text": "Breathe in calming bodily fabrication, the breath itself. Breathe out, calming it.",
    "say": "Breathe in calming bodily fabrication, the breath itself. Breathe out, calming it.",
    "once": false,
    "block": "i06.b1.in",
    "quote": {
     "text": "in-&-out breaths are bodily fabrications",
     "cite": "The Buddha (Pali Canon), Ānāpānasati Sutta: Mindfulness of Breathing (MN 118), mn118:p45.s2 (tr. Ṭhānissaro Bhikkhu)"
    },
    "stage": "body"
   },
   {
    "t": 181.1,
    "dur": 5,
    "text": "Breathe in sensitive to rapture. Breathe out sensitive to rapture.",
    "say": "Breathe in sensitive to rapture. Breathe out sensitive to rapture.",
    "once": false,
    "block": "i07.b1.in",
    "stage": "feelings"
   },
   {
    "t": 214.1,
    "dur": 5,
    "text": "Breathe in sensitive to pleasure. Breathe out sensitive to pleasure.",
    "say": "Breathe in sensitive to pleasure. Breathe out sensitive to pleasure.",
    "once": false,
    "block": "i08.b1.in",
    "stage": "feelings"
   },
   {
    "t": 247.1,
    "dur": 5,
    "text": "Breathe in sensitive to mental fabrication: perceptions and feelings. Breathe out, sensitive to them.",
    "say": "Breathe in sensitive to mental fabrication: perceptions and feelings. Breathe out, sensitive to them.",
    "once": false,
    "block": "i09.b1.in",
    "stage": "feelings"
   },
   {
    "t": 280.1,
    "dur": 5,
    "text": "Breathe in calming mental fabrication. Breathe out calming mental fabrication.",
    "say": "Breathe in calming mental fabrication. Breathe out calming mental fabrication.",
    "once": false,
    "block": "i10.b1.in",
    "stage": "feelings"
   },
   {
    "t": 313.1,
    "dur": 5,
    "text": "Breathe in sensitive to the mind. Breathe out sensitive to the mind.",
    "say": "Breathe in sensitive to the mind. Breathe out sensitive to the mind.",
    "once": false,
    "block": "i11.b1.in",
    "stage": "mind"
   },
   {
    "t": 346.1,
    "dur": 5,
    "text": "Breathe in gladdening the mind. Breathe out gladdening the mind.",
    "say": "Breathe in gladdening the mind. Breathe out gladdening the mind.",
    "once": false,
    "block": "i12.b1.in",
    "stage": "mind"
   },
   {
    "t": 379.1,
    "dur": 5,
    "text": "Breathe in concentrating the mind. Breathe out concentrating the mind.",
    "say": "Breathe in concentrating the mind. Breathe out concentrating the mind.",
    "once": false,
    "block": "i13.b1.in",
    "stage": "mind"
   },
   {
    "t": 412.1,
    "dur": 5,
    "text": "Breathe in releasing the mind. Breathe out releasing the mind.",
    "say": "Breathe in releasing the mind. Breathe out releasing the mind.",
    "once": false,
    "block": "i14.b1.in",
    "stage": "mind"
   },
   {
    "t": 445.1,
    "dur": 5,
    "text": "Breathe in focusing on inconstancy. Breathe out focusing on inconstancy.",
    "say": "Breathe in focusing on inconstancy. Breathe out focusing on inconstancy.",
    "once": false,
    "block": "i15.b1.in",
    "stage": "qualities"
   },
   {
    "t": 478.1,
    "dur": 5,
    "text": "Breathe in focusing on dispassion, on fading. Breathe out the same.",
    "say": "Breathe in focusing on dispassion, on fading. Breathe out the same.",
    "once": false,
    "block": "i16.b1.in",
    "stage": "qualities"
   },
   {
    "t": 511.1,
    "dur": 5,
    "text": "Breathe in focusing on cessation. Breathe out focusing on cessation.",
    "say": "Breathe in focusing on cessation. Breathe out focusing on cessation.",
    "once": false,
    "block": "i17.b1.in",
    "stage": "qualities"
   },
   {
    "t": 544.1,
    "dur": 5,
    "text": "Breathe in focusing on relinquishing. Breathe out focusing on relinquishing.",
    "say": "Breathe in focusing on relinquishing. Breathe out focusing on relinquishing.",
    "once": false,
    "block": "i18.b1.in",
    "stage": "qualities"
   }
