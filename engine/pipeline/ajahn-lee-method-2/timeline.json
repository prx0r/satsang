    "quote": {
     "text": "Start out with three or seven long in-and-out breaths",
     "cite": "Ajaan Lee Dhammadharo, Keeping the Breath in Mind, method-2:p2.s1 (tr. Ṭhānissaro Bhikkhu)"
    },
    "stage": "long-breaths"
   },
   {
    "t": 39,
    "dur": 5,
    "text": "Keep the word as long as the breath.",
    "say": "Keep the word as long as the breath.",
    "once": false,
    "block": "i02.g.in",
    "stage": "long-breaths"
   },
   {
    "t": 50,
    "dur": 5,
    "text": "Now simply be clearly aware of each breath, in and out.",
    "say": "Now simply be clearly aware of each breath, in and out.",
    "once": false,
    "block": "i03.in",
    "stage": "aware"
   },
   {
    "t": 94,
    "dur": 5,
    "text": "Observe the breath. Is it comfortable or not? Broad or narrow? Fast or slow, short or long, warm or cool?",
    "say": "Observe the breath. Is it comfortable or not? Broad or narrow? Fast or slow, short or long, warm or cool?",
    "once": false,
    "block": "i04.in",
    "stage": "observe"
   },
   {
    "t": 138,
    "dur": 5,
    "text": "If it doesn’t feel comfortable, adjust it until it does. If long breathing feels wrong, try short.",
    "say": "If it doesn’t feel comfortable, adjust it until it does. If long breathing feels wrong, try short.",
    "once": false,
    "block": "i05.g.in",
    "stage": "observe"
   },
   {
    "t": 149,
    "dur": 5,
    "text": "When the breath feels comfortable, breathe in at the base of the skull and let it flow down the spine.",
    "say": "When the breath feels comfortable, breathe in at the base of the skull and let it flow down the spine.",
    "once": false,
    "block": "i06.in",
    "stage": "spread"
   },
   {
    "t": 160,
    "dur": 5,
    "text": "In at the base of the skull again… down the right leg, to the toes, and out into the air.",
    "say": "In at the base of the skull again… down the right leg, to the toes, and out into the air.",
    "once": false,
    "block": "i07.in",
    "stage": "spread"
   },
   {
    "t": 171,
    "dur": 5,
    "text": "Again from the base of the skull: down the spine, down the left leg, out past the toes.",
    "say": "Again from the base of the skull: down the spine, down the left leg, out past the toes.",
    "once": false,
    "block": "i08.in",
    "stage": "spread"
   },
   {
    "t": 182,
    "dur": 5,
    "text": "From the base of the skull over both shoulders, down the arms, and out through the fingertips.",
    "say": "From the base of the skull over both shoulders, down the arms, and out through the fingertips.",
    "once": false,
    "block": "i09.in",
    "stage": "spread"
   },
   {
    "t": 193,
    "dur": 5,
    "text": "From the base of the throat, down the front of the body, all the way to the belly.",
    "say": "From the base of the throat, down the front of the body, all the way to the belly.",
    "once": false,
    "block": "i10.in",
    "stage": "spread"
   },
   {
    "t": 204,
    "dur": 5,
    "text": "Breathe in at the middle of the chest and let it go all the way down to the belly.",
    "say": "Breathe in at the middle of the chest and let it go all the way down to the belly.",
    "once": false,
    "block": "i11.in",
    "stage": "spread"
   },
   {
    "t": 215,
    "dur": 5,
    "text": "Let all these breath sensations connect and flow together.",
    "say": "Let all these breath sensations connect and flow together.",
    "once": false,
    "block": "i12.b1.in",
    "stage": "spread"
   },
   {
    "t": 237,
    "dur": 5,
    "text": "Explore: in long, out long… in long, out short… in short, out long… in short, out short. Then breathe whichever way is most comfortable.",
    "say": "Explore: in long, out long… in long, out short… in short, out long… in short, out short. Then breathe whichever way is most comfortable.",
    "once": false,
    "block": "i13.in",
    "quote": {
     "text": "Breathe whichever way is most comfortable for you.",
     "cite": "Ajaan Lee Dhammadharo, Keeping the Breath in Mind, method-2:p15.s1 (tr. Ṭhānissaro Bhikkhu)"
    },
    "stage": "ways"
   },
   {
    "t": 281,
    "dur": 5,
    "text": "Get to know the resting spots of the breath. The tip of the nose.",
    "say": "Get to know the resting spots of the breath. The tip of the nose.",
    "once": false,
    "block": "i15.in",
    "stage": "bases-head"
   },
   {
    "t": 292,
    "dur": 5,
    "text": "The middle of the head.",
    "say": "The middle of the head.",
    "once": false,
    "block": "i16.in",
    "stage": "bases-head"
   },
   {
    "t": 303,
    "dur": 5,
    "text": "The palate.",
    "say": "The palate.",
    "once": false,
    "block": "i17.in",
    "stage": "bases-head"
   },
   {
    "t": 314,
    "dur": 5,
    "text": "The base of the throat.",
    "say": "The base of the throat.",
    "once": false,
    "block": "i18.in",
    "stage": "bases-body"
   },
   {
    "t": 325,
    "dur": 5,
    "text": "The breastbone, at the tip of the sternum.",
    "say": "The breastbone, at the tip of the sternum.",
    "once": false,
    "block": "i19.in",
    "stage": "bases-body"
   },
   {
    "t": 336,
    "dur": 5,
    "text": "The navel, or just above it.",
    "say": "The navel, or just above it.",
    "once": false,
    "block": "i20.in",
    "stage": "bases-body"
   },
   {
    "t": 347,
    "dur": 5,
    "text": "Now center your awareness on whichever spot feels most comfortable.",
    "say": "Now center your awareness on whichever spot feels most comfortable.",
    "once": false,
    "block": "i21.in",
    "stage": "resting"
   },
   {
    "t": 391,
    "dur": 5,
    "text": "Don’t force the breath. Breathe freely and naturally.",
    "say": "Don’t force the breath. Breathe freely and naturally.",
    "once": false,
    "block": "i22.g.in",
    "stage": "resting"
   },
   {
    "t": 402,
    "dur": 5,
    "text": "Let the mind be at ease with the breath, but not so much that it slips away.",
    "say": "Let the mind be at ease with the breath, but not so much that it slips away.",
    "once": false,
    "block": "i23.g.in",
    "stage": "resting"
   },
   {
    "t": 413,
    "dur": 5,
    "text": "Spread your awareness, your sense of feeling, throughout the entire body.",
    "say": "Spread your awareness, your sense of feeling, throughout the entire body.",
    "once": false,
    "block": "i25.b1.in",
    "stage": "whole"
   },
   {
    "t": 435,
    "dur": 5,
    "text": "Let the breath sensations flow together through the whole body. Keep your awareness as broad as you can.",
    "say": "Let the breath sensations flow together through the whole body. Keep your awareness as broad as you can.",
    "once": false,
    "block": "i26.b1.in",
    "quote": {
     "text": "keeping your awareness as broad as possible",
     "cite": "Ajaan Lee Dhammadharo, Keeping the Breath in Mind, method-2:p25.s1 (tr. Ṭhānissaro Bhikkhu)"
    },
    "stage": "whole"
   }
  ],
